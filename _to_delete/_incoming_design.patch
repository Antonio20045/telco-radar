-/* ---------------------------------------------------------------- topbar */
-.topbar{
-  position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);
-  backdrop-filter:saturate(1.2) blur(8px);border-bottom:1px solid var(--vf-line);
-}
-.topbar-inner{display:flex;align-items:center;justify-content:space-between;height:68px}
-.brand{display:flex;align-items:center;gap:12px}
-.brand svg,.brand-logo{display:block;width:30px;height:30px}
-.brand-name{font-weight:800;letter-spacing:-.02em;font-size:19px;color:var(--vf-ink)}
-.brand-name em{font-style:normal;color:var(--vf-red)}
-.nav{display:flex;align-items:center;gap:30px}
-.nav a{font-size:15px;font-weight:600;color:var(--vf-mute);transition:color .15s var(--ease)}
-.nav a:hover{color:var(--vf-ink)}
-.nav a.active{color:var(--vf-ink)}
-.nav a.active::after{content:"";display:block;height:2px;background:var(--vf-red);margin-top:5px;border-radius:2px}
-
-/* ------------------------------------------------------------------ hero */
-.hero{padding:66px 0 30px}
-.eyebrow{font-size:13px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--vf-red);margin:0 0 16px}
-.hero h1{font-size:clamp(40px,5vw,64px);font-weight:800;letter-spacing:-.02em;line-height:1.03;margin:0 0 18px}
-.hero-sub{font-size:20px;color:var(--vf-mute);max-width:640px;margin:0;line-height:1.5}
-.hero-head{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap}
-.status{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;
-  padding:7px 14px;border-radius:100px;border:1px solid var(--vf-line);color:var(--vf-ink);white-space:nowrap}
-.status .dot{width:8px;height:8px;border-radius:50%;background:#1a8f4c}
-.status.warn .dot{background:#c98a00}
-
-/* ------------------------------------------------------------------- kpis */
-.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:40px 0 8px}
-.kpi{background:var(--vf-neutral);border-radius:14px;padding:22px 22px 20px}
-.kpi-num{display:block;font-size:38px;font-weight:800;letter-spacing:-.02em;line-height:1}
-.kpi-num small{font-size:17px;font-weight:600;color:var(--vf-faint)}
-.kpi-label{display:block;margin-top:8px;font-size:13.5px;color:var(--vf-mute);font-weight:500}
-.kpi.accent{background:#fdecec}
-.kpi.accent .kpi-num{color:var(--vf-red)}
-
-/* -------------------------------------------------------------- explainer */
