-  justify-content:space-between;font-weight:700;font-size:16px}
-.explainer summary::-webkit-details-marker{display:none}
-.explainer summary .hint{font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--vf-mute)}
-.explainer[open] summary{border-bottom:1px solid var(--vf-line)}
-.explainer-body{padding:8px 22px 22px;color:var(--vf-ink)}
-.explainer-body p{margin:14px 0;font-size:15.5px;color:#40444a}
-.explainer-body b{color:var(--vf-ink)}
-.legend{display:inline-flex;align-items:center;gap:6px;margin-right:16px;font-size:13.5px;color:var(--vf-mute)}
-.ldot{width:10px;height:10px;border-radius:50%;display:inline-block}
-.ldot.r5{background:#e60000}.ldot.r4{background:#e07a00}.ldot.r3{background:#3860be}.ldot.r2{background:#a8a8a8}
-
-/* --------------------------------------------------------------- sections */
