-.section-title{font-size:30px;font-weight:800;letter-spacing:-.015em;margin:6px 0 0;color:var(--vf-ink)}
-.section-sub{color:var(--vf-mute);font-size:16px;margin:10px 0 0;max-width:620px}
-
-/* ------------------------------------------------------- priority cards */
