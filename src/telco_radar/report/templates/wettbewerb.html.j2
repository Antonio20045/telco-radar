{# Wettbewerb · Deutschland (Redesign 09.10.2026).

   Ein Tab mit zwei Ansichten: Deutschland (diese Seite: Telekom, O2, 1&1)
   und Welt (differenzierung.html: die zwoelf Hebel weltweit). Beide
   Dateien bleiben bestehen - ihre Anker stehen in Mails und im Suchindex.

   Jeder Wettbewerber ist ein ruhiges Portraet: der Name gross, die Lage in
   wenigen Saetzen, die drei letzten Schritte als kurzer Zeitstrahl, seine
   Hebel als schlichte Woerter, ein Verweis auf seine laufenden Aktionen.
   Die lange Chronik liegt zugeklappt darunter. Jede Schlagzeile traegt
   `szl` (CLAUDE.md §5). #}
{% extends "base.html.j2" %}
{% from "_seit.html.j2" import seit_block %}
{% import "_design.html.j2" as d %}
{% set active = 'wettbewerb' %}
{% set buehne = true %}
{% block title %}Marktrecherche · Wettbewerb{% endblock %}
{% set ANBIETER_KLASSE = {'deutsche-telekom': 'telekom', 'telefonica-o2': 'o2', '1-1': '1-1'} %}

{% macro chronik_liste(eintraege) %}
<ol class="wb-liste">
  {% for e in eintraege %}
  <li class="wb-zeile">
    <span class="wb-zeile-kopf"><span class="wb-tag">{{ e.tag }}</span>
      <span class="wb-ressort">{{ e.rubrik }}</span>
      {% if e.quelle %}<span class="wb-quelle">{{ e.quelle }}</span>{% endif %}</span>
    <a class="wb-titel szl" href="{{ e.url }}" target="_blank" rel="noopener">{{ e.titel }}</a>
    {% if e.note %}<span class="wb-note">{{ e.note }}</span>{% endif %}
  </li>
  {% endfor %}
</ol>
{% endmacro %}

{% block buehne %}
{% call d.band('band-wettbewerb', 'Wettbewerb', 'Deutschland', prefix) %}
{{ d.umschalter([{'key': 'de', 'href': 'wettbewerb.html', 'label': 'Deutschland'},
                 {'key': 'welt', 'href': 'differenzierung.html', 'label': 'Welt'}], 'de', prefix, 'Ansicht') }}
{% endcall %}
{% endblock %}

{% block content %}
<div class="wb-einstieg" data-auftritt>
  <p class="wb-lead">Was Telekom, O2 und 1&amp;1 gerade tun – und wie es zu den Wochen davor passt.</p>
  {{ seit_block(seit, date_de) }}
</div>
{% if wettbewerb.wettbewerber %}
<nav class="wb-sprung" aria-label="Die drei Wettbewerber" data-auftritt>
  {% for c in wettbewerb.wettbewerber %}<a href="#{{ c.anker }}"><span class="anb-punkt gr-anb--{{ ANBIETER_KLASSE.get(c.anker, 'ohne-farbe') }}" aria-hidden="true"></span>{{ c.name }}</a>{% endfor %}
</nav>
{% endif %}
<div id="chronik" style="scroll-margin-top:90px"></div>

{% for c in wettbewerb.wettbewerber %}
{% set erste = (c.monate[0].offen if c.monate else []) %}
<section class="wb portraet{% if loop.first %} wb--erste{% endif %}" id="{{ c.anker }}" style="scroll-margin-top:96px">
  <div class="portraet-kopf" data-auftritt>
    <h2 class="wb-name"><span class="anb-punkt gr-anb--{{ ANBIETER_KLASSE.get(c.anker, 'ohne-farbe') }}" aria-hidden="true"></span>{{ c.name }}</h2>
    {% if c.n_chronik %}<span class="rubrik-zahl">{{ c.n_chronik }}
      Meldung{{ 'en' if c.n_chronik != 1 else '' }} seit {{ c.seit | date_de }}</span>{% endif %}
  </div>
  <div class="portraet-raster">
    <div class="portraet-lage" data-auftritt>
      {% if c.summary %}
      <p class="wb-summary">{{ c.summary }}</p>
      {% elif c.fehler %}
      <p class="empty-note"><b>Für diesen Lauf liegt kein Profil vor.</b>
        Der Fehler steht im <a href="{{ prefix }}transparenz.html">Laufprotokoll</a>.</p>
      {% else %}
      <p class="muted-note">Für diesen Wettbewerber liegt noch kein Profil vor.</p>
      {% endif %}
      {% if c.hebel %}
      <div class="wb-hebel">
        <p class="wb-spaltentitel">Womit er sich abhebt</p>
        <p class="hebel-woerter">{% for h in c.hebel %}<a href="{{ prefix }}differenzierung.html#dz-theme-{{ h.key }}" title="{{ h.n }} Beispiel{{ 'e' if h.n != 1 else '' }}{% if h.beispiel %}: {{ h.beispiel }}{% endif %}">{{ h.label }}</a>{% endfor %}</p>
        {% if c.flanken %}
        <p class="wb-flanken">Ohne Beispiel bei diesem Anbieter, aber bei
          {% for f in c.flanken[:3] %}<b>{{ f.label }}</b> ({{ f.wer | join(', ') }}){{ ", " if not loop.last }}{% endfor %}.</p>
        {% endif %}
      </div>
      {% endif %}
      {% if wettbewerb.promo_bekannt %}
      <p class="portraet-aktionen">{% if c.aktionen %}<a class="knopf" href="{{ prefix }}promo/index.html">{{ c.aktionen_n }}
        laufende Aktion{{ 'en' if c.aktionen_n != 1 else '' }} &rarr;</a>
        {% else %}<span class="muted-note">Zurzeit ist keine Aktion bestätigt.</span>{% endif %}
        {% if c.marken %}<span class="wb-marken">Marken: {{ c.marken | join(', ') }}</span>{% endif %}</p>
      {% endif %}
    </div>
    <div class="portraet-zeit" data-auftritt>
      <p class="wb-spaltentitel">Die letzten Schritte</p>
      {% if erste %}
      <ol class="zeitstrahl">
        {% for e in erste[:3] %}
        <li class="zeitstrahl-punkt">
          <span class="zeitstrahl-tag">{{ e.tag }}</span>
          <a class="zeitstrahl-titel wb-titel szl" href="{{ e.url }}" target="_blank" rel="noopener">{{ e.titel }}</a>
          <span class="zeitstrahl-meta">{{ e.rubrik }}{% if e.quelle %} · {{ e.quelle }}{% endif %}</span>
        </li>
        {% endfor %}
      </ol>
      {% else %}
      <p class="muted-note">Seit Beobachtungsbeginn ist zu {{ c.name }} keine Meldung eingegangen.</p>
      {% endif %}
    </div>
  </div>
  {% if c.monate %}
  <details class="wb-chronik portraet-chronik">
    <summary>Alle Meldungen von {{ c.name }}<span>{{ c.n_chronik }}</span></summary>
    {% for m in c.monate %}
    <p class="wb-monat">{{ m.monat | monat_de }}<span>{{ m.n }}</span></p>
    {{ chronik_liste(m.eintraege if m.eintraege else (m.offen + (m.rest or []))) }}
    {% endfor %}
  </details>
  {% endif %}
</section>
{% else %}
<p class="empty-note">Für diese Seite liegt noch kein Bericht im Archiv.</p>
{% endfor %}
<p class="dz-foot">Diese Seite baut sich bei jedem Lauf neu aus dem Berichtsarchiv auf – aus den
  Wettbewerbsprofilen der Ausgaben und der <a href="{{ prefix }}promo/index.html">Promo Übersicht</a>.</p>
{% endblock %}
