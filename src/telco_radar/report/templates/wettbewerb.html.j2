{# Wettbewerb · Deutschland als Kinostrecke (Antonio, 10.10.2026).

   AUFTAKT   Vollbild, das beim Scrollen zum Fenster schrumpft; unten die
             Meldungen dieser Woche je Wettbewerber.
   PULS      Meldungen je Kalenderwoche (`wettbewerb_puls`), Ausfallwochen
             als beschriftete Luecke.
   KAPITEL   Je Wettbewerber ein Vollbild, ueber das ein Blatt faehrt: Lage,
             Themen, Hebel, die letzten drei Schritte, die ganze Chronik
             zugeklappt. Jede Schlagzeile traegt `szl` (CLAUDE.md §5). #}
{% extends "base.html.j2" %}
{% from "_seit.html.j2" import seit_block %}
{% import "_design.html.j2" as d %}
{% set active = 'wettbewerb' %}
{% set buehne = true %}
{% set wrap_class = 'voll' %}
{% block title %}Marktrecherche · Wettbewerb{% endblock %}
{% set ANBIETER_KLASSE = {'deutsche-telekom': 'telekom', 'telefonica-o2': 'o2', '1-1': '1-1'} %}
{% set KURZ = {'deutsche-telekom': 'Telekom', 'telefonica-o2': 'O2', '1-1': '1&1'} %}
{% set KAPITELBILD = {'deutsche-telekom': 'kapitel-das-wichtigste', 'telefonica-o2': 'kapitel-deutschland', '1-1': 'kapitel-auf-einen-blick'} %}
{% set puls = wettbewerb.puls or {} %}
{% set reihe_je = {} %}
{% for r in puls.reihen or [] %}{% set _ = reihe_je.update({r.anker: r}) %}{% endfor %}

{% macro chronik_liste(eintraege) %}
<ol class="wb-liste">
  {% for e in eintraege %}
  <li class="wb-zeile">
    <span class="wb-zeile-kopf"><span class="wb-tag">{{ e.tag }}</span>
      <span class="wb-ressort">{{ e.rubrik }}</span>
      {% if e.quelle %}<span class="wb-quelle">{{ e.quelle }}</span>{% endif %}</span>
    <a class="wb-titel szl" href="{{ e.url }}" target="_blank" rel="noopener">{{ e.titel }}</a>
    {% if e.note %}<span class="wb-note">{{ e.note }}</span>{% endif %}
  </li>
  {% endfor %}
</ol>
{% endmacro %}

{% block buehne %}
<section class="wa-auftakt" data-buehne>
  <div class="wa-auftakt-buehne">
    <div class="wa-rahmen">
      <div class="wa-bild" aria-hidden="true">{{ d.motiv('band-wettbewerb', prefix, 'wa-motiv', eager=true) }}</div>
      <div class="wa-schleier" aria-hidden="true"></div>
      <div class="wa-text">
        <div class="wa-dach"><span>Wettbewerb</span>
          {{ d.umschalter([{'key': 'de', 'href': 'wettbewerb.html', 'label': 'Deutschland'},
                           {'key': 'welt', 'href': 'differenzierung.html', 'label': 'Welt'}], 'de', prefix, 'Ansicht') }}
          {% if wettbewerb.stand %}<span class="wa-stand">Stand {{ wettbewerb.stand | date_de }}</span>{% endif %}</div>
        <h1 class="wa-titel">{% for c in wettbewerb.wettbewerber %}<span><em class="gr-anb--{{ ANBIETER_KLASSE.get(c.anker, 'ohne-farbe') }}" style="--i:{{ loop.index0 }}">{{ KURZ.get(c.anker, c.name) }}</em></span>{% else %}<span><em>Wettbewerb</em></span>{% endfor %}</h1>
      </div>
      {% if puls.reihen %}
      <ol class="wa-anzeige">
        {% for r in puls.reihen %}
        <li class="gr-anb--{{ r.klasse }}" style="--i:{{ loop.index0 }}">
          <span class="wa-anz-name">{{ r.name }}</span>
          {% if r.diese_woche is none %}<span class="wa-anz-zahl">–</span><span class="wa-anz-text">diese Woche nicht bewertet</span>
          {% else %}<span class="wa-anz-zahl" data-zaehler="{{ r.diese_woche }}">{{ r.diese_woche }}</span><span class="wa-anz-text">Meldungen diese Woche (KW {{ puls.wochen[-1].kw }})</span>{% endif %}
        </li>
        {% endfor %}
      </ol>
      {% endif %}
      <div class="wa-hinweis" aria-hidden="true"></div>
    </div>
    <p class="wa-satz">Was Telekom, O2 und 1&amp;1 gerade tun und wie es zu den Wochen davor passt.</p>
  </div>
</section>
{% endblock %}

{% block content %}
{% if puls.wochen %}
<section class="wa-puls" id="puls" data-puls>
  <div class="wa-puls-kopf">
    <h2>Wer wie oft <i>in den Meldungen steht</i></h2>
    <p>Meldungen je Kalenderwoche, KW {{ puls.wochen[0].kw }} bis KW {{ puls.wochen[-1].kw }}.</p>
  </div>
  <div class="wa-puls-rahmen">{{ puls.svg }}</div>
  <nav class="wa-sprung" aria-label="Zu den Wettbewerbern">
    {% for c in wettbewerb.wettbewerber %}<a class="gr-anb--{{ ANBIETER_KLASSE.get(c.anker, 'ohne-farbe') }}" href="#{{ c.anker }}"><span aria-hidden="true"></span>{{ KURZ.get(c.anker, c.name) }}</a>{% endfor %}
  </nav>
  {{ seit_block(seit, date_de) }}
</section>
{% else %}
<div class="wa-puls">{{ seit_block(seit, date_de) }}</div>
{% endif %}
<div id="chronik"></div>

{% for c in wettbewerb.wettbewerber %}
{% set erste = (c.monate[0].offen if c.monate else []) %}
{% set themen = (puls.themen or {}).get(c.anker, []) %}
<section class="wb wa-kapitel gr-anb--{{ ANBIETER_KLASSE.get(c.anker, 'ohne-farbe') }}" id="{{ c.anker }}">
  <div class="wa-kapitel-buehne" data-buehne>
    <div class="wa-kapitel-bild" aria-hidden="true">{{ d.motiv(KAPITELBILD.get(c.anker), prefix, 'wa-motiv') }}</div>
    <div class="wa-schleier" aria-hidden="true"></div>
    <div class="wa-kapitel-titel">
      <p class="wa-nr">{{ loop.index }} / {{ loop.length }}</p>
      <h2 class="wb-name">{{ c.name }}</h2>
      {% if c.n_chronik %}<p class="wa-kapitel-zahl"><span class="rubrik-zahl"><b data-zaehler="{{ c.n_chronik }}">{{ c.n_chronik }}</b>
        Meldung{{ 'en' if c.n_chronik != 1 else '' }} seit {{ c.seit | date_de }}</span></p>{% endif %}
    </div>
  </div>
  <div class="wa-blatt">
    <div class="wa-blatt-innen">
      <div class="wa-lage" data-auftritt>
        <p class="wa-etikett">Die Lage</p>
        {% if c.summary %}
        <p class="wb-summary">{{ c.summary }}</p>
        {% elif c.fehler %}
        <p class="empty-note"><b>Für diesen Lauf liegt kein Profil vor.</b>
          Der Fehler steht im <a href="{{ prefix }}transparenz.html">Laufprotokoll</a>.</p>
        {% else %}
        <p class="muted-note">Für diesen Wettbewerber liegt noch kein Profil vor.</p>
        {% endif %}
        {% if themen %}
        <p class="wa-etikett">Worüber berichtet wird</p>
        <div class="wa-themen">{% for t in themen %}<span class="wa-thema" style="--anteil:{{ t.anteil }}"><b>{{ t.name }}</b><i>{{ t.prozent }} %</i></span>{% endfor %}</div>
        {% endif %}
        <p class="wa-etikett">Womit {{ KURZ.get(c.anker, c.name) }} sich abhebt</p>
        {% if c.hebel %}
        <p class="hebel-woerter">{% for h in c.hebel %}<a href="{{ prefix }}differenzierung.html#dz-theme-{{ h.key }}">{{ h.label }}</a>{% endfor %}</p>
        {% else %}
        <p class="hebel-woerter"><span class="wa-leer">Noch kein Beispiel erfasst</span></p>
        {% endif %}
      </div>
      <div class="wa-schritte-spalte" data-auftritt>
        <p class="wa-etikett">Die letzten Schritte</p>
        {% if erste %}
        <ol class="zeitstrahl wa-schritte">
          {% for e in erste[:3] %}
          <li class="zeitstrahl-punkt" style="--v:{{ loop.index0 * 0.12 }}s">
            <span class="zeitstrahl-tag">{{ e.tag }}</span>
            <a class="zeitstrahl-titel wb-titel szl" href="{{ e.url }}" target="_blank" rel="noopener">{{ e.titel }}</a>
            <span class="zeitstrahl-meta">{{ e.rubrik }}{% if e.quelle %} · {{ e.quelle }}{% endif %}</span>
          </li>
          {% endfor %}
        </ol>
        {% else %}
        <p class="muted-note">Seit Beobachtungsbeginn ist zu {{ c.name }} keine Meldung eingegangen.</p>
        {% endif %}
        {% if wettbewerb.promo_bekannt and c.aktionen %}
        <p class="wa-fuss"><a class="wa-knopf" href="{{ prefix }}promo/index.html">{{ c.aktionen_n }} laufende Aktion{{ 'en' if c.aktionen_n != 1 else '' }}</a></p>
        {% endif %}
        {% if c.marken %}<p class="wa-marken">Marken: {{ c.marken | join(', ') }}</p>{% endif %}
      </div>
    </div>
    {% if c.monate %}
    <details class="wb-chronik wa-chronik">
      <summary>Alle Meldungen von {{ KURZ.get(c.anker, c.name) }}<span>{{ c.n_chronik }}</span></summary>
      {% for m in c.monate %}
      <p class="wb-monat">{{ m.monat | monat_de }}<span>{{ m.n }}</span></p>
      {{ chronik_liste(m.eintraege if m.eintraege else (m.offen + (m.rest or []))) }}
      {% endfor %}
    </details>
    {% endif %}
  </div>
</section>
{% else %}
<p class="empty-note wa-leer-seite">Für diese Seite liegt noch kein Bericht im Archiv.</p>
{% endfor %}
{% endblock %}
