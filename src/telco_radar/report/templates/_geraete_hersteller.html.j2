{# Preisposition je Hersteller (Antonio, 05.11.2026; Liniendiagramm seit
   12.12.2026): das EINE Preisbild der Seite. Daten, Legende und beide SVG
   liefert geraete_hersteller.py; hier steht nur die Hülle.

   KEIN Text um das Bild: die Achsenbeschriftung steht IM SVG, den Zeitraum
   sagen die Knöpfe, das Datum sagt die X-Achse. Antonio, 12.12.2026: „Gutes
   Design braucht keine Erklärung." Der Server zeichnet den Vorgabe-Zeitraum
   (ohne JavaScript lesbar), app.js schaltet 7 Tage / 30 Tage / eigener
   Zeitraum um. #}
{% set hm = geraete.hersteller %}
<section class="gr-hm gx-art gx-art--tarif" id="hersteller" aria-labelledby="hm-titel"{% if hm and hm.json %} data-stand="{{ hm.stand }}"{% endif %}>
  <div class="gx-kopf"><h2 id="hm-titel">Preisposition je Hersteller</h2></div>
  {% if not hm %}
  <p class="gx-leer">Herstellergrafik nicht berechnet.</p>
  {% elif hm.fehler %}
  <p class="gx-leer">Herstellergrafik nicht verfügbar: {{ hm.fehler }}</p>
  {% elif hm.leer %}
  <p class="gx-leer">Kein vergleichbarer Messtag in den aktuellen Modellen.</p>
  {% else %}
  <div class="gr-zr-zeitwahl gr-hm-zeit" id="hm-zeit" role="group" aria-label="Zeitraum" hidden>
    <button type="button" data-zeit="7" aria-pressed="false">7 Tage</button>
    <button type="button" data-zeit="30" aria-pressed="true">30 Tage</button>
    <button type="button" data-zeit="eigen" aria-pressed="false">Eigener Zeitraum</button>
  </div>
  <div class="gr-hm-eigen" id="hm-eigen" hidden>
    <label>von <input type="date" id="hm-von" value="{{ hm.tage_von }}" min="{{ hm.tage_von }}" max="{{ hm.tage_bis }}"></label>
    <label>bis <input type="date" id="hm-bis" value="{{ hm.tage_bis }}" min="{{ hm.tage_von }}" max="{{ hm.tage_bis }}"></label>
  </div>
  <ul class="gr-hm-legende" id="hm-legende" aria-label="Hersteller">
    {% for l in hm.legende %}
    <li class="gr-hm-leg{{ ' gr-hm-leg--gesamt' if l.gesamt }}" data-hersteller="{{ l.name }}"><svg viewBox="0 0 30 12" aria-hidden="true"><line x1="1" y1="6" x2="29" y2="6" style="stroke:{{ l.farbe }};stroke-width:{{ l.breite }};stroke-dasharray:{{ l.muster }}"/></svg>{{ l.name }}</li>
    {% endfor %}
  </ul>
  <div class="gr-hm-bild gr-hm-bild--breit" id="hm-bild-breit">{{ hm.svg_breit | safe }}</div>
  <div class="gr-hm-bild gr-hm-bild--schmal" id="hm-bild-schmal">{{ hm.svg_schmal | safe }}</div>
  <p class="gx-leer gr-hm-ohne-tag" id="hm-ohne-tag" hidden>Kein vergleichbarer Messtag im gewählten Zeitraum.</p>
  <script type="application/json" id="hm-daten">{{ hm.json | safe }}</script>
  {% endif %}
</section>
