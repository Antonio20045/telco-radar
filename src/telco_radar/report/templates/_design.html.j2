{# Bausteine des Designs vom 09.10.2026: Motivbild, Bildband, Umschalter.

   Ein Motiv steht nur, wenn seine Datei unter templates/static/bilder/
   liegt (`bilder` setzt render_site). Fehlt sie, steht eine ruhige
   Flaeche in der Farbe der Tageszeit - nie ein kaputtes Bild. Unter jedem
   Bild liegt seine Vorschau (statik.vorschau), bis es geladen ist. #}

{% macro motiv(slug, prefix, klasse='', eager=false, breite=2400, hoehe=1357) -%}
{%- if slug and slug in bilder -%}
{%- set klein = (bilder_klein or {}).get(slug) -%}
<img class="motiv {{ klasse }}" src="{{ prefix }}static/bilder/{{ slug }}.jpg" alt=""{% if klein %}
     srcset="{{ prefix }}static/bilder/{{ klein }} 1200w, {{ prefix }}static/bilder/{{ slug }}.jpg {{ breite }}w" sizes="100vw"{% endif %}
     width="{{ breite }}" height="{{ hoehe }}" decoding="async" loading="{{ 'eager' if eager else 'lazy' }}"{% if eager %} fetchpriority="high"{% endif %}
     style="background:url({{ bilder[slug] }}) center/cover">
{%- else -%}
<span class="motiv motiv--leer {{ klasse }}" aria-hidden="true"></span>
{%- endif -%}
{%- endmacro %}

{# Das Bildband oben auf jeder Unterseite: ein Drittel Bildschirmhoehe,
   der Titel liegt unten links im Bild, ein optionaler Umschalter daneben. #}
{% macro band(slug, kicker, titel, prefix, stand='') -%}
<section class="band">
  <div class="band-bild" aria-hidden="true">{{ motiv(slug, prefix, 'band-motiv', eager=true, breite=2400, hoehe=1029) }}</div>
  <div class="band-inhalt">
    <div class="band-text">
      {% if kicker %}<p class="band-kicker">{{ kicker }}</p>{% endif %}
      <h1 class="band-titel">{{ titel }}</h1>
      {% if stand %}<p class="band-stand">{{ stand }}</p>{% endif %}
    </div>
    {% if caller %}<div class="band-extra">{{ caller() }}</div>{% endif %}
  </div>
</section>
{%- endmacro %}

{# Ein Motiv, das als ruhender Hintergrund hinter der ganzen Seite steht
   (Newsletter): das Formular liegt als Glasflaeche darueber. #}
{% macro hintergrund(slug, prefix) -%}
<div class="hintergrund" aria-hidden="true">{{ motiv(slug, prefix, 'hintergrund-motiv', eager=true, breite=2400, hoehe=1357) }}</div>
{%- endmacro %}

{# Ein schlichter Umschalter zwischen zwei Ansichten einer Seite, z. B.
   Wettbewerb Deutschland | Welt. Jeder Eintrag ist ein echter Link. #}
{% macro umschalter(eintraege, aktiv, prefix, label) -%}
<nav class="umschalter" aria-label="{{ label }}">
  {% for e in eintraege %}
  <a href="{{ prefix }}{{ e.href }}" {% if e.key == aktiv %}class="on" aria-current="page"{% endif %}>{{ e.label }}</a>
  {% endfor %}
</nav>
{%- endmacro %}

{# Der Weg zur zweiten Ansicht eines Tabs steht am Seitenende, nie im
   ersten Bildschirm (Antonio, 11.10.2026: "Die Switches gehören nicht auf
   die Startseite. Auf keiner."). Ein grosses Bild, ein Wort, ein Pfeil. #}
{% macro weiter(href, titel, prefix, slug='') -%}
<a class="weiter-blatt{% if slug %} weiter-blatt--bild{% endif %}" href="{{ prefix }}{{ href }}">
  {% if slug %}<span class="weiter-bild" aria-hidden="true">{{ motiv(slug, prefix, 'weiter-motiv', breite=2400, hoehe=1029) }}</span>{% endif %}
  <span class="weiter-titel">{{ titel }}<span class="weiter-pfeil" aria-hidden="true">→</span></span>
</a>
{%- endmacro %}

{# LIQUID GLASS (Antonio, 11.10.2026): ein Umschalter, der beim Scrollen
   ueber dem Inhalt schwebt und ihn durchscheinen laesst. Die Pille gleitet
   zur gewaehlten Ansicht; app.js setzt ihre Lage. Die Brechung an den
   Kanten (Karte vom Server, Rechenweg shuding/liquid-glass, MIT) zeigt nur
   Chromium, alle anderen sehen mattes Glas. #}
{% macro glas_filter() -%}
<svg class="glas-filter" width="0" height="0" aria-hidden="true" focusable="false"><filter id="glas-linse" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB" x="0" y="0" width="{{ glas.breite }}" height="{{ glas.hoehe }}"><feImage href="{{ glas.url }}" x="0" y="0" width="{{ glas.breite }}" height="{{ glas.hoehe }}" preserveAspectRatio="none" result="karte"/><feDisplacementMap in="SourceGraphic" in2="karte" scale="{{ glas.staerke }}" xChannelSelector="R" yChannelSelector="G"/></filter></svg>
{%- endmacro %}

{# Zwei Seiten als eine: jeder Eintrag ist ein echter Link, der beim
   Umschalter der anderen Seite landet (#ansicht), nicht wieder oben. #}
{% macro glas_schalter(eintraege, aktiv, prefix, label) -%}
<nav class="glas-schalter" id="ansicht" aria-label="{{ label }}" data-glas>
  <span class="glas-pille" aria-hidden="true"></span>
  {% for e in eintraege %}<a href="{{ prefix }}{{ e.href }}#ansicht"{% if e.key == aktiv %} aria-current="page"{% endif %}>{{ e.label }}</a>{% endfor %}
</nav>
{{ glas_filter() }}
{%- endmacro %}
