{% extends "base.html.j2" %}
{% set active = 'wettbewerber' %}
{% block title %}Telco Radar - Wettbewerber{% endblock %}
{% block content %}
<section class="page-hero wide">
  <div class="page-hero-row">
    <div>
      <p class="page-kicker">Marktbeobachtung</p>
      <h1>Wettbewerber im Detail</h1>
    </div>
    {% if date_de %}<span class="page-date">Stand {{ date_de }}</span>{% endif %}
  </div>
  <p class="page-lead">Tiefenanalyse der wichtigsten Rivalen: was sie gerade tun, mit Quelle und Einordnung.</p>
</section>

{% if competitors and competitors|selectattr('summary')|list %}
<div class="comp-list">
  {% for c in competitors %}
  {% if c.summary or c.moves %}
  <article class="comp-card" id="c{{ loop.index }}">
    <div class="comp-card-head">
      <h2>{{ c.name }}</h2>
      <div class="comp-badges">
        <span class="comp-badge">{{ c.n_items }} Meldungen</span>
        <span class="comp-badge accent">{{ c.moves|length }} relevante Moves</span>
      </div>
    </div>
    {% if c.summary %}<p class="comp-summary">{{ c.summary }}</p>{% endif %}
    {% if c.themes %}<div class="comp-tags">{% for t in c.themes %}<span class="comp-tag">{{ t }}</span>{% endfor %}</div>{% endif %}

    {% if c.moves %}
    <p class="comp-moves-title">Aktuelle Moves</p>
    <div class="comp-items">
      {% for m in c.moves %}
      <div class="comp-item">
        <div class="comp-item-cat">{{ m.category }}</div>
        <a href="{{ m.url }}" target="_blank" rel="noopener">{{ m.title }}</a>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </article>
  {% endif %}
  {% endfor %}
</div>
{% else %}
<p class="empty-note">Für diesen Lauf liegt noch keine Wettbewerber-Detailanalyse vor. Sie entsteht beim nächsten Lauf der Pipeline (benötigt die KI-Analyse).</p>
{% endif %}
{% endblock %}
