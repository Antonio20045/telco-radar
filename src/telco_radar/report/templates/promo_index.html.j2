{% extends "base.html.j2" %}
{% set usecase = 'promo' %}
{% set active = 'promo_uebersicht' %}
{% block title %}Promo Übersicht · Übersicht{% endblock %}
{% block content %}

<section class="page-hero">
  <div class="page-hero-row">
    <div>
      <p class="page-kicker">Deutschland</p>
      <h1>Promo Übersicht</h1>
    </div>
    {% if date_de %}<span class="page-date">Stand {{ date_de }}</span>{% endif %}
  </div>
  <p class="page-lead">Aktuelle Tarif-, Rabatt- und Kampagnenaktionen aller Telcos in Deutschland – Netzbetreiber und ihre Discount-/Zweitmarken, <b>jeweils mit Originalquelle</b>.</p>
</section>

<div class="kpi-tiles">
  <div class="kpi-tile"><b>{{ promo_view.active_total }}</b><span>aktive Aktionen</span></div>
  <div class="kpi-tile accent"><b>{{ promo_view.brands_active }}</b><span>Anbieter mit laufender Aktion</span></div>
  <div class="kpi-tile"><b>{{ promo_view.brands_tracked }}</b><span>beobachtete Anbieter</span></div>
</div>

{% if promo_report_html %}
<section class="section dz-report" id="promobericht">
  <div class="section-head">
    <h2><span class="sec-no">01</span></h2>
    <p class="section-title">Der Wochenüberblick</p>
    <p class="section-sub">Zusammengefasst aus den beobachteten Aktionsseiten: was diese Woche an Rabatt- und Kampagnenaktivität auffällt.</p>
  </div>
  <div class="dz-report-meta">Bericht vom {{ promo_report_date }} · Quellen und Detailbelege stehen direkt im Text</div>
  <article class="briefing prose">{{ promo_report_html | safe }}</article>
</section>
{% endif %}

<details class="evidence dz-evidence" id="aktionsbibliothek" open>
  <summary><span>Alle aktuellen Aktionen öffnen</span><small>Nachschlagen</small></summary>
  <div class="evidence-body">
    <div class="section-head">
      <h2><span class="sec-no">02</span></h2>
      <p class="section-title">Aktionen je Anbieter</p>
      <p class="section-sub">Mit Originalquelle und Prüfdatum. Preise und Enddaten ändern sich schnell – für den aktuellen Stand immer der Quelle folgen.</p>
    </div>

    {% for tier_num, tier_label in [(1, 'Große Netzbetreiber'), (2, 'Discount- und Zweitmarken'), (3, 'Festnetz, Kabel und Glasfaser')] %}
    {% set tier_entries = promo_view.by_tier.get(tier_num, []) %}
    {% if tier_entries %}
    <article class="dz-card" style="--c:#e60000">
      <div class="dz-card-head">
        <h2>{{ tier_label }}</h2>
        <span class="dz-count">{{ tier_entries | selectattr('status', 'equalto', 'aktiv') | list | length }} aktiv</span>
      </div>
      <ul class="dz-moves">
        {% for e in tier_entries %}
        <li class="dz-move">
          <div class="dz-move-h">
            <a class="dz-move-title" href="{{ e.url }}" target="_blank" rel="noopener"><b>{{ e.brand }}</b> — {{ e.headline }}</a>
            {% if e.neu %}<span class="dz-new">neu</span>{% endif %}
            {% if e.status != 'aktiv' %}<span class="dz-new" style="background:#9aa0aa">{{ e.status }}</span>{% endif %}
          </div>
          {% if e.description %}<p class="dz-move-why">{{ e.description }}</p>{% endif %}
          <p class="dz-move-meta">{% if e.valid_until %}gültig laut Anbieter bis {{ e.valid_until }} · {% endif %}<a href="{{ e.url }}" target="_blank" rel="noopener">{{ e.url | domain }} &nearr;</a> · geprüft {{ e.last_verified | date_de }}</p>
        </li>
        {% endfor %}
      </ul>
    </article>
    {% endif %}
    {% endfor %}

    {% if promo_view.active_total == 0 %}
    <p class="dz-empty">Im aktuellen Beobachtungszeitraum liegt noch keine belegte aktive Aktion vor.</p>
    {% endif %}
  </div>
</details>

<p class="dz-foot">Diese Seite beobachtet die öffentlichen Aktions- und Tarifseiten deutscher Telcos direkt (Snapshot-Vergleich von Lauf zu Lauf, keine Presse-Feeds). Jede Karte trägt eine Originalquelle und ein Prüfdatum; Preise werden bewusst nicht als dauerhaft gültig übernommen – für den aktuellen Stand gilt immer die verlinkte Seite des Anbieters. Vodafones eigene Aktionsseite wird separat als interne Referenz geführt, nicht als Wettbewerber gezählt.</p>
{% endblock %}
