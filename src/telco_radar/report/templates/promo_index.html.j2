{% extends "base.html.j2" %}
{% set usecase = 'promo' %}
{% set active = 'promo_uebersicht' %}
{% block title %}Promo Übersicht · Übersicht{% endblock %}

{% macro promo_offer(o) %}
<li class="promo-offer{% if o.fading %} promo-offer--fading{% endif %}">
  <div class="promo-offer-top">
    <a class="promo-offer-title" href="{{ o.url }}" target="_blank" rel="noopener">{{ o.headline }}</a>
    {% if o.fading %}<span class="promo-offer-fading-tag">vermutlich ausgelaufen</span>{% elif o.neu %}<span class="dz-new">neu</span>{% endif %}
  </div>
  <p class="promo-offer-meta">{{ o.url | domain }}{% if o.valid_until %} · gültig laut Anbieter bis {{ o.valid_until }}{% endif %} · geprüft {{ o.last_verified | date_de }}</p>
  {% if o.description %}
  <details class="promo-offer-desc-toggle">
    <summary>mehr erfahren</summary>
    <p class="promo-offer-desc">{{ o.description }}</p>
  </details>
  {% endif %}
</li>
{% endmacro %}

{% block content %}

<section class="page-hero">
  <div class="page-hero-row">
    <div>
      <p class="page-kicker">Deutschland</p>
      <h1>Promo Übersicht</h1>
    </div>
    {% if date_de %}<span class="page-date">Stand {{ date_de }}</span>{% endif %}
  </div>
  <p class="page-lead">Auf einen Blick: welche Tarif-, Rabatt- und Kampagnenaktion gerade bei welchem Wettbewerber läuft. Jede Karte verlinkt <b>direkt auf die Original-Aktionsseite</b> des Anbieters.</p>
</section>

<div class="kpi-tiles">
  <div class="kpi-tile accent"><b>{{ promo_view.active_total }}</b><span>aktive Aktionen</span></div>
  <div class="kpi-tile"><b>{{ promo_view.brands_active }}</b><span>Wettbewerber mit laufender Aktion</span></div>
  <div class="kpi-tile"><b>{{ promo_view.brands_tracked }}</b><span>beobachtete Wettbewerber</span></div>
</div>

<div class="promo-toolbar">
  <div class="promo-filters" role="group" aria-label="Nach Anbietertyp filtern">
    <button type="button" class="promo-filter on" data-tier="all">Alle</button>
    <button type="button" class="promo-filter" data-tier="1">Netzbetreiber</button>
    <button type="button" class="promo-filter" data-tier="2">Discount &amp; Zweitmarken</button>
  </div>
  <span class="promo-hint">Jedes Angebot verlinkt zur Originalquelle des Anbieters</span>
</div>

<div class="promo-board" id="promo-board">
  {% for b in promo_view.brands %}
  <article class="promo-card{% if b.internal_reference %} promo-card--own{% endif %}{% if not b.has_offers %} promo-card--empty{% endif %}{% if not b.image_url %} promo-card--no-photo{% endif %}" data-tier="{{ b.tier }}" style="--c:{{ b.color }}">
    <div class="promo-media">
      <span class="promo-media-fallback"><span class="promo-avatar">{{ b.initials }}</span></span>
      {% if b.image_url %}<img src="{{ b.image_url }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('.promo-card').classList.add('promo-card--no-photo');this.remove()">{% endif %}
      <span class="promo-media-badges">
        <span class="promo-tier-tag">{{ b.tier_label }}</span>
        {% if b.internal_reference %}<span class="promo-own-tag">Eigene Referenz</span>{% endif %}
      </span>
      {% if b.image_url %}<span class="promo-media-brand"><span class="promo-avatar promo-avatar--sm">{{ b.initials }}</span></span>{% endif %}
    </div>

    <div class="promo-card-head">
      <h3>{{ b.name }}</h3>
      <span class="promo-count{% if b.active_count %} live{% endif %}">{{ b.active_count }} aktiv</span>
    </div>
    {% if b.group and b.group != b.name %}<p class="promo-card-sub">{{ b.group }}</p>{% endif %}

    {% if b.active %}
    <ul class="promo-offers">
      {% for o in b.active[:4] %}{{ promo_offer(o) }}{% endfor %}
    </ul>
    {% if b.active|length > 4 %}
    <details class="promo-more">
      <summary>+{{ b.active|length - 4 }} weitere Aktion{{ 'en' if b.active|length - 4 != 1 else '' }}</summary>
      <ul class="promo-offers">
        {% for o in b.active[4:] %}{{ promo_offer(o) }}{% endfor %}
      </ul>
    </details>
    {% endif %}
    {% if b.stale %}
    <p class="promo-stale-note">{{ b.stale|length }} frühere Aktion{{ 'en' if b.stale|length != 1 else '' }} ausgelaufen.</p>
    {% endif %}
    {% else %}
    <p class="promo-empty">{% if b.stale %}Keine aktuell bestätigte Aktion – zuletzt {{ b.stale[0].last_verified | date_de }} beobachtet.{% else %}Noch keine belegte Aktion beobachtet.{% endif %}</p>
    {% endif %}
  </article>
  {% endfor %}
</div>

{% if promo_report_html %}
<details class="evidence" style="margin-top:34px">
  <summary><span>Wochentext lesen: wie sich das Preis- und Aktionsbild insgesamt entwickelt</span><small>{% if promo_report_date %}{{ promo_report_date }}{% endif %}</small></summary>
  <div class="evidence-body">
    <article class="briefing prose">{{ promo_report_html | safe }}</article>
  </div>
</details>
{% endif %}

<p class="dz-foot">Diese Seite beobachtet die öffentlichen Aktions- und Tarifseiten deutscher Telcos direkt (Snapshot-Vergleich von Lauf zu Lauf, keine Presse-Feeds). Jede Karte trägt eine Originalquelle und ein Prüfdatum; Preise werden bewusst nicht als dauerhaft gültig übernommen – für den aktuellen Stand gilt immer die verlinkte Seite des Anbieters. Vodafones eigene Aktionsseite wird separat als interne Referenz geführt, nicht als Wettbewerber gezählt.</p>
{% endblock %}
