{% extends "base.html.j2" %}
{% set usecase = 'promo' %}
{% set active = 'promo_uebersicht' %}
{% block title %}Promo Übersicht · Übersicht{% endblock %}

{% macro promo_offer(o) %}
<li class="promo-offer{% if o.fading %} promo-offer--fading{% endif %}">
  <div class="promo-offer-top">
    <a class="promo-offer-title" href="{{ o.url }}" target="_blank" rel="noopener">{{ o.headline }}</a>
    {% if o.highlight %}<span class="promo-score-dot" title="Wichtigkeits-Score {{ o.score }} von 100">{{ o.score }}</span>{% endif %}
    {% if o.fading %}<span class="promo-offer-fading-tag">vermutlich ausgelaufen</span>{% elif o.neu %}<span class="dz-new">neu</span>{% endif %}
  </div>
  <p class="promo-offer-meta">{{ o.url | domain }}{% if o.valid_until %} · gültig laut Anbieter bis {{ o.valid_until }}{% endif %} · geprüft {{ o.last_verified | date_de }}</p>
  {% if o.description %}
  <details class="promo-offer-desc-toggle">
    <summary>mehr erfahren</summary>
    <p class="promo-offer-desc">{{ o.description }}</p>
  </details>
  {% endif %}
</li>
{% endmacro %}

{% macro highlight_card(item, kind='rival') %}
<article class="promo-top-card{% if kind == 'anchor' %} promo-top-card--own{% endif %}" style="--c:{{ item.brand.color }}">
  <div class="promo-top-card-head">
    <span class="promo-top-brand">{{ item.brand.name }}</span>
    {% if kind == 'anchor' %}
    <span class="promo-top-anchor-tag">eigenes Angebot</span>
    {% else %}
    <span class="promo-top-score" title="Wichtigkeits-Score {{ item.score }} von 100">{{ item.score }}</span>
    {% endif %}
  </div>
  <a class="promo-top-headline" href="{{ item.offer.url }}" target="_blank" rel="noopener">{{ item.offer.headline }}</a>
  {% if item.reason %}<p class="promo-top-reason">{{ item.reason }}</p>{% endif %}
  <p class="promo-top-meta">
    {% if item.mechanic %}<span class="promo-top-mech">{{ item.mechanic }}</span>{% endif %}
    <span class="promo-top-metatext">{{ item.offer.url | domain }}{% if item.offer.valid_until %} · bis {{ item.offer.valid_until }}{% endif %}{% if kind == 'anchor' and item.score %} · Wichtigkeit {{ item.score }}{% endif %}</span>
  </p>
</article>
{% endmacro %}

{% block content %}
{% set active_brands = promo_view.grid_brands | selectattr('has_offers') | list %}
{% set inactive_brands = promo_view.grid_brands | rejectattr('has_offers') | list %}

<section class="page-hero wide">
  <p class="page-kicker">Deutschland &middot; Promo-Markt</p>
  <div class="page-hero-row">
    <h1>Wer wirbt gerade womit.</h1>
    {% if date_de %}<span class="page-date">Stand {{ date_de }}</span>{% endif %}
  </div>
  <p class="page-lead">Auf einen Blick: welche Tarif-, Rabatt- und Kampagnenaktion gerade bei welchem Wettbewerber läuft &ndash; die wichtigsten zuerst. Jede Karte verlinkt <b>direkt auf die Original-Aktionsseite</b> des Anbieters.</p>
  <div class="stat-inline-row">
    <span class="stat-inline accent"><b>{{ promo_view.highlight_count }}</b><span>Angebote über der Wichtigkeitsschwelle</span></span>
    <span class="stat-inline"><b>{{ promo_view.active_total }}</b><span>aktive Aktionen insgesamt</span></span>
    <span class="stat-inline"><b>{{ promo_view.brands_tracked }}</b><span>beobachtete Wettbewerber</span></span>
  </div>
</section>

<div class="promo-section-head">
  <h2>Die wichtigsten Angebote gerade</h2>
  <span>
    {% if promo_view.highlights %}
      je Marke das stärkste Angebot über der Wichtigkeitsschwelle
    {% elif promo_view.scored_total %}
      ruhige Woche &ndash; keine der {{ promo_view.scored_total }} bewerteten Aktionen über der Schwelle
    {% else %}
      Bewertung folgt mit dem nächsten Lauf
    {% endif %}
  </span>
</div>

<div class="promo-hero-row">
  {% if promo_view.hero %}
  {% set hb = promo_view.hero.brand %}
  {% set ho = promo_view.hero.offer %}
  <div class="promo-hero-card" style="--c:{{ hb.color }}">
    {% if hb.image_url %}<img src="{{ hb.image_url }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">
    {% else %}<span class="promo-hero-fallback"><span class="promo-avatar">{{ hb.initials }}</span></span>{% endif %}
    <div class="promo-hero-overlay"></div>
    <div class="promo-hero-content">
      <div class="promo-hero-badges">
        <span class="promo-hero-badge">{% if promo_view.highlights %}Wichtigstes Angebot{% else %}Top-Angebot{% endif %} &middot; {{ hb.name }}</span>
        {% if promo_view.hero.score is defined and promo_view.hero.score %}
        <span class="promo-hero-score" title="Wichtigkeits-Score {{ promo_view.hero.score }} von 100"><b>{{ promo_view.hero.score }}</b><span>Wichtigkeit</span></span>
        {% endif %}
      </div>
      <div class="promo-hero-headline">{{ ho.headline }}</div>
      {% if promo_view.hero.reason is defined and promo_view.hero.reason %}
      <p class="promo-hero-reason">{{ promo_view.hero.reason }}</p>
      {% endif %}
      <p class="promo-hero-meta">{{ ho.url | domain }}{% if ho.valid_until %} · gültig laut Anbieter bis {{ ho.valid_until }}{% endif %} · geprüft {{ ho.last_verified | date_de }}</p>
      <a class="promo-hero-link" href="{{ ho.url }}" target="_blank" rel="noopener">Zum Angebot &nearr;</a>
    </div>
  </div>
  {% else %}
  <div class="promo-hero-card" style="display:flex;align-items:center;justify-content:center;min-height:240px">
    <p style="color:rgba(255,255,255,.75);font-size:14px;font-weight:600;margin:0">Noch keine bestätigte Aktion beobachtet.</p>
  </div>
  {% endif %}

  <div class="promo-stat-card">
    <div>
      <p class="promo-stat-kicker">Was diese Woche auffällt</p>
      <p>{{ promo_lead if promo_lead else 'Für diese Woche liegt noch keine Analyse vor.' }}</p>
    </div>
    {% if promo_report_html %}<a class="promo-stat-link" href="#promo-wochentext">Analyse lesen &nearr;</a>{% endif %}
  </div>
</div>

{% if promo_view.highlight_rest or promo_view.own_anchor %}
<div class="promo-top-grid">
  {% for item in promo_view.highlight_rest %}{{ highlight_card(item) }}{% endfor %}
  {% if promo_view.own_anchor %}{{ highlight_card(promo_view.own_anchor, 'anchor') }}{% endif %}
</div>
{% endif %}

{% if promo_view.highlight_dropped %}
<p class="promo-top-note">{{ promo_view.highlight_dropped }} weitere Aktion{{ 'en' if promo_view.highlight_dropped != 1 else '' }} liegt ebenfalls über der Schwelle und ist unten bei der jeweiligen Marke mit ihrem Score zu finden.</p>
{% endif %}

<details class="promo-method">
  <summary>Wie entsteht die Reihenfolge &bdquo;wichtig&ldquo;?</summary>
  <div class="promo-method-body">
    <p>Jedes Angebot bekommt einen Score von 0 bis 100. Er entsteht aus fünf getrennt bewerteten Achsen mit jeweils null bis drei Punkten und fest formulierten Stufen &ndash; kein Vergleich mit den Angeboten dieser Woche, sondern eine feste Skala. Nur so bedeutet ein Score von 80 nächsten Monat noch dasselbe, und nur so darf die Anzahl der Highlights ehrlich schwanken.</p>
    <ul>
      <li><b>Wechselhebel (30 %)</b> &ndash; wie direkt greift das Angebot die Hürde an, die einen Kunden bisher hält? Eine Wechsel- oder Altgerätprämie zählt hier höher als derselbe Betrag als reiner Rabatt.</li>
      <li><b>Angebotstiefe (25 %)</b> &ndash; wie groß ist der bezifferbare wirtschaftliche Vorteil?</li>
      <li><b>Marktreichweite (20 %)</b> &ndash; Netzbetreiber, breit distribuierte Handelsmarke oder reine Online-Zweitmarke.</li>
      <li><b>Marktbewegung (15 %)</b> &ndash; wie viele andere Marken fahren gerade dieselbe Mechanik?</li>
      <li><b>Kampagnencharakter (10 %)</b> &ndash; befristete Aktion mit Enddatum oder unbefristeter Dauerpreis.</li>
    </ul>
    <p>Die ersten beiden Achsen bewertet ein eigener Prüfagent, der dafür eine wörtliche Belegstelle aus dem Angebotstext nennen muss; ohne Beleg wird die Bewertung gedeckelt. Die übrigen drei rechnet die Pipeline selbst aus, ohne Sprachmodell. Einmal vergebene Bewertungen werden eingefroren und erst neu ermittelt, wenn sich der Angebotstext ändert &ndash; ein Angebot verschwindet also nicht aus den Highlights, nur weil ein Lauf anders ausfällt.</p>
    <p class="promo-method-caveat">Ein hoher Score heißt <b>beobachten</b>, nicht reagieren. Die Wettbewerbsforschung zeigt, dass auf Preisaktionen der Konkurrenz in gut der Hälfte der Fälle gar keine Reaktion erfolgt &ndash; und dass Manager eher über- als unterreagieren.</p>
  </div>
</details>

<div class="promo-tabs" role="group" aria-label="Nach Anbietertyp filtern">
  <button type="button" class="promo-filter on" data-tier="all">Alle</button>
  <button type="button" class="promo-filter" data-tier="1">Netzbetreiber</button>
  <button type="button" class="promo-filter" data-tier="2">Discount &amp; Zweitmarken</button>
</div>

<div class="promo-section-head">
  <h2>Alle {{ promo_view.active_total }} Aktionen nach Anbieter</h2>
  <span>{{ promo_view.brands_active }} Wettbewerber mit laufender Aktion</span>
</div>

<div class="promo-board" id="promo-board">
  {% for b in active_brands %}
  <article class="promo-card" data-tier="{{ b.tier }}">
    <div class="promo-card-head">
      <h3>{{ b.name }}</h3>
      <span class="promo-count{% if b.active_count %} live{% endif %}">{{ b.active_count }} aktiv</span>
    </div>
    {% if b.group and b.group != b.name %}<p class="promo-card-sub">{{ b.group }}</p>{% endif %}

    <ul class="promo-offers">
      {% for o in b.active %}{{ promo_offer(o) }}{% endfor %}
    </ul>
    {% if b.stale %}
    <p class="promo-stale-note">{{ b.stale|length }} frühere Aktion{{ 'en' if b.stale|length != 1 else '' }} ausgelaufen.</p>
    {% endif %}
  </article>
  {% endfor %}
</div>

{% if inactive_brands %}
<div class="promo-inactive">
  <span class="promo-inactive-label">Ohne aktuelle Aktion</span>
  {% for b in inactive_brands %}<span class="promo-inactive-op">{{ b.name }}</span>{% endfor %}
</div>
{% endif %}

{% if promo_report_html %}
<details class="evidence" id="promo-wochentext" style="margin-top:34px">
  <summary><span>Wochentext lesen: wie sich das Preis- und Aktionsbild insgesamt entwickelt</span><small>{% if promo_report_date %}{{ promo_report_date }}{% endif %}</small></summary>
  <div class="evidence-body">
    <article class="prose">{{ promo_report_html | safe }}</article>
  </div>
</details>
{% endif %}

<p class="dz-foot">Diese Seite beobachtet die öffentlichen Aktions- und Tarifseiten deutscher Telcos direkt (Snapshot-Vergleich von Lauf zu Lauf, keine Presse-Feeds). Jede Karte trägt eine Originalquelle und ein Prüfdatum; Preise werden bewusst nicht als dauerhaft gültig übernommen – für den aktuellen Stand gilt immer die verlinkte Seite des Anbieters. Vodafones eigene Aktionsseite wird separat als interne Referenz geführt, nicht als Wettbewerber gezählt.</p>
{% endblock %}
