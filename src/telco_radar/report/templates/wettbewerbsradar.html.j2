{# Wettbewerbs-Radar (RAD-1, 08.09.2026): AUFTRAG_GERAETESEITE.md §2b.

   Die Leitzahl ist die %-Abweichung MIT VORZEICHEN, nicht der Absolutpreis
   - Absolutpreise stehen als Beleg daneben. Sortiert wird aufsteigend: die
   groesste Benachteiligung Vodafones (der negativste Wert) zuerst. Siehe
   `report/wettbewerbsradar.py` fuer die ausgeschriebene Herleitung der
   Sortierrichtung.

   Zwei Abschnitte, nie gemischt (Aufgabe f): Netzbetreiber vergleichen
   TCO-24 gegen TCO-24, Haendler vergleichen Geraetepreis gegen
   Geraetepreis. Nicht erhebbare Haendler stehen NAMENTLICH, nie
   stillschweigend weggelassen. #}
{% extends "base.html.j2" %}
{% set active = 'wettbewerbsradar' %}
{% block title %}Vodafone Product and Services Insights · Wettbewerbs-Radar{% endblock %}

{% block content %}

{# ==========================================================================
   O2 (11.09.2026): die Alarmtabelle - von der Vergleichsansicht der
   Geraeteseite HIERHER gezogen. Die Radar-Seite sortiert Geraete nach
   Abweichung zu Vodafone; die Alarmtabelle ist dieselbe Aussicht im
   Detail (Barpreis ohne Vertrag), und ihr Ort neben der TCO-Uebersicht
   macht die zwei Masse nebeneinander sichtbar, die sie ohnehin sind.
   Die Macros sind Zeile fuer Zeile uebernommen - KEINE Zeile ist
   gestrichen: Kacheln, Filter, Suche, Sortierung, Zeilenaufklapper und
   "alle anzeigen" stehen unveraendert. #}
{# Eine Zeile der Alarmtabelle. Der Prozentsatz steht gross, der Euro-Betrag
   klein darunter: 15 Euro sind bei einem 200-Euro-Geraet viel und bei einem
   2000-Euro-Geraet nichts. Die Pille ersetzt jede Legende - die Zeile sagt
   selbst, wie schlimm sie ist. (Seit O2 steht sie auf dem Wettbewerbs-
   Radar - unverändert, nur der Ort ist neu.) #}
{% macro alarmzeile(z, nr, rest=False) %}
  {# Die Sortierschluessel stehen als Zahl an der ZEILE, nicht im Zelltext.
     "1.099,90 €" ist als Zeichenkette kleiner als "199,00 €", und ein
     Sortierer, der das aus der Zelle liest, ordnet den teuersten Preis nach
     vorn. Die Rohwerte kommen aus `geraete_alarme.zeilen()` - dieselben,
     aus denen die Zelle gesetzt wird. #}
  <tr class="gr-a-zeile{% if rest %} gr-a-rest{% endif %}" data-auf="auf-{{ nr }}"
      data-marke="{{ z.hersteller }}" data-modell="{{ z.modell }}"
      data-speicher="{{ z.speicher or '' }}"
      data-s-geraet="{{ z.modell }} {{ z.speicher or '' }}"
      data-s-laden="{{ z.bester.laden }}"
      data-s-unser="{{ z.unser.preis }}"
      data-s-fremd="{{ z.bester.preis }}"
      data-s-prozent="{{ z.prozent }}"
      data-s-euro="{{ z.euro }}"
      data-s-stufe="{{ z.prozent }}"
      data-s-abgerufen="{{ z.bester.abgerufen_am }}" tabindex="0">
    <td><span class="gr-a-modell">{{ z.modell }}</span>
      <span class="gr-a-klein">{% if z.speicher %}{{ z.speicher }} GB{% else
        %}Speicher unbekannt{% endif %}</span></td>
    <td>{% if z.bester.url %}<a class="gr-a-quelle" href="{{ z.bester.url }}"
        rel="noopener" title="Quelle bei {{ z.bester.laden }} öffnen">{{
        z.bester.laden }}<span class="gr-a-pfeil" aria-hidden="true">↗</span></a>
      {% else %}{{ z.bester.laden }}{% endif %}
      {% if z.auffaellig %}<span class="gr-a-warnung">ungewöhnlich großer
        Abstand – Quelle prüfen</span>{% endif %}</td>
    {# Der Zusatz "in 24 Raten (0 %)" kommt aus `geraete_model.ratenhinweis`,
       nicht aus einer Anbieterliste an dieser Stelle: o2s Zahl ist der
       Gesamtbetrag einer Ratenzahlung und stand bis zum 03.09.2026 in
       derselben Optik wie freenets Barpreis. Wo die Quelle keine Rate
       nennt, bleibt die Zelle wie bisher. #}
    <td class="num"><span class="gr-a-unser gr-a-unser--zurueck">{{ z.unser.preis | euro }}</span>{%
      if z.unser.ratenhinweis %}
      <span class="gr-a-klein">{{ z.unser.ratenhinweis }}</span>{% endif %}</td>
    <td class="num"><span class="gr-a-fremd">{{ z.bester.preis | euro }}</span>{%
      if z.bester.ratenhinweis %}
      <span class="gr-a-klein">{{ z.bester.ratenhinweis }}</span>{% endif %}</td>
    <td class="num"><span class="gr-a-prozent">{{
      '%.1f'|format(z.prozent)|replace('.', ',') }} %</span>
      <span class="gr-a-euro">{{ z.euro | euro }}</span></td>
    <td><span class="gr-pille gr-pille--{{ z.stufe }}">{{ z.stufe_name }}</span></td>
    {# KEINE VERFUEGBARKEITSSPALTE (30.08.2026): sie sagte an der echten
       Ausgabe in 12 von 13 Zeilen "unbekannt". Geloescht ist sie nicht -
       der Geraetekatalog der Geraeteseite traegt sie weiter. #}
    <td><span class="gr-a-klein gr-a-datum">{{ z.bester.abgerufen_am | date_de }}</span></td>
  </tr>
  <tr class="gr-a-auf{% if rest %} gr-a-rest{% endif %}" id="auf-{{ nr }}"><td colspan="7">
    <ul class="gr-a-liste">
      {% for a in z.alle %}
      <li><span{% if a.eigen %} class="gr-a-eigen"{% endif %}>{{ a.laden }}</span>
        <span>{{ a.preis | euro }}{%
          if a.ratenhinweis %} <span class="gr-klein">{{ a.ratenhinweis
          }}</span>{% endif %}</span>
        <span>{{ a.zustand }}</span>
        {% if a.farbe %}<span>{{ a.farbe }}</span>{% endif %}
        <span>{{ a.abgerufen_am | date_de }}</span>
        {% if a.url %}<a href="{{ a.url }}" rel="noopener">Quelle</a>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </td></tr>
{% endmacro %}

{% macro alarmtafel(al) %}
  {# DIE VIER KENNZAHLEN STEHEN OBEN ALS CHIPS und nicht ein zweites Mal
     hier: eine Zahl steht je Ort genau EINMAL (Beruhigungsregel vom
     07.08.2026). Bis zum 04.09.2026 standen sie wortgleich in beiden
     Bloecken derselben Tafel. #}

  {# Zustand und Preisart sind auf dieser Tafel keine Auswahl, sondern der
     Zuschnitt: der Vergleich zeigt ausschliesslich Neugeraete ohne Vertrag.
     Sie stehen deshalb als aktive Etiketten und nicht als Auswahlfelder -
     ein Bedienelement, das nichts aendern kann, ist keins. Sobald ein
     Buendelpreis-Anbieter angebunden ist, traegt `mit_vertrag` Daten und
     die Preisart wird ein echter Umschalter. #}
  <div class="gr-filter">
    <label>Marke <select data-filter="marke"><option value="">alle</option>
      {% for m in al.marken %}<option value="{{ m }}">{{ m }}</option>{% endfor %}
    </select></label>
    <label>Modell <select data-filter="modell"><option value="">alle</option>
      {% for m in al.modelle %}<option value="{{ m }}">{{ m }}</option>{% endfor %}
    </select></label>
    <label>Speicher <select data-filter="speicher"><option value="">alle</option>
      {% for s in al.speicher %}<option value="{{ s }}">{{ s }} GB</option>{% endfor %}
    </select></label>
    <label class="gr-filter--an">Zustand: neu</label>
    <label class="gr-filter--an">Preisart: ohne Vertrag</label>
  </div>

  <div class="gr-werkzeug">
    <input type="search" class="gr-suche" data-filter="suche"
           placeholder="Gerät suchen – Marke, Modell, Anbieter …"
           aria-label="Alarmtabelle durchsuchen">
  </div>

  {% if al.gesamt %}
  <div class="gr-alarm-scroll">
  <table class="gr-alarm">
    {# SORTIERBAR (30.08.2026). Bei acht Spalten und 24 Zeilen ist "sortiere
       nach Euro-Abstand statt nach Prozent" die erste Frage, die jemand vor
       dieser Tabelle hat - 15 Euro sind bei einem 200-Euro-Geraet viel und
       bei einem 2000-Euro-Geraet nichts, und beide Sichten sind richtig.

       `data-sort` nennt den Schluessel an der Zeile, `data-art` sagt, ob
       nach Zahl oder nach Text geordnet wird. Die Vorbelegung steht auf
       "Unterschied, absteigend" - das ist die Reihenfolge, in der
       `geraete_alarme.zeilen()` liefert, und die Kopfzeile sagt sie jetzt
       auch. #}
    <thead><tr>
      <th scope="col"><button type="button" class="gr-sort" data-sort="geraet"
        data-art="text">Gerät</button></th>
      <th scope="col"><button type="button" class="gr-sort" data-sort="laden"
        data-art="text">günstigster Wettbewerber</button></th>
      <th scope="col" class="num"><button type="button" class="gr-sort"
        data-sort="unser" data-art="zahl">unser Preis</button></th>
      <th scope="col" class="num"><button type="button" class="gr-sort"
        data-sort="fremd" data-art="zahl">Wettbewerbspreis</button></th>
      {# EINE Spalte, ZWEI Sortierungen. Die Zelle darunter traegt beide
         Zahlen (Prozent gross, Euro klein) - das ist die Entscheidung vom
         30.08.2026 und sie bleibt. Zwei Spalten daraus zu machen hiesse,
         dieselbe Groesse zweimal zu setzen; ein zweiter Knopf im Kopf
         beantwortet Antonios Frage ohne das. #}
      <th scope="col" class="num"><button type="button" class="gr-sort"
        data-sort="prozent" data-art="zahl" data-vor="ab"
        aria-sort="descending">Unterschied&nbsp;%</button>{#
        #}<span class="gr-sort-trenner" aria-hidden="true">·</span>{#
        Ein SICHTBARES Trennzeichen zwischen den zwei Knoepfen. Ohne es las
        die Kopfzeile "UNTERSCHIED %€" - genau der Fehler, der in dieser
        Sitzung aus 24 Generationen und 54 Modellen "2454 Modelle" gemacht
        hat: zwei Inline-Elemente ohne ein Zeichen dazwischen sind fuer das
        Auge ein Wort. #}<button type="button"
        class="gr-sort gr-sort--zweit" data-sort="euro" data-art="zahl"
        aria-label="nach Unterschied in Euro sortieren">€</button></th>
      <th scope="col"><button type="button" class="gr-sort" data-sort="stufe"
        data-art="zahl">Einstufung</button></th>
      <th scope="col"><button type="button" class="gr-sort"
        data-sort="abgerufen" data-art="text">abgerufen</button></th>
    </tr></thead>
    <tbody>
      {% for z in al.sichtbar %}{{ alarmzeile(z, loop.index) }}{% endfor %}
      {% for z in al.rest %}{{ alarmzeile(z, 'r' ~ loop.index, True) }}{% endfor %}
    </tbody>
  </table>
  </div>
  {% if al.rest %}
  <p class="gr-erklaer"><button type="button" class="gr-knopf" id="gr-mehr"
    >alle {{ al.gesamt }} anzeigen</button></p>
  {% endif %}
  {% endif %}
  {# Der Satz steht IMMER da und ist versteckt, solange Zeilen sichtbar sind.
     Er gehoert dem Filter, nicht dem Datenbestand: eine leere Tabelle ohne
     Erklaerung liest sich als kaputte Seite, und das faellt beim Filtern
     genauso an wie beim leeren Bestand. #}
  <p class="gr-erklaer gr-a-leer"{% if al.gesamt %} hidden{% endif %}>Zu
  dieser Auswahl ist bei keiner Modell-Speicher-Kombination ein Wettbewerber
  günstiger.</p>

  {# "Geraete" waere hier falsch, und ein Test haelt das fest: gezaehlt
     werden Modell-Speicher-Kombinationen, und davon gibt es mehr als
     Geraete. Genau diese Verwechslung stand schon einmal auf der Seite
     ("62 Geraete im Vergleich" bei 59 beobachteten). #}
  <p class="gr-erklaer">{{ al.verglichen }} Modelle mit ihren Speichergrößen
  stehen einem Wettbewerber gegenüber{% if al.ohne_wettbewerber %}; bei
  weiteren {{ al.ohne_wettbewerber }} führt kein beobachteter Anbieter
  dieselbe Kombination aus Modell und Speichergröße, sie sind deshalb in
  keiner der vier Kacheln gezählt{% endif %}. Verglichen werden ausschließlich Neugeräte ohne Tarifvertrag, jeweils
  der günstigste Preis je Laden. Wo ein Anbieter das Gerät nur gegen
  Ratenzahlung abgibt, steht der Gesamtbetrag der Raten in der Spalte — er
  ist an der Ratenzahl erkennbar und nicht dasselbe wie ein Barpreis.</p>
{% endmacro %}
<section class="page-hero wide">
  <div class="page-hero-row">
    <div>
      <p class="page-kicker">Geräte · Wettbewerbsvergleich</p>
      <h1>Bei welchem Gerät ist Vodafone teurer als der Wettbewerb?</h1>
    </div>
    {# O4 (STRATEGIE_GERAETE_OPTIK §3): der EINE zentrale Export-Ort DIESER
       Seite. Die Datei trägt TCO-24 der Netzbetreiber UND den Händler-
       Barpreis zusammen; ihre Abweichungsspalte ist aus derselben Rechnung
       GELESEN, die diese Seite rendert (`report/wettbewerbsradar.py`) - der
       Export rechnet keine Prozentzahl selbst. Als KNOPF in der Kopfzeile
       und nicht als Tabelle: der Radar ist mobil ohnehin rund 20.400 px
       hoch (bekannt, gemeldet), und ein offener Tabellenabschnitt würde
       ihn schlechter machen. #}
    {% if wettbewerbsradar.export and wettbewerbsradar.export.zeilen %}
    <span class="gr-export-knoepfe">
      <a class="gr-knopf" href="{{ wettbewerbsradar.export.datei }}" download
        >Radar-Export ({{ wettbewerbsradar.export.zeilen }} Zeilen)</a>
    </span>
    {% endif %}
  </div>
  <p class="page-lead">Leitzahl ist die Abweichung in Prozent, mit
  Vorzeichen – nicht der Absolutpreis. Ein negativer Wert heißt: ein
  Wettbewerber ist bei diesem Gerät günstiger als Vodafone. Ganz oben stehen
  die Geräte, bei denen dieser Abstand am größten ist. Die Absolutpreise
  stehen daneben als Beleg, mit Quelle und Abrufdatum – sie sind der Beweis,
  nicht die Botschaft. Grundlage der Netzbetreiber-Zeilen ist die TCO über
  24 Monate (Gerät plus Tarif); Netzbetreiber werden nur innerhalb
  desselben Tarifbandes verglichen (Klein/Mittel/Groß nach Datenvolumen) –
  liegen zwei Angebote in verschiedenen Bändern, steht das ausdrücklich da,
  statt sie zu vermischen.</p>
</section>

{# O2 (11.09.2026): die Alarmtabelle - Barpreis ohne Vertrag, wo ein
   Wettbewerber unter uns liegt. Sie stand bis O2 in der Vergleichsansicht
   der Geraeteseite; hier steht sie neben der TCO-Uebersicht, deren
   Schwester im Detail sie ist. Die vier Kacheln (Kritisch/Mittel/Gering/
   Bestpreis) zaehlen dieselben Zeilen wie die Tabelle unter ihnen. #}
{% if wettbewerbsradar.alarme.hat_daten or wettbewerbsradar.alarme.kacheln %}
<div class="wr-sektion" id="wr-alarme">
  <h2 class="rubrik">Preis-Alarme – Barpreis ohne Vertrag</h2>
  <p class="gr-erklaer">Bei diesen Geräten liegt ein Wettbewerber im
  Gerätepreis unter Vodafone – mit Abstand in Prozent und Euro, dem
  günstigsten Anbieter mit Namen und dem Beleg dazu. Vier Stufen sortieren
  die Meldungen; die Tabelle darunter führt jede Zeile mit Quelllink und
  Abrufdatum.</p>
  <ul class="gr-chips" aria-label="Preis-Alarme">
    {% for k in wettbewerbsradar.alarme.kacheln %}
    <li class="gr-chip gr-chip--{{ k.schluessel }}"><b>{{ k.zahl }}</b>
      <span>{{ k.name }}</span> <em>{{ k.schwelle }}</em></li>
    {% endfor %}
  </ul>
  {{ alarmtafel(wettbewerbsradar.alarme) }}
</div>
{% endif %}

{% if wettbewerbsradar.hat_daten %}
<section class="wr-sektion">
  <h2 class="rubrik">Netzbetreiber – TCO über 24 Monate</h2>
  <p class="gr-erklaer">Vodafones eigener TCO-24-Wert je Gerät ist die
  Grundlage; Telekom, 1&amp;1 und o2 stehen darunter – mit einer
  %-Abweichung, gerechnet gegen Vodafones Preis im selben
  Datenvolumen-Band (Klein/Mittel/Groß), sonst mit einer benannten Lücke.
  Kein Anbieter wird weggelassen, auch nicht, wenn er keine Zahl trägt.
  Dazu congstar – Zweitmarke im Telekom-Netz, kein eigener Netzbetreiber:
  congstar-Zeilen stehen nur bei Geräten, die congstar selbst im Bündel
  führt; die Discount-Marke führt kein Vollsortiment, deshalb keine
  Leerzeile bei den übrigen Geräten.
  {# O3 (B6): die Tarifübersicht war bis hierher eine Waise - erreichbar
     nur über die Fußnote der Geräteseite. Der Radar vergleicht in
     Tarifbändern; der Weg zu deren Quelle gehört auf diese Seite. #}
  Welche Datenvolumen in welches Band fallen, steht in der
  <a href="{{ prefix }}tarife.html">Tarifübersicht</a>.</p>

  {% macro wr_zeile(z) %}
  <tr class="wr-zeile wr-status--{{ z.status }}">
    <td>{{ z.anbieter }}</td>
    <td class="wr-tarif">{% if z.tarif %}{{ z.tarif }}{% else %}–{% endif %}</td>
    <td class="num">{% if z.gesamt is not none %}{{ '%.2f'|format(z.gesamt) }} €{% else %}–{% endif %}</td>
    <td>{{ z.band_label or '–' }}{% if z.status == 'vergleichbar' and z.vf_gesamt is not none %} · VF {{ '%.2f'|format(z.vf_gesamt) }} €{% endif %}</td>
    <td class="num wr-prozent{% if z.prozent is not none %}{{ ' wr-prozent--negativ' if z.prozent < 0 else ' wr-prozent--positiv' }}{% endif %}">
      {%- if z.prozent is not none -%}
        {{ '%+.1f'|format(z.prozent) }} %
      {%- else -%}
        {% if z.status == 'band_mismatch' %}Band-Mismatch{% elif z.status == 'kein_buendel' %}kein Bündel erhoben{% elif z.status == 'nicht_vergleichbar' %}nicht vergleichbar{% else %}–{% endif %}
      {%- endif -%}
    </td>
    <td class="wr-beleg">
      {% if z.quelle_url %}<a href="{{ z.quelle_url }}" rel="noopener">{{ z.quelle_url | domain }}</a>{% if z.abgerufen_am %} · {{ z.abgerufen_am }}{% endif %}
      {% elif z.grund %}<span class="wr-grund">{{ z.grund }}</span>{% else %}–{% endif %}
    </td>
  </tr>
  {% endmacro %}

  {% macro wr_gruppe(g) %}
  <div class="wr-gruppe">
    <h3 class="wr-gruppenkopf">{{ g.titel }}{% if g.speicher %} · {{ g.speicher }} GB{% endif %}</h3>
    {# O3 (B5): der Querlink zurück in die Vergleichsansicht DIESES
       Geräts - der Radar hatte bis O3 keinen einzigen eingehenden
       Querverweis pro Gerät. `g.id` ist dieselbe Modell-ID, die der
       Selektor der Geräteseite trägt (beide kommen aus
       `geraete_tco_karten.modelle()`); `app.js` wertet ?modell= beim
       Laden aus. Der Pfeil → ist derselbe Richtungscode wie der
       Schwesterseiten-Link der Geräteseite (↗ wäre ein externer). #}
    <a class="wr-quer" href="{{ prefix }}geraete.html?modell={{ g.id }}"
      >Dieses Gerät im Vergleich&nbsp;→</a>
    {% if g.vodafone %}
    <p class="wr-basis">Vodafone-Basis: <b>{{ '%.2f'|format(g.vodafone.gesamt) }} €</b> TCO-24
      ({{ g.vodafone.tarif }}, Band {{ g.vodafone.band_label }}{% if g.vodafone.naeherung %}, gerechnete Näherung{% endif %})
      {% if g.vodafone.quelle_url %} · <a href="{{ g.vodafone.quelle_url }}" rel="noopener">{{ g.vodafone.quelle_url | domain }}</a>{% if g.vodafone.abgerufen_am %} · {{ g.vodafone.abgerufen_am }}{% endif %}{% endif %}</p>
    {% else %}
    <p class="wr-basis wr-basis--leer">{{ g.vodafone_grund }}</p>
    {% endif %}
    <div class="gr-scroll">
    <table class="src-table wr-tabelle">
      <thead><tr><th>Anbieter</th><th>Tarif</th><th class="num">TCO-24</th><th>Band</th>
        <th class="num">Abweichung</th><th>Beleg</th></tr></thead>
      <tbody>{% for z in g.zeilen %}{{ wr_zeile(z) }}{% endfor %}</tbody>
    </table>
    </div>
  </div>
  {% endmacro %}

  {% for g in wettbewerbsradar.gruppen_sichtbar %}{{ wr_gruppe(g) }}{% endfor %}
  {% if wettbewerbsradar.gruppen_rest %}
  <details class="gr-auf">
    <summary>Alle {{ wettbewerbsradar.gruppen | length }} Geräte anzeigen</summary>
    {% for g in wettbewerbsradar.gruppen_rest %}{{ wr_gruppe(g) }}{% endfor %}
  </details>
  {% endif %}
</section>
{% else %}
<section class="wr-sektion">
  <h2 class="rubrik">Netzbetreiber – TCO über 24 Monate</h2>
  <p class="gr-erklaer">Noch keine Gerätedaten erhoben – der Wettbewerbs-Radar
  füllt sich mit dem nächsten Lauf.</p>
</section>
{% endif %}

<section class="wr-sektion">
  <h2 class="rubrik">Händler – Gerätepreis</h2>
  <p class="gr-erklaer">Saturn, mobilcom-debitel und Amazon (falls Preise
  vorliegen) verkaufen ohne eigenen Tarif – hier zählt der reine
  Gerätepreis gegen Vodafones Gerätepreis, dieselbe %-Logik wie oben, aber
  nie gegen eine TCO gerechnet.</p>
  {% if wettbewerbsradar.haendler %}
  <div class="gr-scroll">
  <table class="src-table wr-tabelle">
    <thead><tr><th>Gerät</th><th>Händler</th><th class="num">Vodafone</th>
      <th class="num">Händler</th><th class="num">Abweichung</th><th>Beleg</th></tr></thead>
    <tbody>
      {% macro wr_haendler_zeile(h) %}
      <tr class="wr-zeile">
        <td>{{ h.hersteller }} {{ h.modell }}{% if h.speicher %} · {{ h.speicher }} GB{% endif %}</td>
        <td>{{ h.anbieter }}</td>
        <td class="num">{{ '%.2f'|format(h.vodafone_preis) }} €</td>
        <td class="num">{{ '%.2f'|format(h.preis) }} €</td>
        <td class="num wr-prozent{{ ' wr-prozent--negativ' if h.prozent < 0 else ' wr-prozent--positiv' }}">{{ '%+.1f'|format(h.prozent) }} %</td>
        <td class="wr-beleg">{% if h.url %}<a href="{{ h.url }}" rel="noopener">{{ h.url | domain }}</a>{% if h.abgerufen_am %} · {{ h.abgerufen_am }}{% endif %}{% else %}–{% endif %}</td>
      </tr>
      {% endmacro %}
      {% for h in wettbewerbsradar.haendler_sichtbar %}{{ wr_haendler_zeile(h) }}{% endfor %}
    </tbody>
  </table>
  </div>
  {% if wettbewerbsradar.haendler_rest %}
  <details class="gr-auf">
    <summary>Alle {{ wettbewerbsradar.haendler | length }} Händler-Zeilen anzeigen</summary>
    <div class="gr-scroll">
    <table class="src-table wr-tabelle">
      <tbody>{% for h in wettbewerbsradar.haendler_rest %}{{ wr_haendler_zeile(h) }}{% endfor %}</tbody>
    </table>
    </div>
  </details>
  {% endif %}
  {% else %}
  <p class="gr-erklaer">Zu keinem Gerät liegt bei Vodafone UND einem Händler
  gleichzeitig ein belegter Gerätepreis vor.</p>
  {% endif %}
</section>

{# O2 (11.09.2026): der Sortiments-Aufklapper - welche Geräte der
   Wettbewerb führt, die Vodafone nicht führt. Er stand bis O2 im
   Portfolio-Block der Geraeteseite; er ist eine Sortiments-Aussage und
   damit dieselbe Frage, die der Radar über den Preis stellt. #}
{% if wettbewerbsradar.ohne_vodafone %}
<section class="wr-sektion" id="wr-gelistet">
  <h2 class="rubrik">Bei Wettbewerbern gelistet, bei Vodafone nicht</h2>
  <p class="gr-erklaer">Diese Geräte führt mindestens ein beobachteter
  Wettbewerber im Regal, Vodafone keins von beiden – der ab-Preis nennt den
  günstigsten Anbieter, der sie führt.</p>
  <details class="evidence gr-vergleich-luecke">
    <summary>Bei Wettbewerbern gelistet, bei Vodafone nicht
      ({{ wettbewerbsradar.ohne_vodafone_gesamt }})</summary>
    <div class="evidence-body">
    <ul class="gr-v-liste">
      {% for l in wettbewerbsradar.ohne_vodafone %}
      <li><span class="szl">{{ l.modell }}</span>
        {% if l.speicher %}<span class="gr-v-meta">{{ l.speicher }} GB</span>{% endif %}
        <span class="gr-v-prozent">ab {{ l.ab_preis | euro }}</span>
        <span class="gr-v-datum">{{ l.anzahl }} {{ 'Anbieter' if l.anzahl == 1
          else 'Anbieter' }}</span>
        <a href="{{ l.anbieter[0].url }}" rel="noopener">{{ l.anbieter[0].laden }}</a>
      </li>
      {% endfor %}
    </ul>
    {% if wettbewerbsradar.ohne_vodafone_gesamt > wettbewerbsradar.ohne_vodafone|length %}
    <p class="gr-v-meta">{{ wettbewerbsradar.ohne_vodafone_gesamt }} insgesamt.</p>
    {% endif %}
    </div>
  </details>
</section>
{% endif %}

{# ==========================================================================
   O3 (B4, STRATEGIE_GERAETE_OPTIK §3 + §5.2, 15.09.2026): die Portfolio-
   Abschnitte der Geräteseite - hierher gezogen, nicht kopiert. Bis O3
   standen sie in der unverknüpften Tafel `#tafel-portfolio` der Geräte-
   seite (seit BRIEF_FADEN ohne Knopf, seit O3 GANZ weg): Verweildauer,
   Preisverfall, Nachfolger-Effekt und Portfolio-Tiefe sind Portfolio-
   Fragen, und der Radar ist die Portfolio-Seite („wo sind wir zu teuer")
   - Antonios Entscheidung, Strategie §5.2, KEIN vierter Reiter auf der
   Geräteseite.

   Höhenbewusst (Auftragswortlaut: „Aufklapper erlaubt, Vorzug zugeklappt"):
   die Wochenkarte der Preisbewegungen steht als EINER zugeklappter
   Aufklapper; die Lifecycle-Listen behalten ihre bestehenden Deckel aus
   `geraete_view` (LIFECYCLE_SICHTBAR / NACHFOLGER_SICHTBAR=0 - der
   Nachfolger steht komplett im Aufklapper). #}
{% set port = wettbewerbsradar.portfolio %}
{% if port and port.auffaellig and port.auffaellig.hat_daten %}
<section class="wr-sektion gr-auffaellig" id="wr-bewegungen">
  <details class="gr-auf">
    <summary>Was diese Woche auffällt – letzte {{ port.fenster_tage }}
      Tage ({{ port.auffaellig.bewegungen | length }}
      {{ 'Bewegung' if port.auffaellig.bewegungen | length == 1
         else 'Bewegungen' }})</summary>
    <div class="gr-auffaellig-karte">
      <ul class="gr-saetze">
        {% for s in port.auffaellig.saetze %}<li class="szl">{{ s }}</li>{% endfor %}
      </ul>
    </div>
    {% if port.auffaellig.bewegungen %}
    <div class="gr-scroll">
    <table class="src-table gr-tabelle">
      <thead><tr><th>Gerät</th><th>Anbieter</th><th class="num">vorher</th>
        <th class="num">jetzt</th><th class="num">Δ</th><th>seit</th>
        <th>Beleg</th></tr></thead>
      <tbody>
        {% for b in port.auffaellig.bewegungen %}
        <tr>
          <td>{{ b.modell }}</td><td>{{ b.anbieter }}</td>
          <td class="num">{{ b.von | euro }}</td>
          <td class="num">{{ b.auf | euro }}</td>
          <td class="num gr-delta{{ ' gr-delta--runter' if b.delta < 0 else ' gr-delta--rauf' }}">
            {{ '%+.2f'|format(b.delta) }} €</td>
          <td>{{ b.datum | date_de }}</td>
          <td>{% if b.url %}<a href="{{ b.url }}" rel="noopener">{{ b.url | domain }}</a>{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
  </details>
</section>
{% endif %}

{# Eine Zeile der Nachfolger-Tabelle. Macro statt Kopie, weil die Zeile
   zweimal steht (sichtbar / hinter dem Aufklapper, wie bei `dauern` und
   `trends`) und jedes Feld einzeln gegen ein FEHLENDES Gegenstueck
   abgesichert ist (B8 der Zurueckweisung vom 31.08.2026): `nach`/`prozent`
   kommen per `.get(...)` mit leerem Dict als Rueckfall, ein Prozentwert
   wird nur formatiert, wenn er wirklich da ist, und `marktstart` durchlaeuft
   den Datumsfilter nur, wenn er gesetzt ist - sonst wirft `date_de`
   (`datetime.fromisoformat`) auf `None`. #}
{% macro nachfolgerzeile(n, zustand_spalte) %}
  <tr><td>{{ n.modell }}</td>
    <td>{{ n.get('anbieter') or '–' }}</td>
    {% if zustand_spalte %}<td>{{ n.get('zustand') or '–' }}</td>{% endif %}
    <td>{{ n.nachfolger_modell }}{% if n.marktstart %}, {{ n.marktstart | date_de }}{% endif %}</td>
    <td class="num">{% if n.basis %}{{ '%.0f'|format(n.basis) }} €{% else %}–{% endif %}</td>
    {% set nach = n.get('nach') or {} %}
    {% set prozent = n.get('prozent') or {} %}
    {% for tage in [30, 60, 90] %}
    {% set wert = nach.get(tage) %}
    {% set proz = prozent.get(tage) %}
    <td class="num">{% if wert %}{{ '%.0f'|format(wert) }} €{% if proz is not none %}
      <span class="gr-klein">{{ '%+.1f'|format(proz) }} %</span>{% endif %}{% else %}–{% endif %}</td>
    {% endfor %}
    {% set vt = n.get('verweildauer_tage') %}
    {% set bt = n.get('beobachtet_tage') %}
    {% set ng = n.get('noch_gelistet') %}
    <td>{% if vt is not none %}{{ vt }} {{ 'Tag' if vt == 1 else 'Tage' }} seit Marktstart{% if n.get('verweildauer_untergrenze') and bt is not none %} <span class="gr-klein">davon {{ bt }} {{ 'Tag' if bt == 1 else 'Tage' }} gemessen</span>{% endif %}{% if ng is sameas false %} <span class="gr-klein">ausgelistet</span>{% elif ng is none %} <span class="gr-klein">Status unbekannt</span>{% endif %}{% else %}–{% endif %}</td>
  </tr>
{% endmacro %}

{% if port and port.lifecycle and (port.lifecycle.hinweis or port.lifecycle.portfolio
                                  or port.lifecycle.dauern or port.lifecycle.trends
                                  or port.lifecycle.nachfolger) %}
{# Die id `lifecycle` ist das alte Sprungziel der Geräteseite - sie lebt
   hier weiter (dasselbe Stück Inhalt, neuer Ort), genau wie die
   Weiterleitungs-Dateinamen der Umbenennung vom 06.08.2026. #}
<section class="wr-sektion gr-lifecycle" id="lifecycle">
  <h2 class="rubrik">Wie lange ein Gerät im Markt lebt</h2>
  <p class="gr-basis{{ ' gr-basis--duenn' if port.lifecycle.duenn }}">{{ port.lifecycle.hinweis }}</p>

  {% if port.lifecycle.portfolio %}
  <h3 class="gr-unter">Wie viele Generationen ein Anbieter gleichzeitig führt</h3>
  <p class="gr-erklaer">Ein Wettbewerber, der das Vorjahresmodell im Regal
  lässt, hat einen Preiseinstieg, ohne den Preis des neuen Geräts anzufassen.
  Gezählt werden Jahrgänge, nicht Varianten: iPhone 17, 17 Pro und 17 Pro Max
  sind ein Jahrgang, acht Farben eines Modells sind ein Regalplatz.</p>
  {# BEIDE ZAHLEN TRAGEN IHR WORT und zwischen ihnen steht ein sichtbares
     Trennzeichen - bis zum 30.08.2026 verschmolzen sie im Browser zu
     „2454 Modelle" (26-px-Rasterspalte, keine Flex); die ganze Geschichte
     steht in der Git-Historie der Geräteseite. #}
  <ul class="dz-balken gr-tiefe">
    {% set tiefstes = port.lifecycle.portfolio[0].generationen or 1 %}
    {% for t in port.lifecycle.portfolio %}
    <li{% if t.eigen %} class="gr-eigen"{% endif %}>
      <span class="dz-balken-name">{{ t.anbieter }}</span>
      <span class="dz-balken-spur"><span class="dz-balken-fuell"
        style="width:{{ (100 * t.generationen / tiefstes) | round | int }}%"></span></span>
      <span class="dz-balken-n gr-tiefe-n"><span class="gr-tiefe-gen">{{
        t.generationen }} {{ 'Generation' if t.generationen == 1 else 'Generationen'
        }}</span> · <span class="gr-tiefe-mod">{{ t.modelle_anzahl }} {{
        'Modell' if t.modelle_anzahl == 1 else 'Modelle' }}</span></span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if port.lifecycle.dauern %}
  {# DER DECKEL STEHT IM MODUL (`geraete_view.LIFECYCLE_SICHTBAR`), nicht
     hier - der Rest ist zugeklappt, nicht geloescht. #}
  {% set sichtbar = port.lifecycle_sichtbar %}
  <h3 class="gr-unter">Verweildauer im Regal</h3>
  <ul class="list-card gr-dauern">
    {% for d in port.lifecycle.dauern[:sichtbar] %}
    <li class="list-row"><span class="list-row-date">{{ d.tage }} Tage</span>
      {{ d.modell }} bei {{ d.anbieter }}{% if d.status != 'aktiv' %} ({{ d.status }}){% endif %}</li>
    {% endfor %}
  </ul>
  {% if port.lifecycle.dauern | length > sichtbar %}
  <details class="gr-mehrliste"><summary>{{ port.lifecycle.dauern | length - sichtbar }} weitere</summary>
  <ul class="list-card gr-dauern">
    {% for d in port.lifecycle.dauern[sichtbar:] %}
    <li class="list-row"><span class="list-row-date">{{ d.tage }} Tage</span>
      {{ d.modell }} bei {{ d.anbieter }}{% if d.status != 'aktiv' %} ({{ d.status }}){% endif %}</li>
    {% endfor %}
  </ul>
  </details>
  {% endif %}
  {% endif %}

  {% if port.lifecycle.trends %}
  {% set sichtbar = port.lifecycle_sichtbar %}
  <h3 class="gr-unter">Preisverfall gegenüber dem Einführungspreis</h3>
  <ul class="list-card gr-verfall">
    {% for v in port.lifecycle.trends[:sichtbar] %}
    <li class="list-row"><span class="list-row-date">{{ '%+.1f'|format(v.prozent) }} %</span>
      {{ v.modell }} bei {{ v.anbieter }}: {{ v.erstpreis | euro }}
      (seit {{ v.erstpreis_am | date_de }}) auf {{ v.aktuell | euro }}
      <span class="gr-klein">{{ 'ohne Vertrag' if v.art == 'ohne_vertrag' else 'Zuzahlung im Bündel' }}</span></li>
    {% endfor %}
  </ul>
  {% if port.lifecycle.trends | length > sichtbar %}
  <details class="gr-mehrliste"><summary>{{ port.lifecycle.trends | length - sichtbar }} weitere</summary>
  <ul class="list-card gr-verfall">
    {% for v in port.lifecycle.trends[sichtbar:] %}
    <li class="list-row"><span class="list-row-date">{{ '%+.1f'|format(v.prozent) }} %</span>
      {{ v.modell }} bei {{ v.anbieter }}: {{ v.erstpreis | euro }}
      (seit {{ v.erstpreis_am | date_de }}) auf {{ v.aktuell | euro }}
      <span class="gr-klein">{{ 'ohne Vertrag' if v.art == 'ohne_vertrag' else 'Zuzahlung im Bündel' }}</span></li>
    {% endfor %}
  </ul>
  </details>
  {% endif %}
  {% endif %}

  {% if port.lifecycle.nachfolger %}
  <h3 class="gr-unter">Was der Nachfolger mit dem Preis macht</h3>
  {# Die Sektion STELLT die Frage, sie beantwortet sie nicht vorab (B6 der
     Zurueckweisung vom 31.08.2026): „bei Vodafone meist direkt ersetzt"
     war unbelegt und vom eigenen Bestand widerlegt. Die Spalte heisst
     bewusst NICHT „Verweildauer" - die Liste darüber misst LISTUNGSDAUER,
     diese Zelle die Zeit SEIT EINEM KATALOGDATUM; beide können um den
     Faktor 30 auseinanderliegen. #}
  <p class="gr-erklaer">Bleibt ein Vorjahresmodell nach dem Start seines
  Nachfolgers als günstiger Einstieg im Regal, oder wird es ersetzt – bei
  uns wie beim Wettbewerb? Die Spalte „Seit dem Nachfolger“ zählt die Tage
  seit dessen Marktstart. Wo die eigene Beobachtung erst später begann,
  steht daneben, wie viele dieser Tage wirklich gemessen sind – der Rest ist
  eine Annahme aus dem Katalogdatum, keine Messung.</p>
  {# DER DECKEL STEHT IM MODUL (`geraete_view.NACHFOLGER_SICHTBAR` = 0):
     die GESAMTE Tabelle steht in EINEM Aufklapper; ist `sichtbar` groesser
     als der Bestand, entfaellt der Aufklapper (derselbe Codepfad traegt
     beide Faelle). #}
  {% set sichtbar = port.nachfolger_sichtbar %}
  {% set gesamt = port.lifecycle.nachfolger %}
  {% set zustaende = gesamt | map(attribute='zustand') | select | unique | list %}
  {% set zustand_spalte = zustaende | length > 1 %}
  {% macro nachfolgertabelle(zeilen) %}
  <div class="gr-scroll">
  <table class="src-table gr-nachfolger">
    <thead><tr><th>Gerät</th><th>Anbieter</th>{% if zustand_spalte %}<th>Zustand</th>{% endif %}
      <th>Nachfolger ab</th><th class="num">vorher</th>
      <th class="num">+30 Tage</th><th class="num">+60</th><th class="num">+90</th>
      <th>Seit dem Nachfolger</th></tr></thead>
    <tbody>
      {% for n in zeilen %}{{ nachfolgerzeile(n, zustand_spalte) }}{% endfor %}
    </tbody>
  </table>
  </div>
  {% endmacro %}
  {% if gesamt | length <= sichtbar %}
  {{ nachfolgertabelle(gesamt) }}
  {% else %}
  {% if sichtbar %}{{ nachfolgertabelle(gesamt[:sichtbar]) }}{% endif %}
  <details class="gr-mehrliste"><summary>{{ gesamt | length - sichtbar }}
    {{- ' weitere' if sichtbar else ' Zeilen' }}</summary>
  {{ nachfolgertabelle(gesamt[sichtbar:]) }}
  </details>
  {% endif %}
  {% elif port.lifecycle.nachfolger_hinweis %}
  <h3 class="gr-unter">Was der Nachfolger mit dem Preis macht</h3>
  <p class="gr-erklaer">{{ port.lifecycle.nachfolger_hinweis }}</p>
  {% endif %}
</section>
{% endif %}

{% if wettbewerbsradar.nicht_erhebbar %}
<section class="wr-sektion">
  <h2 class="rubrik">Nicht erhebbar</h2>
  <p class="gr-erklaer">Diese Händler gehören zum Vergleichskreis, liefern
  aber heute keine Daten – benannt statt stillschweigend weggelassen.</p>
  <table class="src-table">
    <thead><tr><th>Anbieter</th><th>Warum</th></tr></thead>
    <tbody>
      {% for a in wettbewerbsradar.nicht_erhebbar %}
      <tr><td>{{ a.anbieter }}</td><td>{{ a.grund }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endif %}

{% endblock %}
