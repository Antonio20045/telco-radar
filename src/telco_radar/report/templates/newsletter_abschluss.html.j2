{% extends "base.html.j2" %}
{% import "_design.html.j2" as d %}
{% set buehne = true %}
{% block title %}{{ titel }} – Vodafone Product and Services Insights{% endblock %}
{# Statisch, damit Bestaetigung und Abmeldung auch dann stehen, wenn der
   Anmeldedienst auf Render Free gerade schlaeft. Ein Bild, ein Satz, ein
   Weg zurueck - wie der Kopf der Anmeldeseite, ohne Strecke. #}
{% block buehne %}
<section class="nl-ende">
  <div class="wa-bild" aria-hidden="true">{{ d.motiv('band-newsletter', prefix, 'wa-motiv', eager=true) }}</div>
  <div class="wa-schleier" aria-hidden="true"></div>
  <header class="mg-kopf nl-ende-text">
    <p class="mg-woche">Newsletter</p>
    <h1 class="mg-titel">{{ titel }}</h1>
    <p class="mg-datum">{{ text }}</p>
    <p class="nl-weiter"><a href="{{ prefix }}index.html">{{ weiter }} &rsaquo;</a></p>
  </header>
</section>
{% endblock %}
{% block content %}{% endblock %}
