{% extends "base.html.j2" %}
{% set active = 'sources' %}
{% block title %}Telco Radar - Quellen{% endblock %}
{% set kmap = {'rss':'Feed','json_api':'Feed (API)','newsroom':'Newsroom','newsroom_js':'Newsroom','official':'Referenz'} %}
{% block content %}
<section class="page-hero wide">
  <p class="page-kicker">Transparenz</p>
  <h1>Überwachte Quellen</h1>
  <p class="page-lead">Primärquelle jedes Betreibers ist <b>seine eigene offizielle Presseseite</b> –
  per Feed (RSS/JSON), statischem Newsroom oder Headless-Render direkt vom Unternehmen. Viele Betreiber haben
  zusätzlich einen eigenen Kanal für Zahlen und Zukäufe (Investor Relations), einen Technik-Blog oder eigene
  Landesgesellschaften; die stehen hier als weitere Zeile beim selben Betreiber. Kein Dritt-Medium wird
  als Quelle eines Betreibers ausgegeben. Die Telco-Fachpresse ist eine separate, klar gekennzeichnete
  <b>zweite Ebene</b>, die Themenfelder (Technologie, Geräte, Regulierung) eine <b>dritte</b>.
  Alles verlinkt und nachprüfbar.</p>
</section>

<div class="region-tiles">
  {% for region, ops in by_region.items() %}
  <div class="region-tile"><b>{{ ops | length }}</b><span>{{ region }}</span></div>
  {% endfor %}
</div>

<div class="region-card-list">
  {% for region, ops in by_region.items() %}
  <section class="region-card">
    <h2>{{ region }} <span>{{ ops | length }} Betreiber</span></h2>
    <div class="op-grid">
      {% for op in ops %}
      <div class="op-row">
        {% for s in op.sources %}
        <a class="op-row-line" href="{{ s.url }}" target="_blank" rel="noopener">
          <span class="op-row-name">{{ op.name }}{% if op.sources|length > 1 %} <span style="color:var(--faint2);font-weight:500">· {{ kmap.get(s.kind, s.kind) }}</span>{% endif %}</span>
          <span class="op-row-type">{{ kmap.get(s.kind, s.kind) if op.sources|length == 1 else s.url | domain }}</span>
        </a>
        {% if s.kind == 'official' %}<span class="op-row-note" title="{{ s.plan }}">offizielle Referenz – Auto-Signal vorerst über Fachpresse</span>{% endif %}
        {% else %}
        <div class="op-row-line"><span class="op-row-name">{{ op.name }}</span><span class="op-row-type">–</span></div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</div>

{% if tech_themes %}
<div class="card" style="margin-top:20px">
  <h2 style="margin:0 0 6px;font-size:17px;font-weight:700">Technologie, Geräte &amp; Regulierung <span style="color:var(--faint2);font-weight:500">dritte Ebene · {{ n_tech_sources }} Quellen in {{ tech_themes | length }} Themenfeldern</span></h2>
  <p style="margin:0 0 16px;font-size:13.5px;color:var(--faint2);max-width:760px">Was den Telco-Markt verändert, kommt nicht nur von anderen Netzbetreibern:
  KI-Anbieter, Geräte- und Chiphersteller, Netzausrüster, Satellitenbetreiber und Regulierungsbehörden entscheiden mit, was ein Netz kann,
  was ein Handy unterstützt und was erlaubt ist. Diese Quellen sind <b>keine Wettbewerber</b> – sie werden im Bericht in einem eigenen Abschnitt geführt.
  Jeweils der offizielle eigene Kanal des Unternehmens bzw. der Behörde.</p>
  {% for t in tech_themes %}
  <div style="margin-bottom:14px">
    <div style="font-size:13px;font-weight:700;margin-bottom:6px">{{ t.label }} <span style="color:var(--faint2);font-weight:500">· {{ t.sources | length }}</span></div>
    <div class="pill-cloud">
      {% for s in t.sources %}
      <a href="{{ s.url }}" target="_blank" rel="noopener" title="{{ s.url | domain }}">{{ s.name }}</a>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

<div class="card tan" style="margin-top:20px">
  <h2 style="margin:0 0 6px;font-size:17px;font-weight:700;color:#201a16">Telco-Fachpresse <span style="color:#a89c8c;font-weight:500">zweite Ebene · {{ news_sources | length }} Feeds</span></h2>
  <p style="margin:0 0 16px;font-size:13.5px;color:#8a8070;max-width:700px">Ergänzende Signal-Ebene zur Abdeckung bot-geblockter Betreiber – immer als Fachpresse gekennzeichnet, nie als offizielle Quelle.</p>
  <div class="pill-cloud">
    {% for s in news_sources %}
    <a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a>
    {% endfor %}
  </div>
</div>
{% endblock %}
