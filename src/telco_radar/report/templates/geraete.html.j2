{# Geräteseite: eine Frage, eine Rangliste (Neuentwurf 29.09.2026).

   Der Leser wählt Gerät, Speicher, Tarifstufe und Ratenlaufzeit und sieht
   je Anbieter die Kosten über 24 Monate, günstigste zuerst. Keine Reiter,
   keine Erklärtexte. Die Daten kommen aus `geraete_kosten.seite()`; der
   Server rendert die Startauswahl, `app.js` (`grKosten`) jede weitere mit
   derselben Auswahlregel und demselben Markup (Makros unten, JS-Funktionen
   `zeile()` und `ergebnis()`). #}
{% extends "base.html.j2" %}
{% set active = 'geraete' %}
{% block title %}Vodafone Product and Services Insights · Gerätepreise{% endblock %}

{% macro betrag(wert) -%}
{%- set text = wert | euro -%}
<span class="kv-euro">{{ text[:-5] }}</span><span class="kv-cent">{{ text[-5:-2] }}&nbsp;€</span>
{%- endmacro %}

{% macro kv_zeile(z) -%}
{%- set a = z.angebot -%}
<li class="kv-zeile{% if z.erste %} kv-zeile--erste{% endif %}{% if z.sieger %} kv-zeile--sieger{% endif %}{% if z.stil.eigen %} kv-zeile--eigen{% endif %}"
    style="--anb:{{ z.stil.farbe }}" data-anbieter="{{ z.anbieter }}">
  <details class="kv-auf">
    <summary class="kv-kern">
      <span class="kv-anb">{{ z.anbieter }}</span>
      <span class="kv-info"><span class="kv-gb">{{ a.gb }}</span>{% if a.raten %}<span class="kv-raten">{{ a.raten }}&nbsp;Raten</span>{% endif %}{% if a.alt %}<span class="kv-alt">{{ a.alt }}</span>{% endif %}</span>
      <span class="kv-summe">{{ betrag(a.gesamt) }}</span>
      <span class="kv-abstand{% if z.einzig %} kv-abstand--einzig{% endif %}">{% if z.sieger %}günstigste{% elif z.abstand is not none %}+{{ z.abstand | euro }}{% elif z.einzig %}einziges Angebot{% endif %}</span>
      <span class="kv-pfeil" aria-hidden="true"></span>
    </summary>
    <div class="kv-weg">
      <table>
        {%- for p in a.posten %}
        <tr{% if p.offen %} class="kv-weg-offen"{% endif %}><th>{{ p.name }}</th><td class="kv-weg-mal">{{ p.mal }}</td><td>{{ p.betrag | euro }}</td></tr>
        {%- endfor %}
        <tr class="kv-weg-summe"><th>Gesamt</th><td class="kv-weg-mal"></td><td>{{ a.gesamt | euro }}</td></tr>
      </table>
      {%- if a.url %}
      <a class="kv-quelle" href="{{ a.url }}" rel="nofollow noopener" target="_blank">Angebot bei {{ z.anbieter }} ↗</a>
      {%- endif %}
    </div>
  </details>
</li>
{%- endmacro %}

{% macro ergebnis(ansicht, horizont) -%}
{%- set haupt = ansicht.gruppen | selectattr('monate', 'equalto', horizont) | list %}
<section class="kv-gruppe">
  <h2 class="kv-kopfzeile">Kosten über {{ horizont }} Monate</h2>
  {%- for g in haupt %}
  <ol class="kv-liste">
    {%- for z in g.zeilen %}
    {{ kv_zeile(z) }}
    {%- endfor %}
  </ol>
  {%- endfor %}
</section>
{%- if ansicht.anders %}
<p class="kv-anders">
  {%- for x in ansicht.anders %}{% for r in x.raten %}
  <button type="button" class="kv-umschalten" data-raten="{{ 'alle' if r is none else r }}">{{ x.anbieter }} · {% if r is none %}ohne&nbsp;Raten{% else %}{{ r }}&nbsp;Raten{% endif %}&nbsp;→</button>
  {%- endfor %}{% endfor %}
</p>
{%- endif %}
{%- if ansicht.ohne %}
<p class="kv-ohne"><span class="kv-ohne-namen">{{ ansicht.ohne | join(' · ') }}</span><span class="kv-summe">—</span></p>
{%- endif %}
{%- for g in ansicht.gruppen if g.monate != horizont %}
{#- Ein anderer Zeitraum ist mit der Hauptliste nicht vergleichbar: er
    steht zugeklappt ganz unten, ohne Betrag im Blick. #}
<details class="kv-gruppe kv-gruppe--neben">
  <summary class="kv-neben-kopf"><h2 class="kv-kopfzeile">Kosten über {{ g.monate }} Monate</h2><span class="kv-neben-namen">{{ g.zeilen | map(attribute='anbieter') | join(' · ') }}</span><span class="kv-pfeil" aria-hidden="true"></span></summary>
  <ol class="kv-liste">
    {%- for z in g.zeilen %}
    {{ kv_zeile(z) }}
    {%- endfor %}
  </ol>
</details>
{%- endfor %}
{%- endmacro %}

{% macro chips(name, label, eintraege) -%}
<div class="kv-reihe" role="radiogroup" aria-label="{{ label }}" data-wahl="{{ name }}">
  <span class="kv-reihe-name">{{ label }}</span>
  <div class="kv-chips">
    {%- for e in eintraege %}
    <button type="button" role="radio" class="kv-chip" data-wert="{{ e.wert }}"
      aria-checked="{{ 'true' if e.an else 'false' }}"{% if e.aus %} data-aus{% if not e.an %} disabled{% endif %}{% endif %}>{{ e.text }}{% if e.zusatz %}<small>{{ e.zusatz }}</small>{% endif %}</button>
    {%- endfor %}
  </div>
</div>
{%- endmacro %}

{% block content %}
{% set kv = geraete.kosten %}
<section class="kv wide" id="kosten">
{% if kv.hat_daten and kv.ansicht %}
  <header class="kv-kopf">
    <h1 class="kv-titel" id="kv-titel">{{ kv.ansicht.titel }} <span>{{ kv.ansicht.speicher }}</span></h1>
  </header>
  {% if geraete.fehler %}<p class="kv-nichts">{{ geraete.fehler }}</p>{% endif %}

  <div class="kv-wahl" id="kv-wahl">
    <label class="kv-reihe kv-reihe--liste">
      <span class="kv-reihe-name">Gerät</span>
      <select id="kv-geraet">
        {%- for f in kv.ansicht.auswahl %}
        <option value="{{ f.id }}"{% if f.id == kv.start.familie %} selected{% endif %}>{{ f.name }}</option>
        {%- endfor %}
      </select>
    </label>
    {%- for r in kv.ansicht.reihen %}
    {{ chips(r.name, r.label, r.chips) }}
    {%- endfor %}
  </div>

  <div class="kv-ergebnis" id="kv-ergebnis">{{ ergebnis(kv.ansicht, kv.horizont) }}</div>

  <script type="application/json" id="kv-daten">{{ kv.json | safe }}</script>
{% else %}
  <header class="kv-kopf"><h1 class="kv-titel">Gerätepreise</h1></header>
  <p class="kv-nichts">{{ geraete.fehler or kv.grund or 'Keine Gerätepreise.' }}</p>
{% endif %}

  <footer class="kv-fuss">
    <a href="geraete-quellen.html">Quellen</a>
    {% if geraete.export and geraete.export.tco.datei %}<a href="{{ geraete.export.tco.datei }}" download>Export</a>{% endif %}
  </footer>
</section>
{% endblock %}
