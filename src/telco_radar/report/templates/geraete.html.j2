  <details class="gr-auf gr-tafel-details" id="gr-details">
    <summary>Details</summary>

    {# --- Die Preis-Alarme als Chips (H4) --------------------------------
           SIE STEHEN VOR DEM MODELLGATTER-INHALT und nicht darin: die
           Alarme haengen an den Barpreisen, nicht an den Buendeln. #}
    <ul class="gr-chips" aria-label="Preis-Alarme">
      {% for k in geraete.alarme.kacheln %}
