{# Geraete- und Preisradar.

   Drei Fragen, die heute niemand automatisiert beantwortet: was die
   Wettbewerber ueberhaupt fuehren, wo ein Geraet im Preis steht, und wie
   lange es im Markt lebt.

   Die Positionskarte ist ein gerechnetes SVG, keine Bibliothek - dieselbe
   Bauform wie die Tarif-Positionskarte. Beide Ansichten (Spalten =
   Hersteller / Spalten = Anbieter) stehen fertig im Datensatz; der
   Umschalter blendet um, er laedt nicht neu.

   Die Vollstaendigkeitsangabe steht OBEN. Eine Preiskarte mit vier von
   dreiundzwanzig Anbietern ist keine Marktuebersicht und darf nicht so
   aussehen. #}
{% extends "base.html.j2" %}
{% set active = 'geraete' %}
{% block title %}Vodafone Product and Services Insights · Geräte und Preise{% endblock %}

{# Eine Zeichenflaeche. Die Geometrie steht als data-Attribut am Container,
   damit Abnahme und Tests sie LESEN statt sie nachzurechnen: `pruefe_portal`
   hatte die Nulllinie als `540 - 70` hartcodiert, und sobald die Hoehe mit
   der Zahl der Eintraege waechst, misst so eine Zahl am falschen Ort.

   Der Formschalter benutzt bewusst eine ANDERE Klasse als der
   Ansichtsschalter (`gr-flaeche--aus` statt `gr-ansicht--aus`) - sonst
   zaehlte `test_beide_ansichten_stehen_fertig_im_html` vier ausgeblendete
   Ansichten statt einer und fiele aus dem falschen Grund. #}
{% macro flaeche(k, aktiv) %}
<div class="gr-flaeche{% if not aktiv %} gr-flaeche--aus{% endif %}"
     data-form="{{ k.form }}" data-vertrag="{{ k.preisart }}"
     data-hoehe="{{ k.hoehe }}" data-achse="{{ k.achse_y }}"
     data-plot-h="{{ k.plot_h }}" data-ymax="{{ k.y_max }}"
     data-punkte="{{ k.punkte | length }}"
     data-etiketten-verborgen="{{ k.etiketten_verborgen }}">
  <svg class="gr-svg" viewBox="0 0 {{ k.breite }} {{ k.hoehe }}"
       role="img" aria-label="Preis-Positionskarte, Spalten nach {{ k.achsname }}">
    {% for t in k.y_ticks %}
    <line x1="{{ k.rand_l }}" y1="{{ t.y }}" x2="{{ k.breite - k.rand_r }}"
          y2="{{ t.y }}" class="gr-raster"/>
    <text x="{{ k.rand_l - 8 }}" y="{{ t.y + 4 }}" class="gr-tick"
          text-anchor="end">{{ t.wert }} €</text>
    {% endfor %}
    {% for s in k.spalten %}
    {% if not loop.first %}
    <line x1="{{ s.x0 }}" y1="{{ k.rand_o }}" x2="{{ s.x0 }}"
          y2="{{ k.achse_y }}" class="gr-spaltenlinie"/>
    {% endif %}
    {# Direkt unter die Achse. Tiefer gesetzt lief der Spaltenname in den
       Achsenhinweis am unteren Rand - bei der Bandform steht dort ausserdem
       der gedrehte Modellname. #}
    <text x="{{ s.x }}" y="{{ k.achse_y + 16 }}"
          class="gr-spaltenname" text-anchor="middle">{{ s.label }}</text>
    {% endfor %}
    <line x1="{{ k.rand_l }}" y1="{{ k.achse_y }}"
          x2="{{ k.breite - k.rand_r }}" y2="{{ k.achse_y }}" class="gr-achse"/>
    <line x1="{{ k.rand_l }}" y1="{{ k.rand_o }}" x2="{{ k.rand_l }}"
          y2="{{ k.achse_y }}" class="gr-achse"/>

    {# Die Baender der Variante A. Sie liegen VOR den Punkten, damit die
       Querstriche darauf sichtbar bleiben.

       Die PREISZAHLEN stehen bewusst NICHT hier, sondern im jeweiligen
       `.gr-punkt`. Als eigene Knoten neben dem Band waeren sie weder vom
       Filter noch von Kriterium 11 erfasst: ein Filter auf "256 GB" haette
       die Kreise der anderen Groessen ausgeblendet und ihre Preiszahlen
       stehen lassen. #}
    {% for b in k.baender %}
    <g class="gr-band{% if b.eigen %} gr-band--eigen{% endif %}"
       data-band="{{ b.schluessel }}">
      {% if not b.entartet %}
      <line x1="{{ b.x }}" y1="{{ b.y_oben }}" x2="{{ b.x }}" y2="{{ b.y_unten }}"
            class="gr-bandlinie"/>
      {% endif %}
      {# Der Modellname steht UNTER der Achse und traegt deshalb keine
         Preisaussage - deswegen `gr-bandname` und nicht `gr-etikett`. #}
      <text x="{{ b.name_x }}" y="{{ b.name_y }}" class="gr-bandname"
            text-anchor="end"
            transform="rotate(-90 {{ b.name_x }} {{ b.name_y }})">{{ b.name_kurz }}</text>
    </g>
    {% endfor %}

    {% for p in k.punkte %}
    <g class="gr-punkt{% if p.eigen %} gr-punkt--eigen{% endif %}"
       data-segment="{{ p.segment }}" data-speicher="{{ p.speicher or '' }}"
       data-aktuell="{{ '1' if p.aktuelle_generation else '0' }}"
       data-modell="{{ p.modell }}" data-anbieter="{{ p.anbieter_anzeige }}"
       data-anbieter-key="{{ p.anbieter }}"
       data-preis="{{ '%.2f'|format(p.preis) }}" data-preisart="{{ p.preisart }}"
       data-farben="{{ p.farben }}" data-farben-liste="{{ p.farben_liste | join(', ') }}"
       data-varianten="{{ p.varianten }}"
       data-url="{{ p.url }}" data-stand="{{ p.abgerufen_am }}"
       data-speicher-text="{{ p.speicher or '' }}"
       {% if p.band %}data-band="{{ p.band }}"{% endif %}
       tabindex="0" role="button">
      {% if p.chip %}
      <rect x="{{ p.chip.x }}" y="{{ p.chip.y }}" width="{{ p.chip.w }}"
            height="{{ p.chip.h }}" rx="2" class="gr-chip"/>
      {% endif %}
      {% if p.strich_x1 is defined %}
      <line x1="{{ p.strich_x1 }}" y1="{{ p.cy }}" x2="{{ p.strich_x2 }}"
            y2="{{ p.cy }}" class="gr-stufe"/>
      {% endif %}
      <circle cx="{{ p.cx }}" cy="{{ p.cy }}" r="{{ p.r }}"/>
      {% if p.beschriftet %}
      <text x="{{ p.label_x }}" y="{{ p.label_y }}" class="gr-etikett"
            text-anchor="{{ p.label_anker }}">{{ p.label_kurz }}</text>
      {% endif %}
      <title>{{ p.titel }}</title>
    </g>
    {% endfor %}
    {# Der Achsenhinweis steht OBEN rechts. Unten stand er bis zum
       11.08.2026 und lief dort in die Spaltenbeschriftung; bei der Bandform
       haette er ausserdem im gedrehten Modellnamen gelegen. Oben ist er
       ausserdem da, wo man ihn liest, bevor man die Grafik deutet - und
       genau das ist der Zweck des Zusatzes "Preise von N Händlern". #}
    <text x="{{ k.breite - k.rand_r }}" y="{{ k.rand_o - 6 }}" class="gr-achsname"
          text-anchor="end">{{ k.achsname }}{% if k.achszusatz %} – {{ k.achszusatz }}{% endif %}</text>
  </svg>
</div>
{% endmacro %}

{% macro ansicht(g, name, aktiv) %}
<div class="gr-ansicht{% if not aktiv %} gr-ansicht--aus{% endif %}"
     id="gr-ansicht-{{ name }}" data-ansicht="{{ name }}">
  {% for form in g.formen %}
  {{ flaeche(g.flaechen[name ~ '_' ~ form], loop.first) }}
  {% endfor %}
</div>
{% endmacro %}

{% block content %}
<section class="page-hero wide">
  <div class="page-hero-row">
    <div>
      <p class="page-kicker">Deutschland · Geräte</p>
      <h1>Was die anderen im Regal haben.</h1>
    </div>
    {% if geraete.stand %}<span class="page-date">Stand {{ geraete.stand | date_de }}</span>{% endif %}
  </div>
  <p class="page-lead">Diese Seite beantwortet drei Fragen: welche Geräte ein
  Wettbewerber überhaupt führt, wo ein Gerät im Preis steht – und wie lange es
  im Markt lebt. Jeder Preis stammt aus den strukturierten Produktdaten des
  Anbieters, trägt seinen Quelllink und sein Abrufdatum. Geschätzte oder
  hochgerechnete Preise gibt es hier nicht.</p>
</section>

{% if geraete.hat_daten %}
{# --- Vollstaendigkeit zuerst. --------------------------------------- #}
<section class="gr-bilanz">
  <h2 class="rubrik">Wie vollständig ist das</h2>
  <div class="t-bilanz-reihe">
    <div class="t-kennzahl"><b>{{ geraete.bilanz.geraete }}</b><span>Geräte beobachtet</span></div>
    <div class="t-kennzahl"><b>{{ geraete.bilanz.skus }}</b><span>Varianten (SKUs)</span></div>
    <div class="t-kennzahl"><b>{{ geraete.bilanz.anbieter }}</b><span>Anbieter mit Daten</span></div>
    <div class="t-kennzahl"><b>{{ geraete.bilanz.preispunkte }}</b><span>Preispunkte in der Historie</span></div>
    {# Eine Zahl groesser null ist IMMER eine Aussage. Weg bleibt die Kachel
       nur, wenn sie null zeigt UND es noch keinen frueheren Lauf gibt -
       "0 ausgelistet" ist dann eine Selbstverstaendlichkeit. #}
    {% if geraete.bilanz.ausgelistet or not geraete.bilanz.ohne_vorlauf %}
    <div class="t-kennzahl"><b>{{ geraete.bilanz.ausgelistet }}</b><span>ausgelistet</span></div>
    {% endif %}
  </div>
  <p class="t-hinweis">{{ geraete.quellenlage.liefernd }} von
  {{ geraete.quellenlage.konfiguriert }} konfigurierten Anbietern liefern
  Daten. Welcher warum nicht, steht auf
  <a href="{{ prefix }}geraete-quellen.html">der Quellenseite</a> – kein
  Anbieter fehlt dort stillschweigend.</p>
</section>

{# --- Die Positionskarte --------------------------------------------- #}
{% if geraete.karte_hersteller.hat_daten %}
<section class="gr-karte" id="positionskarte">
  <h2 class="rubrik">Wo steht welches Gerät im Preis
    <span class="rubrik-zahl">{{ geraete.bilanz.in_der_karte }}</span></h2>
  <p class="gr-erklaer">Ein Punkt ist ein Gerät in einer Speichergröße bei
  einem Anbieter, die Höhe ist sein Preis ohne Vertrag. Farbvarianten stehen
  nicht einzeln in der Grafik – dieselbe Speichergröße kostet in jeder Farbe
  dasselbe. Zwei
  Ansichten: nach Hersteller zeigt, wie ein Portfolio über die Preisachse
  verteilt ist; nach Anbieter zeigt, was dasselbe Gerät bei wem kostet.
  Zuzahlungen aus Tarifbündeln stehen bewusst nicht in dieser Grafik –
  „1 €“ mit Vertrag und „1.199 €“ ohne sind nicht dieselbe Zahl.</p>

  <div class="gr-steuer">
    <div class="gr-schalter" role="group" aria-label="Ansicht">
      <button type="button" class="gr-knopf{% if geraete.standard_ansicht == 'hersteller' %} on{% endif %}"
              data-schalter="ansicht" data-wert="hersteller">Spalten: Hersteller</button>
      <button type="button" class="gr-knopf{% if geraete.standard_ansicht == 'anbieter' %} on{% endif %}"
              data-schalter="ansicht" data-wert="anbieter">Spalten: Anbieter</button>
    </div>
    {# Der Knopfzustand folgt der Reihenfolge in `geraete_karte.FORMEN` -
       fest verdrahtet zeigte er "Punkte" als aktiv, waehrend die Bandform
       gerendert wurde. #}
    <div class="gr-schalter" role="group" aria-label="Darstellung">
      {% for form in geraete.formen %}
      <button type="button" class="gr-knopf{% if loop.first %} on{% endif %}"
              data-schalter="form" data-wert="{{ form }}">{{ 'Preisbänder' if form == 'band' else 'Punkte' }}</button>
      {% endfor %}
    </div>
    <div class="gr-filter">
      <label>Segment
        <select id="gr-segment">
          <option value="">alle</option>
          {% for s in geraete.segmente %}
          <option value="{{ s }}">{{ geraete.segment_label.get(s, s) }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Speicher
        <select id="gr-speicher">
          <option value="">alle</option>
          {% for s in geraete.speicherstufen %}<option value="{{ s }}">{{ s }} GB</option>{% endfor %}
        </select>
      </label>
      <label>Generation
        <select id="gr-generation">
          <option value="">mit Vorgängern</option>
          <option value="1">nur aktuelle Generation</option>
        </select>
      </label>
    </div>
  </div>

  <div class="gr-karte-scroll">
    {{ ansicht(geraete, 'hersteller', geraete.standard_ansicht == 'hersteller') }}
    {{ ansicht(geraete, 'anbieter', geraete.standard_ansicht == 'anbieter') }}
  </div>

  <p class="gr-detail" id="gr-detail" role="status"></p>
  {# Die Zahl der Punkte OHNE Etikett gilt je Flaeche und wird von `app.js`
     beim Umschalten nachgezogen. Hier steht der Stand der Startflaeche -
     eine feste Zahl fuer alle vier waere eine, die fuer keine gilt. #}
  {% set start = geraete.flaechen[geraete.standard_ansicht ~ '_' ~ geraete.formen[0]] %}
  <p class="gr-legende" id="gr-legende">{{ geraete.bilanz.in_der_karte }} Preispunkte
  aus {{ geraete.bilanz.aggregiert_aus }} Listungen von
  {{ geraete.bilanz.geraete }} Geräten bei
  {{ geraete.karte_anbieter.spaltenzahl }} Anbietern, zuletzt abgerufen am
  {{ geraete.abgerufen_bis | date_de }}. Rot markiert die eigenen Angebote.{%
  if start.etiketten_verborgen %} Ohne Etikett bleiben
  {{ start.etiketten_verborgen }} Punkte – dort ist die Spalte voll; der Punkt
  steht auf seinem Preis.{% endif %}</p>

  {# Wer die Grafik auf dem Telefon nicht lesen kann, hat trotzdem Zugriff.
     Aus DERSELBEN Punktliste - eine zweite Aufbereitung wuerde driften. #}
  <details class="evidence gr-tabelle-auf">
    <summary>Dieselben Zahlen als Tabelle</summary>
    <div class="gr-scroll">
      <table class="src-table">
        <thead><tr><th>Gerät</th><th>Speicher</th><th>Anbieter</th>
          <th class="num">Preis</th><th class="num">Farben</th>
          <th>Stand</th><th>Beleg</th></tr></thead>
        <tbody>
          {% for p in geraete.flaechen['hersteller_chip'].punkte %}
          <tr>
            <td>{{ p.modell }}</td><td>{{ p.speicher or '–' }}{% if p.speicher %} GB{% endif %}</td>
            <td>{{ p.anbieter_anzeige }}</td>
            <td class="num">{{ '%.2f'|format(p.preis) }} €</td>
            <td class="num">{{ p.farben }}</td>
            <td>{{ p.abgerufen_am | date_de }}</td>
            <td>{% if p.url %}<a href="{{ p.url }}" rel="noopener">{{ p.url | domain }}</a>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{% endif %}

{# --- Gesamtexport ----------------------------------------------------- #}
{# Die vierte Luecke der internen Loesung: dort gibt es Daten nur je
   Einzelprodukt oder je Marke. Hier steht der ganze Bestand in EINER Datei.
   Zeilenzahl und Groesse stehen NEBEN dem Link - ein leerer Download ist
   der teuerste Weg herauszufinden, dass sich einer nicht lohnt. #}
{% if geraete.export and geraete.export.aktuell.zeilen %}
<section class="gr-export" id="export">
  <h2 class="rubrik">Alles als Tabelle</h2>
  <ul class="gr-export-liste">
    <li>
      <a href="{{ geraete.export.aktuell.datei }}" download>Aktueller Bestand (CSV)</a>
      <span class="gr-export-meta">{{ geraete.export.aktuell.zeilen }} Zeilen ·
        {{ (geraete.export.aktuell.bytes / 1024) | round | int }} KB{%
        if geraete.export.stand %} · Stand {{ geraete.export.stand | date_de }}{% endif %}</span>
      <span class="gr-export-was">Eine Zeile je Listung: Anbieter, Modell,
        Speicher, Farbe, Preis, Preisart, Tarifreferenz, Verfügbarkeit,
        Quelle, Abrufdatum.</span>
    </li>
    <li>
      <a href="{{ geraete.export.historie.datei }}" download>Preishistorie (CSV)</a>
      <span class="gr-export-meta">{{ geraete.export.historie.zeilen }} Zeilen ·
        {{ (geraete.export.historie.bytes / 1024) | round | int }} KB</span>
      <span class="gr-export-was">Eine Zeile je Listung und Messtag. Ein
        unveränderter Preis erzeugt keine neue Zeile – die Kurve ist eine
        Treppe, keine Messreihe.</span>
    </li>
  </ul>
  <p class="gr-export-hinweis">UTF-8 mit BOM, Semikolon als Trenner,
  Dezimalkomma – so öffnet Excel im deutschen Gebietsschema die Datei per
  Doppelklick, ohne Importassistent.</p>
</section>
{% endif %}

{# --- Wer ist guenstiger als Vodafone? (G2) ---------------------------- #}
{# Die woertliche Frage der Fachkollegen. Die interne Loesung zeigt, DASS es #}
{# irgendwo guenstiger ist - nicht, BEI WEM. Genau das steht hier.          #}
{% if geraete.vergleich.hat_daten %}
{% for achse in ['ohne_vertrag', 'mit_vertrag'] %}
{% set v = geraete.vergleich[achse] %}
{% if v.hat_daten %}
<section class="gr-vergleich" id="vergleich-{{ achse|replace('_','-') }}">
  <h2 class="rubrik">Wer ist günstiger als Vodafone?
    <span class="rubrik-zusatz">{{ 'ohne Vertrag' if achse == 'ohne_vertrag'
      else 'Zuzahlung im Tarifbündel' }}</span></h2>

  {% if v.hat_vodafone %}
  <p class="gr-vergleich-lage">
    {{ v.zeilen|length }} {{ 'Gerät' if v.zeilen|length == 1 else 'Geräte' }} im
    Vergleich · bei {{ v.mit_vorteil }} ist ein Wettbewerber günstiger, bei
    {{ v.ohne_vorteil }} nicht{% if v.groesste_differenz %} · größter Abstand
    {{ '%.2f'|format(v.groesste_differenz)|replace('.', ',') }} €{% endif %}.
  </p>

  <div class="gr-vergleich-filter" data-vergleich-filter="{{ achse }}">
    <button type="button" class="gr-filter-knopf is-aktiv" data-typ="alle">alle</button>
    <button type="button" class="gr-filter-knopf" data-typ="netzbetreiber">nur Netzbetreiber</button>
    <button type="button" class="gr-filter-knopf" data-typ="handel">nur Fachhandel</button>
  </div>

  <div class="gr-vergleich-scroll">
  <table class="src-table gr-vergleich-tabelle">
    <thead>
      <tr>
        <th scope="col">Gerät</th>
        <th scope="col" class="gr-eigen-spalte">Vodafone</th>
        <th scope="col">günstigster Wettbewerber</th>
        <th scope="col" class="num">Differenz</th>
        <th scope="col" class="num">darunter</th>
      </tr>
    </thead>
    <tbody>
      {% for z in v.zeilen %}
      <tr class="gr-v-zeile{{ ' gr-v-zeile--ohne' if not z.bester }}"
          data-typen="{{ z.guenstiger|map(attribute='typ')|join(' ') }}">
        <th scope="row" class="gr-v-geraet">
          <span class="szl">{{ z.modell }}</span>
          <span class="gr-v-meta">{% if z.speicher %}{{ z.speicher }} GB{% endif %}{%
            if z.zustand != 'neu' %} · {{ z.zustand }}{% endif %}</span>
        </th>
        <td class="gr-eigen-spalte">
          <a href="{{ z.vodafone.url }}" rel="noopener">{{
            '%.2f'|format(z.vodafone.preis)|replace('.', ',') }} €</a>
          <span class="gr-v-datum">{{ z.vodafone.abgerufen_am|date_de }}</span>
          {% if z.vodafone.tarif %}<span class="gr-v-tarif">{{ z.vodafone.tarif }}</span>{% endif %}
        </td>
        <td>
          {% if z.bester %}
          <span class="gr-v-name">{{ z.bester.laden }}</span>
          <a href="{{ z.bester.url }}" rel="noopener">{{
            '%.2f'|format(z.bester.preis)|replace('.', ',') }} €</a>
          <span class="gr-v-datum">{{ z.bester.abgerufen_am|date_de }}</span>
          {% if z.bester.tarif %}<span class="gr-v-tarif">{{ z.bester.tarif }}</span>{% endif %}
          {% else %}
          <span class="gr-v-keiner">niemand günstiger{% if z.anzahl_verglichen %}
            ({{ z.anzahl_verglichen }} verglichen){% endif %}</span>
          {% endif %}
        </td>
        <td class="num">{% if z.differenz %}−{{
          '%.2f'|format(z.differenz)|replace('.', ',') }} €
          <span class="gr-v-prozent">{{ '%.1f'|format(z.prozent)|replace('.', ',') }} %</span>
          {% else %}–{% endif %}</td>
        <td class="num">{{ z.anzahl_guenstiger or '–' }}</td>
      </tr>
      {% if z.guenstiger|length > 1 %}
      <tr class="gr-v-alle">
        <td colspan="5">
          <details>
            <summary>alle {{ z.guenstiger|length }} unter Vodafone</summary>
            <ul class="gr-v-liste">
              {% for a in z.guenstiger %}
              <li><span class="gr-v-name">{{ a.laden }}</span>
                <a href="{{ a.url }}" rel="noopener">{{
                  '%.2f'|format(a.preis)|replace('.', ',') }} €</a>
                <span class="gr-v-prozent">−{{
                  '%.2f'|format(z.vodafone.preis - a.preis)|replace('.', ',') }} €</span>
                <span class="gr-v-datum">{{ a.abgerufen_am|date_de }}</span>
                {% if a.tarif %}<span class="gr-v-tarif">{{ a.tarif }}</span>{% endif %}
              </li>
              {% endfor %}
            </ul>
          </details>
        </td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
  </div>
  {# Ein Filter, der die Tabelle leert, muss sagen warum. Ohne diesen Satz
     steht der Leser vor einer leeren Flaeche und haelt die Seite fuer
     kaputt - gesehen am 29.08.2026 im Browser: "nur Fachhandel" ergab 0 von
     62 Zeilen, weil an diesem Tag nur Netzbetreiber Daten lieferten. #}
  <p class="gr-v-leer" hidden>Zu dieser Auswahl liegt keine Vergleichszeile
    vor – kein Anbieter dieser Art ist bei einem der verglichenen Geräte
    günstiger als Vodafone.</p>
  {% endif %}

  {% if v.ohne_vodafone %}
  <div class="gr-vergleich-luecke">
    <h3 class="gr-v-luecke-titel">Bei Wettbewerbern gelistet, bei Vodafone nicht</h3>
    <ul class="gr-v-liste">
      {% for l in v.ohne_vodafone %}
      <li><span class="szl">{{ l.modell }}</span>
        {% if l.speicher %}<span class="gr-v-meta">{{ l.speicher }} GB</span>{% endif %}
        <span class="gr-v-prozent">ab {{
          '%.2f'|format(l.ab_preis)|replace('.', ',') }} €</span>
        <span class="gr-v-datum">{{ l.anzahl }} {{ 'Anbieter' if l.anzahl == 1
          else 'Anbieter' }}</span>
        <a href="{{ l.anbieter[0].url }}" rel="noopener">{{ l.anbieter[0].laden }}</a>
      </li>
      {% endfor %}
    </ul>
    {% if v.ohne_vodafone_gesamt > v.ohne_vodafone|length %}
    <p class="gr-v-meta">{{ v.ohne_vodafone_gesamt }} insgesamt.</p>
    {% endif %}
  </div>
  {% endif %}
</section>
{% endif %}
{% endfor %}
{% endif %}

{# --- Was auffaellt --------------------------------------------------- #}
{% if geraete.auffaellig.hat_daten %}
<section class="gr-auffaellig">
  <h2 class="rubrik">Was diese Woche auffällt
    <span class="rubrik-zusatz">letzte {{ geraete.fenster_tage }} Tage</span></h2>
  <div class="gr-auffaellig-karte">
    <ul class="gr-saetze">
      {% for s in geraete.auffaellig.saetze %}<li class="szl">{{ s }}</li>{% endfor %}
    </ul>
  </div>
  {% if geraete.auffaellig.bewegungen %}
  <div class="gr-scroll">
  <table class="src-table gr-tabelle">
    <thead><tr><th>Gerät</th><th>Anbieter</th><th class="num">vorher</th>
      <th class="num">jetzt</th><th class="num">Δ</th><th>seit</th>
      <th>Beleg</th></tr></thead>
    <tbody>
      {% for b in geraete.auffaellig.bewegungen %}
      <tr>
        <td>{{ b.modell }}</td><td>{{ b.anbieter }}</td>
        <td class="num">{{ '%.2f'|format(b.von) }} €</td>
        <td class="num">{{ '%.2f'|format(b.auf) }} €</td>
        <td class="num gr-delta{{ ' gr-delta--runter' if b.delta < 0 else ' gr-delta--rauf' }}">
          {{ '%+.2f'|format(b.delta) }} €</td>
        <td>{{ b.datum | date_de }}</td>
        <td>{% if b.url %}<a href="{{ b.url }}" rel="noopener">{{ b.url | domain }}</a>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
</section>
{% endif %}

{# --- SKU-Matrix ------------------------------------------------------ #}
<section class="gr-matrix" id="matrix">
  <h2 class="rubrik">Welches Gerät gibt es bei wem
    <span class="rubrik-zahl">{{ geraete.matrix.zeilen | length }}</span></h2>
  <p class="gr-erklaer">Eine Zelle nennt die Zahl der Varianten und die
  Preisspanne. Die Einzelheiten – Speichergrößen, Farben, Verfügbarkeit,
  Quelle und Abrufdatum – stehen im Aufklapper darunter.</p>
  <div class="gr-matrix-scroll">
    <table class="src-table gr-matrix-tabelle">
      <thead>
        <tr><th>Gerät</th>
          {% for a in geraete.matrix.anbieter %}<th>{{ a }}</th>{% endfor %}</tr>
      </thead>
      <tbody>
        {% for z in geraete.matrix.zeilen %}
        <tr>
          <th scope="row" class="gr-modell">{{ z.modell }}
            <span class="gr-hersteller">{{ z.hersteller }}</span></th>
          {% for c in z.zellen %}
          <td class="gr-zelle{{ ' gr-zelle--leer' if c.leer }}">
            {% if c.leer %}<span class="gr-strich">–</span>
            {% else %}
            <b>{{ c.anzahl }}</b>
            {% if c.min is not none %}
            <span class="gr-spanne">{% if c.min == c.max %}{{ '%.0f'|format(c.min) }} €{% else %}{{ '%.0f'|format(c.min) }}–{{ '%.0f'|format(c.max) }} €{% endif %}</span>
            {% elif c.nur_buendel %}<span class="gr-spanne">nur im Bündel</span>
            {% else %}<span class="gr-spanne">ohne Preis</span>{% endif %}
            {% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% for z in geraete.matrix.zeilen %}
  <details class="evidence gr-varianten">
    <summary>{{ z.modell }} – {{ z.anbieter_mit_geraet }} Anbieter</summary>
    <div class="evidence-body">
      {% for c in z.zellen if not c.leer %}
      <p class="gr-variantenzeile"><b>{{ c.anbieter }}</b>
        {% for v in c.varianten %}
        <span class="gr-variante">
          {% if v.speicher %}{{ v.speicher }} GB{% else %}Speicher unbekannt{% endif %}{% if v.farbe %} · {{ v.farbe }}{% endif %}{% if v.zustand != 'neu' %} · {{ v.zustand }}{% endif %} ·
          {% if v.preis is not none %}{{ '%.2f'|format(v.preis) }} €{% elif v.zuzahlung is not none %}{{ '%.2f'|format(v.zuzahlung) }} € mit {{ v.tarif }}{% else %}ohne Preis{% endif %} ·
          {{ v.verfuegbarkeit }}{% if v.url %} · <a href="{{ v.url }}" rel="noopener">Quelle</a>{% endif %}{% if v.abgerufen_am %}, {{ v.abgerufen_am | date_de }}{% endif %}
        </span>
        {% endfor %}
      </p>
      {% endfor %}
    </div>
  </details>
  {% endfor %}
</section>

{# --- Lifecycle ------------------------------------------------------- #}
<section class="gr-lifecycle" id="lifecycle">
  <h2 class="rubrik">Wie lange ein Gerät im Markt lebt</h2>
  <p class="gr-basis{{ ' gr-basis--duenn' if geraete.lifecycle.duenn }}">{{ geraete.lifecycle.hinweis }}</p>

  {% if geraete.lifecycle.portfolio %}
  <h3 class="gr-unter">Wie viele Generationen ein Anbieter gleichzeitig führt</h3>
  <p class="gr-erklaer">Ein Wettbewerber, der das Vorjahresmodell im Regal
  lässt, hat einen Preiseinstieg, ohne den Preis des neuen Geräts anzufassen.
  Gezählt werden Jahrgänge, nicht Varianten: iPhone 17, 17 Pro und 17 Pro Max
  sind ein Jahrgang, acht Farben eines Modells sind ein Regalplatz. Die
  zweite Zahl nennt die Modelle dahinter.</p>
  <ul class="dz-balken gr-tiefe">
    {% set tiefstes = geraete.lifecycle.portfolio[0].generationen or 1 %}
    {% for t in geraete.lifecycle.portfolio %}
    <li{% if t.anbieter|lower == 'vodafone' %} class="gr-eigen"{% endif %}>
      <span class="dz-balken-name">{{ t.anbieter }}</span>
      <span class="dz-balken-spur"><span class="dz-balken-fuell"
        style="width:{{ (100 * t.generationen / tiefstes) | round | int }}%"></span></span>
      <span class="dz-balken-n">{{ t.generationen }}<span
        class="rubrik-zusatz">{{ t.modelle_anzahl }} Modelle</span></span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if geraete.lifecycle.dauern %}
  <h3 class="gr-unter">Verweildauer im Regal</h3>
  <ul class="list-card gr-dauern">
    {% for d in geraete.lifecycle.dauern[:12] %}
    <li class="list-row"><span class="list-row-date">{{ d.tage }} Tage</span>
      {{ d.modell }} bei {{ d.anbieter }}{% if d.status != 'aktiv' %} ({{ d.status }}){% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if geraete.lifecycle.trends %}
  <h3 class="gr-unter">Preisverfall gegenüber dem Einführungspreis</h3>
  <ul class="list-card gr-verfall">
    {% for v in geraete.lifecycle.trends %}
    <li class="list-row"><span class="list-row-date">{{ '%+.1f'|format(v.prozent) }} %</span>
      {{ v.modell }} bei {{ v.anbieter }}: {{ '%.2f'|format(v.erstpreis) }} €
      (seit {{ v.erstpreis_am | date_de }}) auf {{ '%.2f'|format(v.aktuell) }} €
      <span class="gr-klein">{{ 'ohne Vertrag' if v.art == 'ohne_vertrag' else 'Zuzahlung im Bündel' }}</span></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if geraete.lifecycle.nachfolger %}
  <h3 class="gr-unter">Was der Nachfolger mit dem Preis macht</h3>
  <div class="gr-scroll">
  <table class="src-table gr-nachfolger">
    <thead><tr><th>Gerät</th><th>Nachfolger ab</th><th class="num">vorher</th>
      <th class="num">+30 Tage</th><th class="num">+60</th><th class="num">+90</th></tr></thead>
    <tbody>
      {% for n in geraete.lifecycle.nachfolger %}
      <tr><td>{{ n.modell }}</td><td>{{ n.nachfolger_modell }}, {{ n.marktstart | date_de }}</td>
        <td class="num">{{ '%.0f'|format(n.basis) }} €</td>
        {% for tage in [30, 60, 90] %}
        <td class="num">{% if n.nach[tage] %}{{ '%.0f'|format(n.nach[tage]) }} €
          <span class="gr-klein">{{ '%+.1f'|format(n.prozent[tage]) }} %</span>{% else %}–{% endif %}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
</section>
{% else %}
<section class="gr-leer">
  {% if geraete.fehler %}
  <h2 class="rubrik">Diese Seite konnte nicht gebaut werden</h2>
  <p class="empty-note">Die Aufbereitung der Gerätedaten ist gescheitert:
  <code>{{ geraete.fehler }}</code>. Das heißt <em>nicht</em>, dass keine
  Geräte gefunden wurden – es heißt, dass diese Seite gerade nichts über sie
  aussagen kann.</p>
  {% elif not geraete.db_lesbar %}
  {# Eine unlesbare Datei ist NICHT "noch nichts gefunden". Sie sieht nur so
     aus - und genau das ist der Fallstrick aus CLAUDE.md §6. #}
  <h2 class="rubrik">Der Gerätebestand ist nicht lesbar</h2>
  <p class="empty-note"><code>data/state/geraete_db.json</code> ließ sich nicht
  einlesen. Diese Seite zeigt deshalb nichts – das heißt <em>nicht</em>, dass
  keine Geräte gefunden wurden. Der Grund steht im Protokoll des letzten
  Laufs.</p>
  {% else %}
  <h2 class="rubrik">Noch keine Geräte erfasst</h2>
  <p class="empty-note">Der Gerätezweig läuft, hat aber noch keine Listung
  aufgenommen. Welche Anbieter angebunden sind und welche warum nicht, steht
  auf <a href="{{ prefix }}geraete-quellen.html">der Quellenseite</a>.</p>
  {% endif %}
</section>
{% endif %}

{# --- Datenbasis und Luecken ------------------------------------------ #}
<section class="gr-luecken" id="luecken">
  <h2 class="rubrik">Datenbasis und Lücken</h2>
  <p class="gr-erklaer">Was fehlt, ist so wichtig wie was da ist. Eine
  Preiskarte ohne den größten Händler des Landes ist keine Marktübersicht –
  sie sagt es hier, statt es aussehen zu lassen wie Vollständigkeit.</p>

  <ul class="list-card gr-quellenkurz">
    {% for z in geraete.quellenlage.zeilen if not z.liefert %}
    <li class="list-row"><b>{{ z.name }}</b> – {{ z.grund or 'liefert derzeit keine Geräte' }}</li>
    {% endfor %}
  </ul>

  {% if geraete.quellenlage.ohne_hardware %}
  <p class="gr-ruhe">Ohne Hardware-Vermarktung beobachtet:
  {% for z in geraete.quellenlage.ohne_hardware %}{{ z.name }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
  {% endif %}

  {% if geraete.ohne_katalog %}
  <p class="muted-note">{{ geraete.ohne_katalog | length }} Listungen tragen ein
  Gerät, das <code>config/geraete_katalog.yaml</code> nicht (mehr) kennt. Sie
  stehen unter ihrer Kennung statt unter ihrem Modellnamen:
  {{ geraete.ohne_katalog | join(', ') }}.</p>
  {% endif %}

  {% if geraete.katalog.ohne_marktstart %}
  <p class="muted-note">{{ geraete.katalog.ohne_marktstart | length }} von
  {{ geraete.katalog.modelle }} Modellen im Katalog haben kein belegtes
  Marktstartdatum. Für sie gibt es keine Nachfolger-Analyse – ein geratenes
  Datum wäre schlimmer als ein fehlendes.</p>
  {% endif %}

  {% if geraete.farbbericht %}
  <details class="evidence">
    <summary>{{ geraete.farbbericht | length }} unbekannte Farbschreibweisen</summary>
    <div class="evidence-body">
      <p>Diese Schreibweisen kennt <code>config/farben.yaml</code> nicht. Sie
      bleiben erhalten und werden nicht geraten – bis die Tabelle sie kennt,
      zählen zwei Schreibweisen derselben Farbe als zwei Varianten.</p>
      <ul class="pill-cloud">
        {% for f in geraete.farbbericht %}<li>{{ f.schreibweise }} ({{ f.listungen }})</li>{% endfor %}
      </ul>
    </div>
  </details>
  {% endif %}
  <p class="dz-foot">Vollständige Quellenlage:
  <a href="{{ prefix }}geraete-quellen.html">Geräte-Quellen</a>.</p>
</section>
{% endblock %}
