{# Beleg je Preis (geraete_preisbeleg.beleg): Quelle, Messzeit, Rohwerte,
   Rechenweg, Konfigurationsbild, Gegenprobe. Jede Angabe steht da oder als
   benannte Lücke (`gr-t-luecke`), nie leer. Der Rechenweg sind die Summanden aus
   `kosten_ueber`; ihre Summe ist die Zahl der Zeile. Das Bild ist das der
   Gegenprobe (Gerät, Auswahl, Preis); das Messbild des Klick-Laufs steht als
   Zusatz-Link daneben. Das Bild lädt erst beim Aufklappen: `loading=lazy` im
   geschlossenen details, auf der Geräteseite `data-src`, das app.js beim Öffnen
   der Zeile setzt (`bildattr`). #}
{% macro gp_marke(g) %}{% set offen = not g or g.status == 'nicht_gegengeprueft' %}<span class="gr-pb-gp gr-pb-gp--{{ 'offen' if offen else g.status }}">{{
  'nicht gegengeprüft' if offen else ('Gegenprobe ' ~ g.wort) }}</span>{% endmacro %}

{% macro gp_bilanz(g, n) %}{% if g.offen == n %}nicht gegengeprüft{% else %}Gegenprobe: {% for teil in [(g.bestaetigt, 'bestätigt'), (g.teilweise, 'teilweise bestätigt'), (g.abweichend, 'abweichend'), (g.erfassungsluecke, 'Erfassungslücke'), (g.nicht_pruefbar, 'nicht prüfbar'), (g.offen, 'nicht gegengeprüft')] if teil[0] %}{{ teil[0] }} {{ teil[1] }}{% if not loop.last %} · {% endif %}{% endfor %}{% endif %}{% endmacro %}

{% macro bildzeile(b, alt='', bildattr='src') %}{% set k = b.konfig %}{% if k %}<a class="gr-pb-bildlink" href="{{ k.url }}" rel="noopener" target="_blank"><img class="gr-pb-bild" {{ bildattr }}="{{ k.url }}" loading="lazy" alt="Screenshot {{ alt }}, {{ k.art }} vom {{ k.datum }}" width="240" height="150"></a><span class="gr-pb-bildzeile">{{ k.art }} vom {{ k.datum }}{% if k.zeigt %} · zeigt {{ k.zeigt }}{% endif %}</span>{% if k.ohne %}<span class="gr-pb-bildzeile gr-t-luecke">nicht im Bild: {{ k.ohne }}</span>{% endif %}{% if k.nur_preis %}<span class="gr-pb-bildzeile gr-t-luecke">nur Preisbereich (Aufnahme vor dem 22.11.2026)</span>{% endif %}{% else %}<span class="gr-t-luecke gr-pb-ohnebild">{{ b.konfig_fehlt }}</span>{% endif %}{% if b.zusatz %}<a class="gr-pb-zusatz" href="{{ b.zusatz.url }}" rel="noopener" target="_blank">Messbild vom {{ b.zusatz.datum }}</a>{% endif %}{% endmacro %}

{% macro beleg_inhalt(b, alt='', bildattr='src') %}<dl class="gr-pb-daten">
  <dt>Quelle</dt><dd>{% if b.quelle_url %}<a href="{{ b.quelle_url }}" rel="nofollow noopener" target="_blank">{{ b.quelle }}<span class="gr-a-pfeil" aria-hidden="true">↗</span></a>{% else %}<span class="gr-t-luecke">keine Quelle</span>{% endif %}</dd>
  <dt>Gemessen</dt><dd class="gr-pb-messzeit">{{ b.messzeit or b.gelesen_am or '–' }}</dd>
  <dt>Rohwerte</dt><dd class="gr-pb-roh">{% if b.rohwerte %}{% for r in b.rohwerte %}<span class="gr-pb-rohwert">{{ r }}</span>{% if not loop.last %} · {% endif %}{% endfor %}{% else %}<span class="gr-t-luecke">{{ b.rohwerte_fehlt }}</span>{% endif %}{% if b.seite_roh %}<span class="gr-pb-bildzeile">Auf der Seite: {{ b.seite_roh | join(' · ') }}</span>{% endif %}</dd>
  <dt>Rechenweg</dt><dd class="gr-pb-rw">{% if b.rechenweg %}{% for t in b.rechenweg.terme %}<span class="gr-pb-term">{{ t }}</span>{% if not loop.last %} + {% endif %}{% endfor %} = <b class="gr-pb-ergebnis">{{ b.rechenweg.gesamt | euro }}</b>{% else %}<span class="gr-t-luecke">{{ b.rechenweg_fehlt }}</span>{% endif %}</dd>
  <dt>Screenshot</dt><dd class="gr-pb-screenshot">{{ bildzeile(b, alt, bildattr) }}</dd>
  <dt>Gegenprobe</dt><dd>{% set g = b.gegenprobe %}{% if g %}{{ gp_marke(g) }} <span class="gr-pb-zeiten">{% if g.messung %}Messung {{ g.messung }} · {% endif %}Gegenprobe {{ g.datum }}{% if g.uhrzeit %}, {{ g.uhrzeit }}{% endif %}</span>{% for h in g.hinweise %}<span class="gr-pb-hinweis">{{ h }}</span>{% endfor %}{% for a in g.abweichungen %}<span class="gr-pb-abw">{{ a }}</span>{% endfor %}{% for a in g.luecken %}<span class="gr-pb-grund">{{ a }}</span>{% endfor %}{% if g.grund %}<span class="gr-pb-grund">{{ g.grund }}</span>{% endif %}{% if g.nicht_gelesen and g.status == 'bestaetigt' %}<span class="gr-pb-grund">Nicht auf der Seite: {{ g.nicht_gelesen | join(', ') }}</span>{% endif %}{% if b.faellig %}<span class="gr-pb-hinweis">{{ b.faellig }}</span>{% endif %}{% else %}<span class="gr-t-luecke">{{ b.gegenprobe_fehlt }}</span>{% endif %}</dd>
</dl>{% endmacro %}
