{# Meldungen - die Woche als Bildwand (Redesign 09.10.2026).

   Die Prioritaet bestimmt die Groesse: 5 gross, 4 mittel, 3 klein.
   Randnotizen (1-2) stehen als ruhige Liste am Ende. Ein Klick oeffnet
   die Meldung in einer Leseansicht, die von rechts hereingleitet; ohne
   JavaScript fuehrt derselbe Link zur Originalquelle. Jede Meldung hat
   einen festen Anker (`meldung_id`), Links aus Mails oeffnen sie direkt.

   Jede Meldung traegt die Klasse `meldung` - daran haengen die
   Wahrheitstests. #}
{% extends "base.html.j2" %}
{% import "_uebersetzung.html.j2" as ueb %}
{% import "_design.html.j2" as d %}
{% set active = 'meldungen' %}
{% set buehne = true %}
{% block title %}Vodafone Product and Services Insights · Alle Meldungen{% endblock %}

{% macro detail(h) %}
<div class="mw-detail" hidden>
  {% if h.image %}<figure class="lp-bild"><img src="{{ prefix }}images/{{ h.image }}" alt=""
    {% if h.image_w %}width="{{ h.image_w }}" height="{{ h.image_h }}"{% endif %} loading="lazy" decoding="async"></figure>{% endif %}
  <p class="lp-kicker">{{ h.ressort_label }}{% if h.region %} · {{ h.region }}{% endif %}</p>
  <h2 class="lp-titel">{{ h.schlagzeile }}</h2>
  <p class="lp-meta"><span class="punkt punkt--r{{ h.relevance }}" aria-hidden="true"></span>
    <b>{{ h.operator or h.source_label }}</b> · Priorität {{ h.relevance }}/5{% if h.date %} · {{ h.date | date_de }}{% endif %}</p>
  {% if h.summary %}<p class="lp-text">{{ h.summary }}</p>{% endif %}
  {% if h.ctm_satz %}<p class="ctm-satz"><span class="ctm-marke">Was das für uns heißt</span>{{ h.ctm_satz }}</p>{% endif %}
  <p class="lp-aktionen"><a class="knopf knopf--voll" href="{{ h.url }}" target="_blank" rel="noopener">Originalquelle öffnen &nearr;</a>
    <span class="lp-quelle">{{ h.source_label }}</span></p>
  {{ ueb.uebersetzung_link(h, prefix) }}
  {% if h.weitere_quellen %}
  <p class="mz-belege">Auch berichtet von {% for q in h.weitere_quellen %}<a
     href="{{ q.url }}" target="_blank" rel="noopener">{{ q.source }}</a>{{ ", " if not loop.last }}{% endfor %}</p>
  {% endif %}
</div>
{% endmacro %}

{% block buehne %}
{{ d.band('band-meldungen', 'Ausgabe vom ' ~ date_de if date_de else '', 'Meldungen', prefix,
          (highlights|length) ~ ' Meldungen dieser Woche' if highlights else '') }}
{% endblock %}

{% block content %}
{% if redaktion_ausfall %}
<p class="ausfall-hinweis">Stand: {{ redaktion_ausfall.stand_de }} –
  {{ redaktion_ausfall.grund }}. Diese Seite zeigt weiterhin die
  zuletzt vollständig redigierte Ausgabe.</p>
{% endif %}

{% if highlights %}
{% set wand = highlights | selectattr('relevance', 'ge', 3) | list %}
{% set rand = highlights | rejectattr('relevance', 'ge', 3) | list %}
<div class="mw-filter" data-auftritt>
  <div class="chips" role="group" aria-label="Nach Ressort filtern">
    <button type="button" class="chip on" data-filter="ressort" data-wert="" aria-pressed="true">Alle <span class="rubrik-zahl">{{ highlights|length }}</span></button>
    {% for r in ressorts %}
    <button type="button" class="chip" data-filter="ressort" data-wert="{{ r.key }}" aria-pressed="false">{{ r.label }} <span class="rubrik-zahl">{{ r.n }}</span></button>
    {% endfor %}
  </div>
  {% if regions|length > 1 %}
  <div class="chips chips--leise" role="group" aria-label="Nach Region filtern">
    <button type="button" class="chip on" data-filter="region" data-wert="" aria-pressed="true">Alle Regionen</button>
    {% for r in regions %}
    <button type="button" class="chip" data-filter="region" data-wert="{{ r }}" aria-pressed="false">{{ r }} <span class="rubrik-zahl">{{ highlights | selectattr('region', 'equalto', r) | list | length }}</span></button>
    {% endfor %}
  </div>
  {% endif %}
</div>

<div class="bildwand" id="bildwand">
  {% for h in wand %}
  {# Ein kleines Bild steht nie in der grossen Kachel - es waere dort
     hochskaliert (bilder.MIND_BREITE_GROSS). #}
  {% set gr = 'gross' if h.relevance >= 5 else ('mittel' if h.relevance == 4 else 'klein') %}
  {% if gr == 'gross' and h.image and (h.image_w or 0) < MIND_BREITE_GROSS %}{% set gr = 'mittel' %}{% endif %}
  <article class="mw mw--{{ gr }} meldung{% if not h.image %} mw--ohne-bild{% endif %}" id="{{ meldung_id(h) }}"
           data-ressort="{{ h.ressort }}" data-region="{{ h.region }}">
    <a class="mw-link" href="{{ h.url }}" target="_blank" rel="noopener" data-panel>
      {% if h.image %}<span class="mw-bild"><img src="{{ prefix }}images/{{ h.image }}" alt=""
        {% if h.image_w %}width="{{ h.image_w }}" height="{{ h.image_h }}"{% endif %}
        loading="{{ 'eager' if loop.index <= 4 else 'lazy' }}" decoding="async"></span>{% endif %}
      <span class="mw-text">
        <span class="mw-kicker"><span class="punkt punkt--r{{ h.relevance }}" aria-hidden="true"></span>{{ h.operator or h.source_label }}</span>
        <span class="mw-titel szl">{{ h.schlagzeile }}</span>
      </span>
    </a>
    {{ detail(h) }}
  </article>
  {% endfor %}
</div>

{% if rand %}
<section class="randnotizen" data-auftritt>
  <h2 class="abschnitt-titel">Randnotizen</h2>
  <ol class="rn-liste">
    {% for h in rand %}
    <li class="rn meldung" id="{{ meldung_id(h) }}" data-ressort="{{ h.ressort }}" data-region="{{ h.region }}">
      <a class="mw-link rn-link" href="{{ h.url }}" target="_blank" rel="noopener" data-panel>
        <span class="rn-titel szl">{{ h.schlagzeile }}</span>
        <span class="rn-meta">{{ h.operator or h.source_label }} · {{ h.ressort_label }}</span>
      </a>
      {{ detail(h) }}
    </li>
    {% endfor %}
  </ol>
</section>
{% endif %}
<p class="mw-leer" hidden>Keine Meldung passt zu dieser Auswahl.</p>
{% else %}
<p class="empty-note">Für die aktuelle Woche liegen noch keine bewerteten Meldungen vor.</p>
{% endif %}

<section class="archiv" id="archiv" style="scroll-margin-top:96px" data-auftritt>
  <h2 class="abschnitt-titel">Frühere Ausgaben</h2>
  {% if archive %}
  <div class="archiv-reihe">
    {% for e in archive %}
    <a class="archiv-datum" href="{{ prefix }}reports/{{ e.date }}.html">{{ e.date_de }}</a>
    {% endfor %}
  </div>
  {% else %}
  <p class="empty-note">Noch keine Berichte im Archiv.</p>
  {% endif %}
</section>

{# Die Leseansicht: EIN Panel fuer alle Meldungen; app.js setzt den Inhalt
   aus dem verborgenen Detailblock der angeklickten Meldung ein. Der Block
   steht im Dokument, nicht in einem <template>: so ist jede Meldung mit
   Zusammenfassung und Folgerungssatz Teil des Quelltexts. #}
<div class="lesepanel" id="lesepanel" hidden>
  <div class="lesepanel-schleier" data-schliessen></div>
  <aside class="lesepanel-blatt" role="dialog" aria-modal="true" aria-labelledby="lesepanel-titel">
    <button type="button" class="lesepanel-zu" data-schliessen aria-label="Schließen">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <div class="lesepanel-inhalt"></div>
  </aside>
</div>
{% endblock %}
