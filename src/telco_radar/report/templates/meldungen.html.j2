{# Alle Meldungen der Woche - erst die Ressorts als Uebersicht, dann auf
   Klick die Tiefe.

   Bis zum 06.08.2026 standen hier 193 identisch gebaute Bloecke
   untereinander. Das wurde am 06.08. zu einer Zeitungsseite mit Ressorts und
   Gewichtung - besser, aber immer noch 12 249 px hoch: wer wissen wollte, was
   unter "Geld & Uebernahmen" steht, scrollte acht Bildschirmhoehen. Antonio:
   "so muss man auch viel runterscrollen und viel entdecken bei den einzelnen
   Kategorien."

   Jetzt zweistufig, und zwar per <details> statt ueber sieben eigene
   Ressortseiten (Begruendung in outputs/portal-welle2-2026-08-07.md):
   alle 193 Meldungen bleiben in EINER Datei und damit in einem Suchlauf des
   Browsers, es gibt keinen zweiten Ladevorgang, und `render_site()` bleibt
   bei einer Ausgabedatei je Woche.

     RESSORTUEBERSICHT  sieben Kacheln, je Ressort drei Meldungen mit Bild
                        und Schlagzeile. Alle sieben ohne Scrollen sichtbar.
     RESSORTBLOCK       je Ressort ein <details> mit ALLEN Meldungen in drei
                        Gewichtungen (Aufmacher, mittlere, Zeilen).

   Der Filter neben "Alle Meldungen" ist am 07.08.2026 entfernt worden
   (Antonio: "das ist unnoetig") - samt seiner data-such-Attribute und dem
   zugehoerigen Block in app.js. Die wochenuebergreifende Volltextsuche unten
   bleibt, sie beantwortet eine andere Frage.

   Jede Schlagzeile traegt `szl` und jede vollstaendig gelistete Meldung die
   Klasse `meldung` - daran haengen die Wahrheitstests. #}
{% extends "base.html.j2" %}
{% set active = 'meldungen' %}
{% block title %}Vodafone Insights · Alle Meldungen{% endblock %}

{% macro zeile(h) %}
<article class="mz meldung">
  <a href="{{ h.url }}" target="_blank" rel="noopener">
    {% if h.image %}<span class="mz-bild"><img src="{{ prefix }}images/{{ h.image }}" alt=""
       {% if h.image_w %}width="{{ h.image_w }}" height="{{ h.image_h }}"{% endif %} loading="lazy"></span>{% endif %}
    <span class="mz-text">
      <span class="mz-titel szl">{{ h.schlagzeile }}</span>
      <span class="mz-meta"><span class="mz-rel r{{ h.relevance }}">{{ h.relevance }}</span>{{ h.operator or h.source_label }}{% if h.date %} · {{ h.date }}{% endif %}</span>
    </span>
  </a>
</article>
{% endmacro %}

{% block content %}

<div class="meldungen-kopf">
  <p class="page-kicker">Ausgabe vom {{ date_de }}</p>
  <h1>Alle Meldungen</h1>
</div>

{% if ressorts %}
{# Die Uebersicht: sieben Kacheln, keine Sprungleiste. Eine Sprungleiste war
   die Kruecke einer zu langen Seite - sie bewies das Problem, statt es zu
   loesen. #}
<div class="ressort-kacheln">
  {% for r in ressorts %}
  <section class="rkachel">
    <div class="rubrik">
      <h2>{{ r.label }}</h2>
    </div>
    {% for h in r.kachel %}
    <article class="rk-stueck{% if loop.first %} rk-lead{% endif %}{% if not h.image %} ohne-bild{% endif %}">
      <a href="{{ h.url }}" target="_blank" rel="noopener">
        {% if h.image %}<span class="rk-bild"><img src="{{ prefix }}images/{{ h.image }}" alt=""
           {% if h.image_w %}width="{{ h.image_w }}" height="{{ h.image_h }}"{% endif %}
           loading="{{ 'eager' if loop.first else 'lazy' }}"></span>{% endif %}
        <span class="rk-text">
          <span class="rk-titel szl">{{ h.schlagzeile }}</span>
          <span class="rk-meta">{{ h.operator or h.source_label }}</span>
        </span>
      </a>
    </article>
    {% endfor %}
    {# Die EINZIGE Zahl der Kachel. Bis zum 08.08.2026 stand sie zweimal:
       als Chip neben der Rubrik und noch einmal im Link darunter. #}
    <a class="rkachel-alle" href="#ressort-{{ r.key }}" data-oeffnet="ressort-{{ r.key }}">alle {{ r.n }} Meldungen &darr;</a>
  </section>
  {% endfor %}
</div>

{# Die Tiefe. Zugeklappt, aber vollstaendig im Quelltext: keine Meldung
   verschwindet, die Browsersuche findet weiterhin alles, und der Suchindex
   liest ohnehin die Berichtsdatei. #}
<div class="ressort-tiefe">
  {% for r in ressorts %}
  <details class="mressort" id="ressort-{{ r.key }}">
    <summary class="rubrik">
      <h2>{{ r.label }}</h2>
      <span class="rubrik-zahl">{{ r.n }} Meldungen</span>
    </summary>

    <div class="mressort-oben">
      <article class="mlead meldung{% if not r.lead.image %} ohne-bild{% endif %}">
        <a href="{{ r.lead.url }}" target="_blank" rel="noopener">
          {% if r.lead.image %}<span class="mlead-bild"><img src="{{ prefix }}images/{{ r.lead.image }}" alt=""
             {% if r.lead.image_w %}width="{{ r.lead.image_w }}" height="{{ r.lead.image_h }}"{% endif %} loading="lazy"></span>{% endif %}
          <span class="stueck-kicker">{{ r.lead.operator or r.lead.source_label }}{% if r.lead.date %} · {{ r.lead.date }}{% endif %}</span>
          <span class="mlead-titel szl">{{ r.lead.schlagzeile }}</span>
          {% if r.lead.summary %}<span class="mlead-anriss">{{ r.lead.summary }}</span>{% endif %}
        </a>
      </article>
      {% if r.mittel %}
      <div class="mmittel">
        {% for h in r.mittel %}
        <article class="mzwei meldung{% if not h.image %} ohne-bild{% endif %}">
          <a href="{{ h.url }}" target="_blank" rel="noopener">
            {% if h.image %}<span class="mzwei-bild"><img src="{{ prefix }}images/{{ h.image }}" alt=""
               {% if h.image_w %}width="{{ h.image_w }}" height="{{ h.image_h }}"{% endif %} loading="lazy"></span>{% endif %}
            <span class="mzwei-text">
              <span class="mzwei-titel szl">{{ h.schlagzeile }}</span>
              <span class="mz-meta"><span class="mz-rel r{{ h.relevance }}">{{ h.relevance }}</span>{{ h.operator or h.source_label }}</span>
            </span>
          </a>
        </article>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    {% if r.zeilen %}
    <div class="mzeilen">
      {% for h in r.zeilen %}{{ zeile(h) }}{% endfor %}
    </div>
    {% endif %}
  </details>
  {% endfor %}
</div>
{% else %}
<p class="empty-note">Für die aktuelle Woche liegen noch keine bewerteten Meldungen vor.</p>
{% endif %}

<div class="card" id="archiv" style="scroll-margin-top:24px">
  <div class="card-head"><h2>Frühere Ausgaben</h2></div>
  {% if archive %}
  <div class="list-card">
    {% for e in archive %}
    {# Nur die neuen Meldungen. Wie viele insgesamt gesammelt wurden, ist
       eine Frage der Quellenseite - hier stand sie in jeder Zeile daneben
       und liess die Liste wie eine Tabelle aussehen. #}
    <a class="list-row" href="{{ prefix }}reports/{{ e.date }}.html">
      <span class="list-row-date">{{ e.date_de }}</span>
      <span class="list-row-new">{{ e.stats.get('new','–') }} neue Meldungen</span>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <p class="empty-note" style="margin:0">Noch keine Berichte im Archiv.</p>
  {% endif %}
</div>

{# Die wochenuebergreifende Suche steht ganz unten: sie ist der Sonderfall
   ("wo war nochmal die Meldung von vor drei Wochen"), nicht der Normalfall.
   Oben stand sie dem im Weg, der einfach lesen wollte. #}
<div class="card">
  <div class="card-head"><h2>Im Gesamtarchiv suchen</h2></div>
  <div class="meldungen-suche">
    <input type="search" id="suche-input" placeholder="Alle bisherigen Wochen durchsuchen …"
           aria-label="Alle Berichte und die Differenzierung durchsuchen" autocomplete="off">
  </div>
  <div class="suche-filters" role="group" aria-label="Nach Bereich filtern" hidden>
    <button type="button" class="suche-filter on" data-kind="all">Alle</button>
    <button type="button" class="suche-filter" data-kind="bericht">Bericht</button>
    <button type="button" class="suche-filter" data-kind="differenzierung">Differenzierung</button>
  </div>
  <p class="suche-count" id="suche-count"></p>
  <div class="suche-list" id="suche-results"></div>
</div>
{% endblock %}
