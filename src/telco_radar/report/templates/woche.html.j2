{# Die Titelseite der Ausgabe - ein Zeitungsraster mit vier Gewichtsstufen.

   Bis zum 06.08.2026 standen hier zwei Stufen: ein Aufmacher, drei gleich
   grosse Anreisser, dann der Fliesstext. Antonio nach fuenf Runden: "Mir
   gefaellt die Seite immer noch ueberhaupt nicht." Der Grund war nicht die
   Schrift und nicht das Bild, sondern das fehlende RASTER MIT GEWICHTUNG -
   eine Zeitungsseite entsteht daraus, dass eine Geschichte dominiert, zwei
   mittel sind und zwanzig Zeilen sind.

     AUFMACHER      gross, Bild >= 800 px, Vorspann.
     WAS WICHTIG IST  daneben, sieben nummerierte Textzeilen. Ohne diese
                    Spalte stehen oberhalb der Falz nur vier Geschichten.
     ZWEITE REIHE   zwei mittlere Bildgeschichten.
     DRITTE REIHE   vier kleine.
     RESSORTS       je Ressort ein Aufmacher plus vier Zeilen.
     WOCHENBERICHT  vollstaendig, zweispaltig - das Herzstueck (CLAUDE.md
                    §8), aber eine Titelseite fuehrt mit Nachrichten, nicht
                    mit einem Essay.

   Jede Schlagzeile traegt die Klasse `szl`. Daran haengt der Wahrheitstest
   in tests/test_seiten_zahlen.py: keine doppelte Meldung, keine
   abgeschnittene Ueberschrift. Wer eine Schlagzeile ergaenzt und die Klasse
   vergisst, faellt aus beiden Pruefungen heraus.

   Das Datum steht EINMAL, in der Datumszeile des Zeitungskopfs.
   Dieselbe Vorlage rendert die Archivwochen unter reports/<datum>.html. #}
{% extends "base.html.j2" %}
{% set active = 'woche' %}
{% block title %}{% if is_latest %}Vodafone Insights · Ausgabe vom {{ date_de }}{% else %}Vodafone Insights · Archiv {{ report.date if report else '' }}{% endif %}{% endblock %}

{% macro bild(h, klasse, eager=false) %}
{%- if h.image %}<span class="{{ klasse }}"><img src="{{ prefix }}images/{{ h.image }}" alt=""
     {% if h.image_w %}width="{{ h.image_w }}" height="{{ h.image_h }}"{% endif %}
     loading="{{ 'eager' if eager else 'lazy' }}"></span>{% endif -%}
{% endmacro %}

{% block content %}
{% if report %}

{% if not is_latest %}
<p class="archivhinweis">Archivierter Bericht vom {{ date_de }} –
  <a href="{{ prefix }}index.html">zur aktuellen Ausgabe</a></p>
{% endif %}

{# ================================================= OBERHALB DER FALZ ==== #}
<div class="front-oben">
  <div class="front-haupt">

    {% if front.aufmacher %}
    {% set a = front.aufmacher %}
    <article class="aufmacher{% if not a.image %} ohne-bild{% endif %}{% if (a.schlagzeile or '')|length <= 70 %} kurz{% endif %}">
      <p class="page-kicker">{{ a.ressort_label }}{% if a.operator %} · {{ a.operator }}{% endif %}</p>
      <h1 class="szl"><a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.schlagzeile }}</a></h1>
      {% if a.image %}
      <figure class="aufmacher-bild">
        <img src="{{ prefix }}images/{{ a.image }}" alt=""
             {% if a.image_w %}width="{{ a.image_w }}" height="{{ a.image_h }}"{% endif %}
             loading="eager">
        <figcaption>{{ a.operator or a.source_label }} · Bild: {{ a.source_label }}</figcaption>
      </figure>
      {% endif %}
      <div class="aufmacher-text">
        {% if a.vorspann %}<p class="aufmacher-vorspann">{{ a.vorspann }}</p>{% endif %}
        <p class="aufmacher-meta">
          <b>{{ a.operator or a.source_label }}</b>
          <span class="rel-badge r{{ a.relevance }}">Priorität {{ a.relevance }}/5</span>
          <a href="{{ a.url }}" target="_blank" rel="noopener">Originalquelle öffnen &nearr;</a>
        </p>
      </div>
    </article>
    {% else %}
    <section class="page-hero"><h1 class="szl">Diese Woche keine priorisierte Meldung.</h1></section>
    {% endif %}

    {% if front.zwei %}
    <div class="reihe reihe-zwei">
      {% for h in front.zwei %}
      <article class="stueck stueck-mittel{% if not h.image %} ohne-bild{% endif %}">
        <a href="{{ h.url }}" target="_blank" rel="noopener">
          {{ bild(h, 'stueck-bild') }}
          <span class="stueck-kicker">{{ h.ressort_label }} · {{ h.operator or h.source_label }}</span>
          <span class="stueck-titel szl">{{ h.schlagzeile }}</span>
          {% if h.anriss %}<span class="stueck-anriss">{{ h.anriss }}</span>{% endif %}
        </a>
      </article>
      {% endfor %}
    </div>
    {% endif %}

    {% if front.vier %}
    <div class="reihe reihe-vier">
      {% for h in front.vier %}
      <article class="stueck stueck-klein{% if not h.image %} ohne-bild{% endif %}">
        <a href="{{ h.url }}" target="_blank" rel="noopener">
          {{ bild(h, 'stueck-bild') }}
          <span class="stueck-kicker">{{ h.ressort_label }}</span>
          <span class="stueck-titel szl">{{ h.schlagzeile }}</span>
        </a>
      </article>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  {# Die Textspalte neben dem Aufmacher. Ohne sie stehen oberhalb der Falz
     vier Geschichten; mit ihr elf. Bewusst OHNE Bilder - die gehoeren in
     die Bildpositionen links, nicht in eine Digest-Spalte. #}
  {% if front.wichtig %}
  <aside class="front-wichtig">
    <div class="rubrik"><h2>Was wichtig ist</h2></div>
    <ol class="wichtig-liste">
      {% for h in front.wichtig %}
      <li class="wichtig-zeile">
        <a href="{{ h.url }}" target="_blank" rel="noopener">
          <span class="wichtig-kicker">{{ h.operator or h.source_label }}</span>
          <span class="wichtig-titel szl">{{ h.schlagzeile }}</span>
        </a>
      </li>
      {% endfor %}
    </ol>
    <p class="ex-count">
      {% if show_explorer %}<a href="#alle-meldungen" class="source-link">alle {{ highlights|length }} Meldungen &darr;</a>
      {% else %}<a href="{{ prefix }}meldungen.html" class="source-link">alle {{ highlights|length }} Meldungen &nearr;</a>{% endif %}
    </p>

    {# Der Themenradar steht hier oben, nicht unten neben dem Bericht: die
       Rail neben Aufmacher und den beiden Reihen waere sonst ab der Haelfte
       leer, und Weissraum an dieser Stelle liest sich als Fehler. #}
    {% if dash and dash.tech_radar %}
    <div class="card">
      <div class="card-head"><h2>Themen der Woche</h2></div>
      {% for t in dash.tech_radar[:7] %}
      <div class="bento-bar">
        <div class="bento-bar-top"><b>{{ t.theme }}</b><span>{{ t.n }}</span></div>
        <div class="bento-bar-track"><span class="bento-bar-fill" style="width:{{ t.w }}%"></span></div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </aside>
  {% endif %}
</div>

{# ======================================================= RESSORTS ====== #}
{% if front.ressorts %}
<div class="ressort-raster">
  {% for r in front.ressorts %}
  <section class="ressort">
    <div class="rubrik">
      <h2>{{ r.label }}</h2>
      <a href="{{ prefix }}meldungen.html#ressort-{{ r.key }}">alle {{ r.n }}</a>
    </div>
    <article class="ressort-lead{% if not r.lead.image %} ohne-bild{% endif %}">
      <a href="{{ r.lead.url }}" target="_blank" rel="noopener">
        {{ bild(r.lead, 'ressort-lead-bild') }}
        <span class="stueck-kicker">{{ r.lead.operator or r.lead.source_label }}</span>
        <span class="ressort-lead-titel szl">{{ r.lead.schlagzeile }}</span>
        {% if r.lead.anriss %}<span class="stueck-anriss">{{ r.lead.anriss }}</span>{% endif %}
      </a>
    </article>
    {% if r.zeilen %}
    <ul class="ressort-zeilen">
      {% for h in r.zeilen %}
      <li><a href="{{ h.url }}" target="_blank" rel="noopener">
        <span class="ressort-zeile-titel szl">{{ h.schlagzeile }}</span>
        <span class="ressort-zeile-meta">{{ h.operator or h.source_label }}</span>
      </a></li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endfor %}
</div>
{% endif %}

{# ================================================== DER WOCHENBERICHT == #}
<div class="frontpage">
  <div class="frontpage-main">
    {% if briefing_html %}
    <div class="card">
      <div class="card-head"><h2>Der Wochenbericht</h2>
        <a href="{{ prefix }}transparenz.html">Quellen</a></div>
      <p class="berichtszeile">
        {% if report.stats %}{{ report.stats.get('new', '–') }} neue Meldungen gelesen,
        <b>{{ highlights|length }} davon relevant</b>.{% endif %}
        {% if lesezeit %}Lesezeit etwa {{ lesezeit }} Minuten.{% endif %}
      </p>
      {% if toc %}
      <nav class="toc" aria-label="Abschnitte des Berichts">
        {% for s in toc %}<a href="#{{ s.id }}">{{ s.title }}</a>{% endfor %}
      </nav>
      {% endif %}
      <article class="prose prose-zwei">{{ briefing_html | safe }}</article>
    </div>
    {% endif %}
  </div>

  <aside class="frontpage-rail">
    {% if dash and dash.kpis %}
    <div class="rubrik"><h2>Zahlen der Woche</h2></div>
    <div class="tile-grid">
      {% for k in dash.kpis %}
      <div class="tile{% if k.accent %} accent{% elif k.tint %} tint{% endif %}">
        <b{% if k.text %} class="txt"{% endif %}>{{ k.num }}</b><span>{{ k.label }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </aside>
</div>

{# Deutschland-Fokus: was frueher als eigene Seite "Wettbewerber im Detail"
   lief. Die Ueberschrift dort versprach eine Analyse aller beobachteten
   Betreiber; konfiguriert sind drei deutsche Anbieter (focus_competitors). #}
<section id="deutschland-fokus" style="scroll-margin-top:24px">
{% if competitors and competitors|selectattr('summary')|list %}
<div class="card">
  <div class="card-head"><h2>Deutschland-Fokus</h2></div>
  <p class="card-sub">Die drei Anbieter, gegen die Vodafone Deutschland direkt antritt</p>
  <div class="comp-list">
    {% for c in competitors %}
    {% if c.summary or c.moves %}
    <article class="comp-card">
      <div class="comp-card-head">
        <h2>{{ c.name }}</h2>
        <div class="comp-badges">
          <span class="comp-badge">{{ c.n_items }} Meldungen</span>
          <span class="comp-badge accent">{{ c.moves|length }} relevante Moves</span>
        </div>
      </div>
      {% if c.summary %}<p class="comp-summary">{{ c.summary }}</p>{% endif %}
      {% if c.themes %}<div class="comp-tags">{% for t in c.themes %}<span class="comp-tag">{{ t }}</span>{% endfor %}</div>{% endif %}
      {% if c.moves %}
      <p class="comp-moves-title">Aktuelle Moves</p>
      <div class="comp-items">
        {% for m in c.moves %}
        <div class="comp-item">
          <div class="comp-item-cat">{{ m.category }}</div>
          <a href="{{ m.url }}" target="_blank" rel="noopener">{{ m.title }}</a>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </article>
    {% endif %}
    {% endfor %}
  </div>
  {% set gescheitert = competitors|selectattr('error')|rejectattr('summary')|list %}
  {% if gescheitert %}
  {# Ein Teilausfall darf nicht aussehen wie ein kleineres Wettbewerbsfeld. #}
  <p class="muted-note" style="margin-top:14px">
    Für {{ gescheitert|map(attribute='name')|join(' und ') }}
    hat die Auswertung dieses Laufs keine Antwort geliefert
    ({{ gescheitert|length }} von {{ competitors|length }} Profilen).
    Der Fehler steht im Laufprotokoll unter
    <a href="{{ prefix }}transparenz.html">Quellen</a>.
  </p>
  {% endif %}
</div>
{% elif competitors and competitors|selectattr('error')|list %}
{# Ein gescheiterter Lauf darf nicht aussehen wie ein Lauf, der noch aussteht. #}
<div class="card">
  <div class="card-head"><h2>Deutschland-Fokus</h2></div>
  <p class="empty-note">
    <b>Die Auswertung dieses Laufs ist gescheitert.</b>
    Die Meldungen wurden gesammelt und zugeordnet
    ({{ competitors|sum(attribute='n_items') }} Treffer), aber die Analyse
    hat keine Antwort geliefert. Der Fehler steht im Laufprotokoll unter
    <a href="{{ prefix }}transparenz.html">Transparenz</a>.
  </p>
</div>
{% endif %}
</section>

{% if report.run and report.run.analysts %}
<div class="card">
  <div class="card-head"><h2>Auswertung je Bereich</h2>
    <a href="{{ prefix }}transparenz.html">Laufprotokoll</a></div>
  <div class="rowtable">
    <div class="rowtable-head">
      <span class="col-region">Bereich</span><span class="col-flex">gelesen</span>
      <span class="col-kept">relevant</span><span class="col-model">Modell</span>
    </div>
    {% for a in report.run.analysts %}
    <div class="rowtable-row">
      <span class="col-region">{{ a.region }}</span>
      <span class="col-flex">{{ a.items_in }}</span>
      <span class="col-kept">{{ a.highlights }}</span>
      <span class="col-model">{{ a.model }}</span>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

{% if show_explorer and highlights %}
<details class="evidence" id="alle-meldungen">
  <summary><span>Alle {{ highlights | length }} Meldungen dieser Woche</span><small>bei Bedarf öffnen</small></summary>
  <div class="evidence-body">
    {% include "_explorer.html.j2" %}
  </div>
</details>
{% endif %}

{% else %}
<section class="page-hero"><p class="page-kicker">Marktrecherche</p><h1>Noch kein Bericht</h1>
<p class="page-lead">Sobald der erste Lauf durchgelaufen ist, steht hier die Ausgabe.</p></section>
{% endif %}
{% endblock %}
