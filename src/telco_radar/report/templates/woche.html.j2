{# Diese Woche - die Startseite im Kinoformat (Redesign 09.10.2026).

   ERSTER BILDSCHIRM  Der Campus in der Stimmung der Tageszeit, gross das
                      Datum der Ausgabe, darunter drei Fenster: die
                      Meldung der Woche, wo Vodafone bei den Geraeten
                      steht, die auffaelligste Promo.
   DARUNTER           Der Wochenbericht als Folge von Szenen: jedes
                      Kapitel beginnt mit seinem Bild ueber den ganzen
                      Bildschirm, beim Weiterscrollen gibt das Bild die
                      rechte Haelfte frei und der Text erscheint Absatz
                      fuer Absatz. Reihenfolge: `startseite.szenen()`.

   Dieselbe Vorlage rendert die Archivwochen unter reports/<datum>.html -
   dort ohne Fenster (die Geraete- und Promozahlen sind die von heute,
   nicht die der Archivwoche) und mit dem Explorer aller Meldungen. #}
{% extends "base.html.j2" %}
{% import "_uebersetzung.html.j2" as ueb %}
{% import "_design.html.j2" as d %}
{% set active = 'woche' %}
{% set buehne = report is not none %}
{% set wrap_class = 'voll' %}
{% block title %}{% if is_latest %}Vodafone Product and Services Insights · Ausgabe vom {{ date_de }}{% else %}Vodafone Product and Services Insights · Archiv {{ report.date if report else '' }}{% endif %}{% endblock %}

{% block buehne %}
{% if report %}
{% set teile = (date_de or '').rsplit(' ', 1) %}
<section class="buehne" aria-label="Ausgabe vom {{ date_de }}">
  {# Vier Stimmungen desselben Bildes. app.js waehlt nach der Uhrzeit des
     Lesers EINE davon und laedt nur diese; ohne JavaScript steht der Tag. #}
  <div class="buehne-bild" aria-hidden="true">
    {% for z in ('morgen', 'tag', 'abend', 'nacht') %}
    {% if ('campus-' ~ z) in bilder %}
    <img class="buehne-ebene" data-zeit-bild="{{ z }}" data-src="{{ prefix }}static/bilder/campus-{{ z }}.jpg" alt="" width="2400" height="1357" decoding="async">
    {% endif %}
    {% endfor %}
    {% if 'campus-tag' in bilder %}<noscript><img class="buehne-ebene geladen" src="{{ prefix }}static/bilder/campus-tag.jpg" alt=""></noscript>{% endif %}
  </div>
  <div class="buehne-inhalt">
    <div class="buehne-kopf">
      <p class="buehne-gruss" data-gruss>{% if is_latest %}Ausgabe{% else %}Archiv{% endif %}</p>
      <h1 class="buehne-datum">{{ teile[0] }}<span class="buehne-jahr"> {{ teile[1] if teile|length > 1 else '' }}</span></h1>
      {# Ein Halbsatz mit zwei Zahlen: relevant behalten und neu gelesen. Bei
         einer uebernommenen Ausgabe faellt "aus N neuen" weg - das waere die
         Zahl der HEUTIGEN Runde neben Meldungen einer frueheren. #}
      <p class="buehne-unter">{% if report and report.stats %}<b>{{ highlights|length }} relevante Meldungen</b>
        {% if not redaktion_ausfall %}aus {{ report.stats.get('new', '–') }} neuen{% endif -%}
        {% else %}{{ highlights|length }} Meldungen{% endif %}{% if lesezeit %} · Lesezeit ca. {{ lesezeit }} Minuten{% endif %}</p>
      {% if redaktion_ausfall %}
      <p class="ausfall-hinweis buehne-hinweis">Stand: {{ redaktion_ausfall.stand_de }} –
        die Runde vom {{ date_de }} blieb ohne Bewertung:
        {{ redaktion_ausfall.grund }}. Diese Seite zeigt weiterhin die
        zuletzt vollständig redigierte Ausgabe.</p>
      {% endif %}
      {% if not is_latest %}
      <p class="archivhinweis buehne-hinweis">Archivierter Bericht vom {{ date_de }} –
        <a href="{{ prefix }}index.html">zur aktuellen Ausgabe</a></p>
      {% endif %}
      {% if is_latest and themen %}
      <nav class="fokusband fokusband--oben" aria-label="Laufende Themen">
        {% for t in themen %}
        <a href="{{ prefix }}thema/{{ t.slug }}.html">
          <span class="fokusband-kicker">Im Fokus</span>
          <span class="fokusband-titel">{{ t.titel }}</span>
          <span class="fokusband-zahl">{{ t.n }} Meldungen &nearr;</span>
        </a>
        {% endfor %}
      </nav>
      {% endif %}
    </div>

    {% if is_latest and fenster %}
    <div class="fenster-reihe">
      {% set m = fenster.meldung %}
      {% if m %}
      {% set h = m.h %}
      <a class="fenster fenster--meldung" href="{{ prefix }}meldungen.html">
        <span class="fenster-kopf"><span class="fenster-art">Meldung der Woche</span>
          <span class="fenster-zahl">{{ m.anzahl }} Meldungen</span></span>
        <span class="fenster-koerper">
          {% if h.image %}<span class="fenster-bild"><img src="{{ prefix }}images/{{ h.image }}" alt=""
            {% if h.image_w %}width="{{ h.image_w }}" height="{{ h.image_h }}"{% endif %} loading="eager" decoding="async"></span>{% endif %}
          <span class="fenster-titel szl">{{ h.schlagzeile }}</span>
        </span>
        {% if h.ctm_satz %}<span class="ctm-satz fenster-ctm"><span class="ctm-marke">Was das für uns heißt</span>{{ h.ctm_satz }}</span>{% endif %}
        <span class="fenster-fuss"><span class="punkt punkt--r{{ h.relevance }}" aria-hidden="true"></span>{{ h.operator or h.source_label }} · Priorität {{ h.relevance }}/5</span>
      </a>
      {% endif %}
      {% set g = fenster.geraete %}
      {% if g %}
      <a class="fenster fenster--geraete" href="{{ prefix }}geraete.html">
        <span class="fenster-kopf"><span class="fenster-art">Wo steht Vodafone?</span>
          <span class="fenster-zahl">{{ g.modell }}</span></span>
        <span class="fenster-koerper">
          {% if g.leitzahl_html %}<span class="fenster-leit">{{ g.leitzahl_html | safe }}</span>
          {% else %}<span class="fenster-satz">{{ g.antwort_html | safe }}</span>{% endif %}
        </span>
        <span class="fenster-fuss">Band {{ g.band }} · {{ g.laufzeit }} Raten{% if g.stand %} · Preise vom {{ g.stand | date_de }}{% endif %}</span>
      </a>
      {% endif %}
      {% set p = fenster.promo %}
      {% if p %}
      {% set k = p.karte %}
      <a class="fenster fenster--promo" href="{{ prefix }}promo/index.html">
        <span class="fenster-kopf"><span class="fenster-art">Promo</span>
          <span class="fenster-zahl">{% if p.neu %}{{ p.neu }} neu{% elif p.aktiv %}{{ p.aktiv }} Aktionen aktiv{% endif %}{% if p.endet_bald %} · {{ p.endet_bald }} enden bald{% endif %}</span></span>
        <span class="fenster-koerper">
          <span class="fenster-gross">{{ k.kachel }}</span>
          <span class="fenster-titel fenster-titel--klein"><b>{{ k.brand.name }}</b> {{ k.offer.headline }}</span>
        </span>
        <span class="fenster-fuss">Stand {{ p.stand | date_de }}</span>
      </a>
      {% endif %}
    </div>
    {% endif %}
    <a class="buehne-weiter" href="#der-wochenbericht">Der Wochenbericht<span aria-hidden="true">↓</span></a>
  </div>
  {# Die langsame Bildbewegung laesst sich anhalten (WCAG 2.2.2). #}
  <button type="button" class="buehne-pause" aria-pressed="false" aria-label="Bildbewegung anhalten" hidden>
    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="3" y="2" width="3.4" height="12" rx="1" fill="currentColor"/><rect x="9.6" y="2" width="3.4" height="12" rx="1" fill="currentColor"/></svg>
  </button>
</section>
{% endif %}
{% endblock %}

{% block content %}
{% if report %}
{% set hat_land = competitors and competitors|selectattr('summary')|list %}
{% set land_gescheitert = competitors and competitors|selectattr('error')|list %}
{% set warten = is_latest and fruehwarnung and fruehwarnung.aktiv %}
{% set folge = szenen(kapitel or [],
     themen=(dash is not none and dash.tech_radar|length > 0),
     deutschland=(hat_land or land_gescheitert)|length > 0,
     warten=warten|default(false, true),
     zwei_minuten=(zwei_minuten|length > 0)) %}

<div class="bericht" id="der-wochenbericht" style="scroll-margin-top:0">
  {% if folge %}
  {# Am Rand steht nur das aktuelle Kapitel; die Liste klappt erst beim
     Ueberfahren auf. Keine Fortschrittsleiste. #}
  <nav class="kapitel-marke" aria-label="Kapitel des Berichts">
    <button type="button" class="kapitel-aktuell" aria-expanded="false"><span data-kapitel-name>{{ folge[0].titel }}</span></button>
    <ol class="kapitel-liste">
      {% for s in folge %}<li><a href="#{{ s.id }}">{{ s.titel }}</a></li>{% endfor %}
    </ol>
  </nav>
  {% endif %}
  {# Zweiter "Stand:"-Hinweis: wer per Sprungmarke direkt in den Bericht
     kommt, soll das Alter des Textes nicht erst oben auf der Buehne lesen
     muessen. #}
  {% if redaktion_ausfall %}
  <p class="ausfall-hinweis bericht-stand">Stand: {{ redaktion_ausfall.stand_de }}</p>
  {% endif %}

  {% for s in folge %}
  {% if s.art == 'text' %}
  <section class="szene{% if s.bild not in bilder %} szene--ohne-motiv{% endif %}" id="{{ s.id }}" data-szene="{{ s.titel }}">
    <div class="szene-bild" aria-hidden="true">{{ d.motiv(s.bild, prefix, 'szene-motiv') }}
      <span class="szene-marke">{{ s.titel }}</span></div>
    <h2 class="szene-titel">{{ s.titel }}</h2>
    <div class="szene-text prose">
      {{ s.html | safe }}
      {% if s.wichtig and front.wichtig %}
      <div class="rubrik"><h3>Was wichtig ist</h3></div>
      <ol class="wichtig-liste">
        {% for h in front.wichtig %}
        <li class="wichtig-zeile">
          <a href="{{ h.url }}" target="_blank" rel="noopener">
            <span class="wichtig-kicker">{{ h.operator or h.source_label }}</span>
            <span class="wichtig-titel szl">{{ h.schlagzeile }}</span>
          </a>
          {{ ueb.uebersetzung_link(h, prefix) }}
          {% if h.ctm_satz %}<p class="ctm-satz"><span class="ctm-marke">Was das für uns heißt</span>{{ h.ctm_satz }}</p>{% endif %}
        </li>
        {% endfor %}
      </ol>
      <p class="ex-count">
        {% if show_explorer %}<a href="#alle-meldungen" class="source-link">alle {{ highlights|length }} Meldungen &darr;</a>
        {% else %}<a href="{{ prefix }}meldungen.html" class="source-link">alle {{ highlights|length }} Meldungen &nearr;</a>{% endif %}
      </p>
      {% endif %}
    </div>
  </section>

  {% elif s.art == 'zwei' %}
  <section class="szene szene--blatt" id="{{ s.id }}" data-szene="{{ s.titel }}">
    <h2 class="szene-titel szene-titel--blatt">{{ s.titel }}</h2>
    <div class="szene-text kurzpfad">
      <ol class="kurzpfad-liste">
        {% for h in zwei_minuten %}
        <li class="kurzpfad-zeile">
          <p class="kurzpfad-satz">{{ h.ctm_satz }}<span class="kurzpfad-beleg"><a
            href="{{ h.url }}" target="_blank" rel="noopener">{{ h.operator or h.source_label }} &nearr;</a></span></p>
        </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  {% elif s.art == 'themen' %}
  <section class="szene szene--blatt" id="{{ s.id }}" data-szene="{{ s.titel }}">
    <h2 class="szene-titel szene-titel--blatt">{{ s.titel }}</h2>
    <div class="szene-text themen">
      {% for t in dash.tech_radar[:7] %}
      <div class="bento-bar themen-zeile">
        <div class="bento-bar-top"><b>{{ t.theme }}</b><span class="themen-zahl">{{ t.n }}</span></div>
        <div class="bento-bar-track"><span class="bento-bar-fill" style="width:{{ t.w }}%"></span></div>
      </div>
      {% endfor %}
    </div>
  </section>

  {% elif s.art == 'deutschland' %}
  <section class="szene{% if s.bild not in bilder %} szene--ohne-motiv{% endif %}" id="{{ s.id }}" data-szene="{{ s.titel }}" style="scroll-margin-top:24px">
    <div class="szene-bild" aria-hidden="true">{{ d.motiv(s.bild, prefix, 'szene-motiv') }}
      <span class="szene-marke">{{ s.titel }}</span></div>
    <h2 class="szene-titel">{{ s.titel }}</h2>
    <div class="szene-text">
      {% if hat_land %}
      <ul class="wb-kurz">
        {% for c in competitors %}
        {% if c.satz %}
        <li class="wb-kurz-zeile">
          <a href="{{ prefix }}wettbewerb.html#{{ c.anker }}">
            <span class="wb-kurz-name">{{ c.name }}</span>
            <span class="wb-kurz-satz">{{ c.satz }}</span>
          </a>
        </li>
        {% endif %}
        {% endfor %}
      </ul>
      {% set gescheitert = competitors|selectattr('error')|rejectattr('summary')|list %}
      {% if gescheitert %}
      {# Ein Teilausfall darf nicht aussehen wie ein kleineres Wettbewerbsfeld. #}
      <p class="muted-note">Für {{ gescheitert|map(attribute='name')|join(' und ') }}
        hat die Auswertung dieses Laufs keine Antwort geliefert
        ({{ gescheitert|length }} von {{ competitors|length }} Profilen).
        Der Fehler steht im Laufprotokoll unter
        <a href="{{ prefix }}transparenz.html">Quellen</a>.</p>
      {% endif %}
      {% else %}
      {# Ein gescheiterter Lauf darf nicht aussehen wie ein Lauf, der noch aussteht. #}
      <p class="empty-note"><b>Die Auswertung dieses Laufs ist gescheitert.</b>
        Die Meldungen wurden gesammelt und zugeordnet
        ({{ competitors|sum(attribute='n_items') }} Treffer), aber die Analyse
        hat keine Antwort geliefert. Der Fehler steht im Laufprotokoll unter
        <a href="{{ prefix }}transparenz.html">Quellen</a>.</p>
      {% endif %}
      <p class="szene-weiter"><a href="{{ prefix }}wettbewerb.html">Zur Wettbewerbsseite &rarr;</a></p>
    </div>
  </section>

  {% elif s.art == 'warten' %}
  <section class="szene fwb{% if s.bild not in bilder %} szene--ohne-motiv{% endif %}" id="{{ s.id }}" data-szene="{{ s.titel }}">
    <div class="szene-bild" aria-hidden="true">{{ d.motiv(s.bild, prefix, 'szene-motiv') }}
      <span class="szene-marke">{{ s.titel }}</span></div>
    <h2 class="szene-titel">{{ s.titel }}</h2>
    <div class="szene-text">
      <p class="fwb-stand"><span class="rubrik-zahl">{{ fruehwarnung.n_aktiv }} von {{ fruehwarnung.fragen | length }} in Bewegung</span></p>
      <div class="fwb-gitter">
        {% for f in fruehwarnung.fragen %}
        <details class="fwb-frage fwb-{{ f.zustand }}">
          <summary><span class="fwb-licht" aria-hidden="true"></span><h3 class="fwb-titel">{{ f.frage }}</h3></summary>
          {% if f.warum %}<p class="fwb-warum">{{ f.warum }}</p>{% endif %}
          <ul class="fwb-liste">
            {% for i in f.indikatoren %}
            <li class="fwb-ind fwb-{{ i.zustand }}">
              <span class="fwb-punkt" aria-hidden="true"></span>
              <span class="fwb-name">{{ i.name }}</span>
              <span class="fwb-zustand">{{ i.zustand }}</span>
              {% for b in i.belege %}
              <span class="fwb-beleg"><a href="{{ b.url }}" target="_blank" rel="noopener">{{ b.titel }}</a>
                <i>{{ b.absender }}{% if b.datum %} · {{ b.datum }}{% endif %}</i></span>
              {% endfor %}
            </li>
            {% endfor %}
          </ul>
        </details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
  {% endfor %}

  {% if not folge %}
  <section class="szene szene--blatt"><p class="empty-note">Für diese Ausgabe liegt kein Wochenbericht vor.</p></section>
  {% endif %}

  {% if report.date %}
  <p class="folienlink"><a href="{{ prefix }}folien/{{ report.date }}.html">
    Diese Ausgabe als Foliensatz</a> <span>4 Folien, für den Montagstermin</span></p>
  {% endif %}
</div>

{% if show_explorer and highlights %}
<details class="evidence" id="alle-meldungen">
  <summary><span>Alle {{ highlights | length }} Meldungen dieser Woche</span></summary>
  <div class="evidence-body">
    {% include "_explorer.html.j2" %}
  </div>
</details>
{% endif %}

{% else %}
<section class="page-hero"><p class="page-kicker">Marktrecherche</p><h1>Noch kein Bericht</h1>
<p class="page-lead">Sobald der erste Lauf durchgelaufen ist, steht hier die Ausgabe.</p></section>
{% endif %}
{% endblock %}
