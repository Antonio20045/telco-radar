{# Portfolio gegen Vodafone (Ziel 3). Daten liefert geraete_portfolio.py.

   Antonio, 12.12.2026: EINE Tabelle, alle Wettbewerber auf einen Blick. Bis
   dahin stand je Wettbewerber ein eigener Block mit Kopfzeile, Kontextsatz,
   zwei Listen und einem Aufklapper mit 17 Geräten - zusammen über 900 px
   Höhe, deren Aussage „0 und 0" war. Jetzt trägt jede Zeile drei Zahlen; die
   belegten Geräte stehen als Namen in der Zelle, weil nur sie die Zahl
   erklären. Kein Umschalter, kein Erklärsatz, keine Gerätelisten - die
   Messlücke ist eine Zahl, kein Kapitel. #}
{% set pf = geraete.hersteller.portfolio if geraete.hersteller else none %}
<section class="gr-pf gx-art gx-art--tarif" id="portfolio" aria-labelledby="pf-titel">
  <div class="gx-kopf"><h2 id="pf-titel">Portfolio gegen Vodafone</h2></div>
  {% if not pf %}
  <p class="gx-leer">Portfolio-Vergleich nicht berechnet.</p>
  {% elif pf.fehler %}
  <p class="gx-leer">Portfolio-Vergleich nicht verfügbar: {{ pf.fehler }}</p>
  {% elif pf.leer %}
  <p class="gx-leer">Kein Wettbewerber mit frischem Preis bei den aktuellen Modellen.</p>
  {% else %}
  {% if pf.hinweis %}<p class="gx-leer">{{ pf.hinweis }}</p>{% endif %}
  <table class="gr-pf-tafel">
    <thead>
      <tr><th scope="col">Anbieter</th><th scope="col">beide</th><th scope="col">nur dort</th><th scope="col">nur Vodafone</th><th scope="col">nicht gemessen</th></tr>
    </thead>
    <tbody>
      {% for p in pf.paare %}
      <tr class="gr-anb--{{ p.slug }}" data-pf="{{ p.name }}" data-nur-w="{{ p.n_w }}" data-nur-v="{{ p.n_v }}" data-offen="{{ p.n_offen }}">
        <th scope="row"><i class="gr-pf-punkt"></i>{{ p.legende }}</th>
        <td class="gr-pf-zahl">{{ p.beide }}</td>
        <td class="gr-pf-zahl{{ ' gr-pf-null' if not p.n_w }}">{{ p.n_w }}{% if p.namen_w %}<small>{% for g in p.namen_w %}{% if not loop.first %}, {% endif %}<a href="{{ g.beleg }}" rel="noopener">{{ g.name }}</a>{% if g.original %}<a class="gr-pf-orig" href="{{ g.original }}" rel="noopener" aria-label="Originalseite zu {{ g.name }}">↗</a>{% endif %}{% endfor %}</small>{% endif %}</td>
        <td class="gr-pf-zahl{{ ' gr-pf-null' if not p.n_v }}">{{ p.n_v }}{% if p.namen_v %}<small>{% for g in p.namen_v %}{% if not loop.first %}, {% endif %}<a href="{{ g.beleg }}" rel="noopener">{{ g.name }}</a>{% if g.original %}<a class="gr-pf-orig" href="{{ g.original }}" rel="noopener" aria-label="Originalseite zu {{ g.name }}">↗</a>{% endif %}{% endfor %}</small>{% endif %}</td>
        <td class="gr-pf-zahl gr-pf-offen">{{ p.n_offen }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
