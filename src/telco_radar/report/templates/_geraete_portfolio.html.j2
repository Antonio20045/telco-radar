{# Portfolio gegen Vodafone (Ziel 3): Daten und Texte liefert geraete_portfolio.py.
   Ohne JavaScript stehen alle Paare untereinander; app.js zeigt nur das gewählte.
   Die belegten Unterschiede stehen als Kachelraster (Paket C, 17.11.2026): je
   Gerät eine Kachel mit Foto-Platz, Hersteller, Modellname und wenigen Worten.
   Der Höhendeckel (`pf.grenze`) kommt aus dem Modul; was darüber liegt, steht in
   einem zugeklappten `<details>` und braucht dafür kein JavaScript. #}
{% set pf = geraete.hersteller.portfolio if geraete.hersteller else none %}
{% macro kachel(g) %}
<li class="gr-pf-kachel{% if g.beleg and not g.beleg.url %} gr-pf-kachel--kurz{% endif %}"{% if g.beleg %} title="{{ g.beleg.titel }}"{% endif %}>
  <span class="gr-pf-foto">
    {% if g.bild %}<img src="{{ g.bild }}" alt="{{ g.hersteller }} {{ g.name }}" loading="lazy" decoding="async">
    {% else %}<svg class="gr-pf-silhouette" viewBox="0 0 24 36" aria-hidden="true" focusable="false"><use href="#pf-geraet"></use></svg>{% endif %}
  </span>
  <span class="gr-pf-marke">{{ g.hersteller }}</span>
  <span class="gr-pf-geraet">{{ g.name }}</span>
  {# Ohne Screenshot keine Belegzeile: die Überschrift der Liste sagt es schon,
     der Auszug steht im `title` der Kachel (RUHIGER-RUNDE2-1717 Aufgabe 5). #}
  {% if g.beleg and g.beleg.url %}
  <span class="gr-pf-beleg"><a href="{{ g.beleg.url }}" rel="noopener">Beleg</a> · {{ g.beleg.kurz }}</span>
  {% endif %}
</li>
{% endmacro %}
{% macro kacheln(liste, grenze, mehr) %}
<ul class="gr-pf-kacheln">
  {% for g in liste[:grenze] %}{{ kachel(g) }}{% endfor %}
</ul>
{% if mehr %}
<details class="gr-pf-mehr">
  <summary>{{ mehr }}</summary>
  <ul class="gr-pf-kacheln">
    {% for g in liste[grenze:] %}{{ kachel(g) }}{% endfor %}
  </ul>
</details>
{% endif %}
{% endmacro %}
{% macro messluecken(liste) %}
  {% for gr in liste %}
  <div class="gr-pf-gruppe">
    <h5>{{ gr.hersteller }}</h5>
    <ul>
      {% for g in gr.geraete %}
      <li><span class="gr-pf-geraet">{{ g.name }}</span>
        <span class="gr-pf-beleg">{{ g.satz }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
{% endmacro %}
<section class="gr-pf gx-art gx-art--tarif" id="portfolio" aria-labelledby="pf-titel"{% if pf and pf.standard %} data-standard="{{ pf.standard }}"{% endif %}>
  <div class="gx-kopf"><h2 id="pf-titel">Portfolio gegen Vodafone</h2></div>
  {% if not pf %}
  <p class="gx-leer">Portfolio-Vergleich nicht berechnet.</p>
  {% elif pf.fehler %}
  <p class="gx-leer">Portfolio-Vergleich nicht verfügbar: {{ pf.fehler }}</p>
  {% elif pf.leer %}
  <p class="gx-leer">Kein Wettbewerber mit frischem Preis bei den aktuellen Modellen.</p>
  {% else %}
  <svg class="gr-pf-sprite" width="0" height="0" aria-hidden="true" focusable="false"><symbol id="pf-geraet" viewBox="0 0 24 36"><rect x="1.5" y="1.5" width="21" height="33" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"></rect><rect x="9" y="4" width="6" height="1.4" rx=".7" fill="currentColor"></rect></symbol></svg>
  <p class="gr-pf-regel">{{ pf.regel }}</p>
  {% if pf.hinweis %}<p class="gr-pf-regel gr-pf-hinweis">{{ pf.hinweis }}</p>{% endif %}
  {% if pf.fehlende %}<p class="gr-pf-regel gr-pf-fehlende">{{ pf.fehlende }}</p>{% endif %}
  <div class="gr-zr-zeitwahl gr-pf-wahl" id="pf-wahl" role="group" aria-label="Wettbewerber" hidden>
    {% for p in pf.paare %}
    <button type="button" data-pf="{{ p.name }}" aria-pressed="{{ 'true' if p.name == pf.standard else 'false' }}">{{ p.legende }}</button>
    {% endfor %}
  </div>
  {% for p in pf.paare %}
  <div class="gr-pf-paar gr-anb--{{ p.slug }}" data-pf="{{ p.name }}" data-nur-w="{{ p.n_w }}" data-nur-v="{{ p.n_v }}" data-offen="{{ p.n_offen }}">
    <h3 class="gr-pf-kopf">{{ p.kopf }}</h3>
    <p class="gr-pf-kontext">{{ p.kontext }}</p>
    <div class="gr-pf-listen">
      <div class="gr-pf-liste gr-pf-liste--w">
        <h4>Hat {{ p.legende }}, Vodafone nicht</h4>
        {% if p.nur_w %}{{ kacheln(p.nur_w, pf.grenze, p.mehr_w) }}{% else %}<p class="gr-pf-leer">Keine belegte Lücke.</p>{% endif %}
      </div>
      <div class="gr-pf-liste gr-pf-liste--v">
        <h4>Hat Vodafone, {{ p.legende }} nicht</h4>
        {% if p.nur_v %}{{ kacheln(p.nur_v, pf.grenze, p.mehr_v) }}{% else %}<p class="gr-pf-leer">Keine belegte Lücke.</p>{% endif %}
      </div>
    </div>
    <details class="gr-pf-offen"{% if p.offen_zeigen %} open{% endif %}>
      <summary>Nicht gemessen (Messlücke, zählt nicht): {{ p.n_offen }}</summary>
      {% if p.offen %}{{ messluecken(p.offen) }}{% else %}<p class="gr-pf-leer">Keine.</p>{% endif %}
    </details>
  </div>
  {% endfor %}
  {% endif %}
</section>
