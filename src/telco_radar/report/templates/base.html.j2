<!DOCTYPE html>
<html lang="de" class="ohne-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Vodafone Product and Services Insights{% endblock %}</title>
  <meta name="robots" content="noindex">
  {# Eine Schrift fuer alles (Instrument Sans, SIL OFL), selbst gehostet:
     keine Schrift und kein Skript von einem CDN (CLAUDE.md, Regel 5). #}
  <link rel="preload" href="{{ prefix }}static/schrift/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ prefix }}style.css">
  <link rel="icon" type="image/png" href="{{ prefix }}logo.png">
</head>
{% set uc = usecase | default('markt') %}
<body class="uc-{{ uc }} seite-{{ active | default('seite') }}{% if buehne %} mit-buehne{% endif %}{% if hintergrund %} mit-hintergrund{% endif %}">
  <a class="sprungmarke" href="#inhalt">Zum Inhalt</a>
  {# Der Kopf schwebt ueber dem Bild jeder Seite: Marke links, EINE
     Navigation in der Mitte, Suche und Newsletter rechts. Die Trennung
     "Marktrecherche | Promo Übersicht" ist mit dem Redesign vom 09.10.2026
     gefallen - Promo ist ein Eintrag wie jeder andere. #}
  <header class="topbar kopf" id="kopf">
    <div class="topbar-inner kopf-inner">
      <a class="brand" href="{{ prefix }}index.html" aria-label="Vodafone Product and Services Insights">
        <span class="brand-logo-wrap"><img class="brand-logo" src="{{ prefix }}logo.png" alt="" width="15" height="15"></span>
        <span class="brand-name">Vodafone <span class="brand-zusatz">Product and Services</span> <em>Insights</em></span>
      </a>
      <nav class="subbar subnav navi" aria-label="Marktrecherche">
        <a href="{{ prefix }}index.html" {% if active=='woche' %}class="on" aria-current="page"{% endif %}>Diese Woche</a>
        <a href="{{ prefix }}meldungen.html" {% if active=='meldungen' %}class="on" aria-current="page"{% endif %}>Meldungen</a>
        <a href="{{ prefix }}wettbewerb.html" {% if active in ('wettbewerb', 'differenzierung') %}class="on" aria-current="page"{% endif %}>Wettbewerb</a>
        {# "Geräte" erscheint, sobald die Seite ihre Frage beantworten kann
           (`geraete_view.schwelle_erreicht()` -> `geraete_verlinkt`). #}
        {% if geraete_verlinkt %}
        <a href="{{ prefix }}geraete.html" {% if active=='geraete' %}class="on" aria-current="page"{% endif %}>Geräte</a>
        {% endif %}
        <a href="{{ prefix }}promo/index.html" {% if uc=='promo' %}class="on" aria-current="page"{% endif %}>Promo</a>
        <a href="{{ prefix }}transparenz.html" {% if active=='transparenz' %}class="on" aria-current="page"{% endif %}>Quellen</a>
      </nav>
      <div class="topbar-right kopf-rechts">
        {# Auf der Suchseite selbst faellt das Feld weg: dort steht das grosse
           Feld im Seitenkopf. ⌘K oder Strg+K setzt den Fokus hierher. #}
        {% if not ohne_topbar_suche %}
        <form class="gsearch" id="gsearch" role="search" action="{{ prefix }}suche.html" autocomplete="off">
          <svg class="gsearch-lupe" viewBox="0 0 20 20" width="15" height="15" fill="none" aria-hidden="true">
            <circle cx="9" cy="9" r="6.2" stroke="currentColor" stroke-width="1.7"/>
            <line x1="13.6" y1="13.6" x2="18" y2="18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
          <input type="search" id="gsearch-input" name="q" class="gsearch-input" autocomplete="off"
                 placeholder="Suchen"
                 aria-label="Marktrecherche durchsuchen">
          <kbd class="gsearch-taste" aria-hidden="true">⌘K</kbd>
          <button type="submit" class="gsearch-btn" aria-label="Suchen"><span aria-hidden="true">→</span></button>
        </form>
        {% endif %}
        {# "Newsletter" erscheint erst, wenn die Seite Adressen entgegennehmen
           darf - Impressum und Datenschutz vollstaendig
           (`rechtstexte.vollstaendig()`), Art. 13 DSGVO. #}
        {% if newsletter_verlinkt %}
        <a class="kopf-newsletter{% if active=='newsletter' %} on{% endif %}" href="{{ prefix }}newsletter.html">Newsletter</a>
        {% endif %}
      </div>
    </div>
  </header>
  <main id="inhalt">
    {% block buehne %}{% endblock %}
    <div class="{{ wrap_class | default('wrap') }}">
      {% if ausfaelle %}<p class="ausfall-hinweis" id="ausfaelle">Nicht neu gebaut: {% for a in ausfaelle %}{{ a.teil }} ({{ a.grund | truncate(160) }}){% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
      {% block content %}{% endblock %}
    </div>
  </main>
  <footer class="foot">
    <div class="foot-inner">
      <span>Vodafone Product and Services Insights &middot; automatisch erstellt, jede Aussage mit Quelle</span>
      {# Impressum und Datenschutz auf JEDER Seite (Art. 13 DSGVO); verlinkt
         wird nur, was auch gerendert wurde (`rechtstexte_verlinkt`). #}
      {% set rv = rechtstexte_verlinkt | default([]) %}
      {% if rv %}
      <span class="foot-recht">
        {% if 'impressum' in rv %}<a href="{{ prefix }}impressum.html">Impressum</a>{% endif %}
        {% if 'datenschutz' in rv %}<a href="{{ prefix }}datenschutz.html">Datenschutz</a>{% endif %}
      </span>
      {% endif %}
    </div>
    <p class="foot-bildnachweis">Bilder: generiert für dieses Portal. Campus-Motiv nach einer Vorlage von
      <a href="https://commons.wikimedia.org/wiki/File:Vodafone-Campus_D%C3%BCsseldorf.jpg" target="_blank" rel="noopener">Wikimedia Commons</a>.
      Schrift: Instrument Sans (SIL Open Font License).</p>
  </footer>
  <script src="{{ prefix }}app.js"></script>
</body>
</html>
