<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Vodafone Insights{% endblock %}</title>
  <meta name="robots" content="noindex">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ prefix }}style.css">
  <link rel="icon" type="image/png" href="{{ prefix }}logo.png">
</head>
<body class="uc-{{ usecase | default('markt') }}">
  {% set uc = usecase | default('markt') %}
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="{{ prefix }}index.html" aria-label="Vodafone Insights">
        <span class="brand-logo-wrap"><img class="brand-logo" src="{{ prefix }}logo.png" alt="" width="18" height="18"></span>
        <span class="brand-name">Vodafone <em>Insights</em></span>
      </a>
      <div class="topbar-right">
        <nav class="usecases" aria-label="Anwendungsfälle">
          <a class="uc {% if uc=='markt' %}active{% endif %}" href="{{ prefix }}index.html">Marktrecherche</a>
          <a class="uc {% if uc=='promo' %}active{% endif %}" href="{{ prefix }}promo/index.html">Promo Übersicht</a>
        </nav>
        <form class="gsearch" id="gsearch" role="search" action="{{ prefix }}suche.html" autocomplete="off">
          <input type="search" id="gsearch-input" name="q" class="gsearch-input" autocomplete="off"
                 placeholder="Alle Berichte &amp; Differenzierung durchsuchen …"
                 aria-label="Marktrecherche durchsuchen">
          <button type="submit" class="gsearch-btn" aria-label="Suchen">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
              <circle cx="9" cy="9" r="6.2" stroke="currentColor" stroke-width="1.8"/>
              <line x1="13.6" y1="13.6" x2="18" y2="18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
    {% if uc == 'promo' %}
    <nav class="subbar subnav" aria-label="Promo Übersicht">
      <a href="{{ prefix }}promo/index.html" {% if active=='promo_uebersicht' %}class="on"{% endif %}>Übersicht</a>
      <a href="{{ prefix }}promo/quellen.html" {% if active=='promo_quellen' %}class="on"{% endif %}>Quellen</a>
    </nav>
    {% else %}
    <nav class="subbar subnav" aria-label="Marktrecherche">
      <a href="{{ prefix }}index.html" {% if active=='uebersicht' %}class="on"{% endif %}>Übersicht</a>
      <a href="{{ prefix }}bericht.html" {% if active=='bericht' %}class="on"{% endif %}>Bericht</a>
      <a href="{{ prefix }}differenzierung.html" {% if active=='differenzierung' %}class="on"{% endif %}>Differenzierung</a>
      <a href="{{ prefix }}wettbewerber.html" {% if active=='wettbewerber' %}class="on"{% endif %}>Wettbewerber</a>
      <a href="{{ prefix }}protokoll.html" {% if active=='protokoll' %}class="on"{% endif %}>Protokoll</a>
      <a href="{{ prefix }}archive.html" {% if active=='archive' %}class="on"{% endif %}>Archiv</a>
      <a href="{{ prefix }}sources.html" {% if active=='sources' %}class="on"{% endif %}>Quellen</a>
    </nav>
    {% endif %}
  </header>
  <main>
    <div class="{{ wrap_class | default('wrap') }}">
      {% block content %}{% endblock %}
    </div>
  </main>
  <footer class="foot">
    <div class="foot-inner">
      Vodafone Insights &middot; {% if uc == 'promo' %}Promo Übersicht{% else %}Marktrecherche{% endif %} Intern &middot; automatisch aktualisiert
    </div>
  </footer>
  <script src="{{ prefix }}app.js"></script>
</body>
</html>
