{% extends "base.html.j2" %}
{% set active = 'archive' %}
{% set wrap_class = 'wrap-narrow' %}
{% block title %}Telco Radar - Archiv{% endblock %}
{% block content %}
<section class="page-hero">
  <p class="page-kicker">Archiv</p>
  <h1>Frühere Berichte</h1>
  <p class="page-lead">Alle bisherigen Wochenberichte – jeder zeigt, was in seiner Woche neu war.</p>
</section>

{% if archive %}
<div class="list-card">
  {% for e in archive %}
  <a class="list-row" href="{{ prefix }}reports/{{ e.date }}.html">
    <span class="list-row-date">{{ e.date_de }}</span>
    <span class="list-row-meta">{{ e.stats.get('operators','–') }} Betreiber</span>
    <span class="list-row-meta">{{ e.stats.get('collected','–') }} geprüft</span>
    <span class="list-row-flag">{% if not e.llm %}<span class="kbadge">roh</span>{% endif %}</span>
    <span class="list-row-new">{{ e.stats.get('new','–') }} neu</span>
  </a>
  {% endfor %}
</div>
{% else %}
<p class="empty-note">Noch keine Berichte im Archiv.</p>
{% endif %}
{% endblock %}
