{# Letztes Messdatum je Anbieter (Brief messdatum-0811). Text und Regel liefert
   geraete_messdatum.py; hier steht nur die Hülle. Ein Anbieter, der nicht vom
   jüngsten Messtag stammt, trägt „Stand vom TT.MM.“; ohne lesbares Datum steht
   „Messdatum unbekannt“, nie das heutige.

   RUHIGER-RUNDE2-1717 Aufgabe 2: bis hierher stand jeder Block zweizeilig
   (Satz oben, Anteil in einer eigenen Grid-Zeile darunter - acht Blöcke,
   acht Extrazeilen). Jetzt steht der Anteil gekürzt ("n von m Preisen"
   statt "n von m gezeigten Preisen von diesem Tag") IN der einen Zeile;
   die Langform (Satz, voller Anteil, Stand-Marke) steht vollständig im
   `title`, keine Information ist gefallen.

   Kaufweg: konnte der Gerätelauf nicht prüfen, welche Tarife ein Kunde kaufen kann
   (o2-Tarifübersicht nicht gelesen, analyze/kaufweg.py), steht an der Zeile die
   Marke „Kaufweg nicht geprüft“, der Satz mit Grund und Datum im `title`. #}
{% set md = geraete.messdatum %}
{% if md and md.zeilen %}
<ul class="gr-md" id="messdatum" aria-label="Letztes Messdatum je Anbieter">
  {% for z in md.zeilen %}
  {% set kurz_anteil = z.anteil | replace(' gezeigten Preisen von diesem Tag', ' Preisen') if z.anteil else '' %}
  {% set lang = [z.satz] %}
  {% if z.anteil %}{% set _ = lang.append(z.anteil) %}{% endif %}
  {% if z.stand %}{% set _ = lang.append(z.stand) %}{% endif %}{% if z.kaufweg %}{% set _ = lang.append(z.kaufweg) %}{% endif %}
  <li class="gr-md-z{{ ' gr-md-z--alt' if z.alt }}" data-anbieter="{{ z.name }}" data-datum="{{ z.datum }}" title="{{ lang | join('. ') }}">{{ z.satz }}{% if kurz_anteil %} <span class="gr-md-anteil">· {{ kurz_anteil }}</span>{% endif %}{% if z.stand %} <span class="gr-kk-marke gr-kk-marke--alt">{{ z.stand }}</span>{% endif %}{% if z.kaufweg %} <span class="gr-kk-marke gr-kk-marke--alt gr-md-kaufweg">{{ z.kaufweg_marke }}</span>{% endif %}</li>
  {% endfor %}
</ul>
{% endif %}
{% include "_geraete_vollstaendigkeit.html.j2" %}
{% include "_geraete_gegenprobe_stand.html.j2" %}
