{# Preispositionierung (Antonio, 02.11.2026): ein Bild ganz oben - wo die
   Anbieter beim Preis stehen. Daten und SVG liefert geraete_preisposition.py;
   hier steht nur die Hülle. Kein Erklärtext (Antonios Stil). #}
{% set pp = geraete.preisposition %}
<section class="gr-pp gx-art gx-art--tarif" id="preisposition" aria-labelledby="pp-titel">
  <div class="gx-kopf"><h2 id="pp-titel">Preispositionierung je Modell</h2></div>
  {% if not pp %}
  <p class="gx-leer">Preispositionierung nicht berechnet.</p>
  {% elif pp.fehler %}
  <p class="gx-leer">Preispositionierung nicht verfügbar: {{ pp.fehler }}</p>
  {% elif pp.leer %}
  <p class="gx-leer">Kein geprüfter Preis in den gewählten Modellen.</p>
  {% else %}
  <ul class="gr-pp-legende">
    {% for a in pp.legende %}
    <li class="gr-anb--{{ a.slug }}{{ ' gr-pp-ohne' if a.fehlt }}"><svg viewBox="-9 -9 18 18" aria-hidden="true">{{ a.marke | safe }}</svg>{{ a.name }}{% if a.fehlt %}<small>{{ a.fehlt }}</small>{% endif %}</li>
    {% endfor %}
  </ul>
  <p class="gr-pp-einheit">{{ pp.achsentitel }}</p>
  <div class="gr-pp-bild gr-pp-breit">{{ pp.svg_breit | safe }}</div>
  <div class="gr-pp-bild gr-pp-schmal">{{ pp.svg_schmal | safe }}</div>
  {% endif %}
</section>
