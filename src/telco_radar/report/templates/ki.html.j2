{# KI - die KI-Meldungen aller Berichte (Pitch 9, Entwurf 10, Schnitt 1).

   Kopf (Antonio, 14.10.2026): das Kopfband aller Reiter statt Vollbild,
   darunter die Wegweiser zu Verstehen, Prompts und Modellen; die
   Meldungen stehen im ersten Bildschirm. Darunter drei Spalten mit dem Aufmacher in der
   Mitte, ohne fremde Fotos; jede Meldung traegt ihren Quellenlink.
   Darunter je Ressort eine Zeile: Bild mit Namen, Aufmacher, wenige
   kleinere, der Rest zugeklappt. Im ersten Ressort steht statt der
   kleineren das Fenster mit den Modellen, die kleineren unter dem
   Aufmacher.
   Die Auswahl rechnet `ki_seite.ausgabe()`, Ressort, Kapitel und Archiv
   `analyze.ki_blatt` (Zeitungsprinzip, Schnitt 2).
   Die Rubrikleiste (Schnitt 8) zeigt app.js, sobald der Kopf vorbei ist.
   Verstehen (Schnitt 9): Linie und Pillen stehen fertig im HTML, app.js
   zeichnet sie mit dem Scrollen; die Schiene kommt aus ki_seite.KAPITEL.
   Muster-Prompts (Schnitt 13): ohne JS alle Themen untereinander, jeder
   Text in <details>; app.js schaltet auf ein Thema mit Panel um.
   Videos (Schnitte 14, 15): eigenes Standbild, erst der Klick setzt in
   app.js das iframe von youtube-nocookie; ohne JS bleibt der Link. #}
{% extends "base.html.j2" %}
{% import "_design.html.j2" as d %}
{% set active = 'ki' %}
{% set buehne = true %}
{% block title %}Vodafone Product and Services Insights · KI{% endblock %}

{% macro meldung(h, art, dek=false, kicker=true) %}
<article class="ki-meldung ki-meldung--{{ art }}">
  {% if kicker %}<p class="ki-kicker">{{ h.ki_ressort }}</p>{% endif %}
  <h3 class="ki-schlag"><a href="{{ h.url }}" target="_blank" rel="noopener">{{ h.schlagzeile }}</a></h3>
  {% if dek and h.summary %}<p class="ki-dek">{{ h.summary }}</p>{% endif %}
  <p class="ki-wer"><a class="ki-quelle" href="{{ h.url }}" target="_blank" rel="noopener">{{ h.source_label }}</a>{% if h.operator %} · {{ h.operator }}{% endif %} · {{ h.ki_datum | date_de }}</p>
</article>
{% endmacro %}

{% macro video(v, art, n=0) %}
<article class="ki-video ki-video--{{ art }}">
  <button type="button" class="ki-player" data-ki-video="{{ v.id }}" aria-label="Video abspielen: {{ v.titel }}">{% if v.bild_src %}<img class="ki-standbild" src="{{ v.bild_src }}" alt="" loading="lazy" decoding="async">{% else %}<svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g><circle cx="{{ 90 + n * 50 }}" cy="90" r="60"/><circle cx="{{ 90 + n * 50 }}" cy="90" r="34"/><path d="M0 {{ 120 - n * 8 }} C 80 {{ 60 + n * 14 }}, 200 {{ 150 - n * 16 }}, 320 {{ 70 + n * 12 }}"/></g></svg>{% endif %}<span class="ki-knopf"></span><span class="ki-zeit">{{ v.zeit }}</span></button>
  <div class="ki-video-text">
    <p class="ki-kicker">Video{% if v.stufe %} · {{ v.stufe }}{% endif %}</p>
    <h3 class="ki-video-titel">{{ v.titel }}</h3>
    <p class="ki-wer">{{ v.kanal }} · {{ v.minuten }} Minuten · <a class="ki-quelle" href="https://www.youtube.com/watch?v={{ v.id }}" target="_blank" rel="noopener">auf YouTube öffnen</a></p>
  </div>
</article>
{% endmacro %}

{% macro video_reihe() %}
{% if videos.reihe or videos.ausfall %}
<div class="ki-video-reihe" id="ki-videos">
  <h2 class="ki-spaltenkopf">Videos · was man mit KI bauen kann</h2>
  {% if videos.reihe %}<div class="ki-videos">{% for v in videos.reihe %}{{ video(v, 'reihe', loop.index0 % 4) }}{% endfor %}</div>{% endif %}
  {% if videos.ausfall %}<p class="ki-video-ausfall">Videos nicht abgerufen: {{ videos.ausfall }}{% if videos.stand %} · Stand {{ videos.stand }}{% endif %}</p>{% endif %}
</div>
{% endif %}
{% endmacro %}

{% macro modelle_fenster() %}
<aside class="ki-fenster" id="modelle" aria-labelledby="modelle-titel">
  <h2 class="ki-fenster-titel" id="modelle-titel">Stärkste KI-Modelle</h2>
  {% if modelle.top %}
  <ol class="ki-rang">
    {% for m in modelle.top %}
    <li class="ki-rang-eintrag"><span class="ki-rang-platz">{{ m.platz }}</span><span class="ki-rang-punkt" style="--firma:var({{ m.farbe }})" aria-hidden="true"></span><span class="ki-rang-name">{{ m.name }}</span></li>
    {% endfor %}
  </ol>
  {% elif not modelle.ausfall %}
  <p class="ki-modelle-leer">Die Ranglisten der KI-Modelle sind noch nicht abgerufen.</p>
  {% endif %}
  {% if modelle.urls %}
  <p class="ki-modelle-quelle">Platz aus <a href="{{ modelle.urls.aa }}" target="_blank" rel="noopener">Artificial Analysis</a> und <a href="{{ modelle.urls.arena }}" target="_blank" rel="noopener">Arena</a>{% if modelle.stand %} · {% if modelle.ausfall %}Stand {% endif %}{{ modelle.stand }}{% endif %}{% for name, tag in modelle.ausfall %} · {{ name }} am {{ tag }} nicht abrufbar{% endfor %}{% if modelle.fehler %} · {{ modelle.fehler }}{% endif %}</p>
  {% endif %}
</aside>
{% endmacro %}

{% macro ressort(r, fenster=false) %}
<div class="ki-ressort{% if fenster %} ki-ressort--fenster{% endif %}" id="ressort-{{ r.schluessel }}">
  <div class="ki-ressort-blatt{% if not r.neben and not fenster %} ki-ressort-blatt--allein{% endif %}">
    <div class="ki-ressort-bild">{{ d.motiv('ki-' ~ r.schluessel, prefix, 'ki-ressort-motiv', breite=2400, hoehe=1339) }}
      <h2 class="ki-ressort-titel" id="ressort-{{ r.schluessel }}-titel">{{ r.name }}</h2>
    </div>
    <div class="ki-ressort-mitte">
      {{ meldung(r.aufmacher, 'kopf', dek=true, kicker=false) }}
      {% if fenster and r.neben %}<div class="ki-ressort-neben">{% for h in r.neben %}{{ meldung(h, 'neben', kicker=false) }}{% endfor %}</div>{% endif %}
    </div>
    {% if fenster %}{{ modelle_fenster() }}
    {% elif r.neben %}<div class="ki-ressort-neben">{% for h in r.neben %}{{ meldung(h, 'neben', dek=loop.first, kicker=false) }}{% endfor %}</div>{% endif %}
  </div>
  {% if r.weitere %}
  <details class="ki-ressort-weitere">
    <summary>Weitere {{ r.weitere | length }} aus {{ r.name }}</summary>
    <div class="ki-weitere-liste">{% for h in r.weitere %}{{ meldung(h, 'weitere', kicker=false) }}{% endfor %}</div>
  </details>
  {% endif %}
</div>
{% endmacro %}

{% block buehne %}
<section class="wa-auftakt mg-auftakt ki-auftakt kopfband">
  <div class="wa-auftakt-buehne">
    <div class="wa-rahmen">
      <div class="wa-bild" aria-hidden="true">{{ d.motiv('band-ki', prefix, 'wa-motiv', eager=true) }}</div>
      <div class="wa-schleier" aria-hidden="true"></div>
      <header class="mg-kopf wa-text">
        {% if ausgabe.kw %}<p class="mg-woche">Kalenderwoche {{ ausgabe.kw }}</p>{% endif %}
        <h1 class="mg-titel ki-titel" aria-label="KI">{% for c in 'KI' %}<span style="--i:{{ loop.index0 }}" aria-hidden="true">{{ c }}</span>{% endfor %}</h1>
        {% if date_de %}<p class="mg-datum">Ausgabe vom {{ date_de }}</p>{% endif %}
      </header>
    </div>
  </div>
</section>
{% endblock %}

{% block content %}
<nav class="ki-tueren" aria-label="Mehr auf dieser Seite">
  <a class="ki-tuer" href="#verstehen"><b>Verstehen</b>{% set fertig = kapitel | selectattr('ziel') | list %}<span>{% if fertig | length > 1 %}Kapitel 1 bis {{ fertig | length }}{% else %}Kapitel 1: {{ kapitel[0].titel }}{% endif %}</span></a>
  {% if prompts.anzahl %}<a class="ki-tuer" href="#prompts"><b>Prompts</b><span>{{ prompts.anzahl }} zum Kopieren</span></a>{% endif %}
  {% if modelle.top %}<a class="ki-tuer" href="#modelle"><b>Modelle</b><span>Platz 1: {{ modelle.top[0].kurz }}</span></a>{% endif %}
</nav>
{% if rubriken %}
<nav class="ki-rubriken" id="ki-rubriken" aria-label="Teile der KI-Seite">{% for r in rubriken %}<a href="#{{ r.ziel }}">{{ r.name }} <b>{{ r.zahl }}</b></a>{% endfor %}</nav>
{% endif %}
<section class="ki-blatt" id="meldungen" aria-label="KI-Meldungen">
  {% if ausgabe.aufmacher %}
  <div class="ki-oben">
    {{ meldung(ausgabe.aufmacher, 'aufmacher', dek=true) }}
    <div class="ki-links">{% if videos.links %}{{ video(videos.links, 'gross') }}{% endif %}{% for h in ausgabe.links %}{{ meldung(h, 'links', dek=true) }}{% endfor %}</div>
    <div class="ki-rechts">
      {% if ausgabe.rechts or videos.rechts %}<h2 class="ki-spaltenkopf">Auch wichtig</h2>{% endif %}
      {% for h in ausgabe.rechts %}{{ meldung(h, 'rechts') }}{% if loop.first and videos.rechts %}{{ video(videos.rechts, 'mini', 1) }}{% endif %}{% endfor %}
      {% if videos.rechts and not ausgabe.rechts %}{{ video(videos.rechts, 'mini', 1) }}{% endif %}
    </div>
  </div>
  {% for r in ausgabe.ressorts %}{{ ressort(r, fenster=loop.first) }}{% if loop.index == ausgabe.videos_nach %}{{ video_reihe() }}{% endif %}{% endfor %}
  {% if not ausgabe.ressorts %}{{ modelle_fenster() }}{{ video_reihe() }}{% endif %}
  {% if ausgabe.archiv %}
  <details id="ki-archiv" class="ki-archiv">
    <summary>Archiv · {{ ausgabe.archiv | length }} ältere {{ 'Meldung' if ausgabe.archiv | length == 1 else 'Meldungen' }}</summary>
    <ol class="ki-archiv-liste">
      {% for h in ausgabe.archiv %}
      <li><a href="{{ h.url }}" target="_blank" rel="noopener">{{ h.schlagzeile or h.title }}</a><span class="ki-archiv-wer">{{ h.source_label }} · {{ h.ki_datum | date_de }}</span></li>
      {% endfor %}
    </ol>
  </details>
  {% endif %}
  {% else %}
  <p class="empty-note">In den Berichten steht noch keine KI-Meldung.</p>
  {{ modelle_fenster() }}
  {{ video_reihe() }}
  {% endif %}
</section>

<section class="ki-verstehen" id="verstehen" aria-label="KI verstehen">
  <h2 class="ki-ansage ki-lern-ansage"><span><i>Wie antwortet</i></span><span><i>eigentlich</i></span><span><i>eine KI<em>?</em></i></span></h2>
  <a class="ki-fahrt" href="{{ kapitel[0].ziel }}" aria-label="Kapitel 1 ansehen: {{ kapitel[0].titel }}">
    <svg viewBox="0 0 1000 260" aria-hidden="true">
      <path class="ki-fahrt-weg" d="{{ fahrt.weg }}"/>
      {% for p in fahrt.pillen %}
      <g class="ki-zug" data-an="{{ p.an }}" data-anker="{{ p.anker }}"><rect x="{{ p.rx }}" y="{{ p.ry }}" width="{{ p.breite }}" height="{{ p.hoehe }}" rx="{{ p.hoehe / 2 }}"/><text x="{{ p.x }}" y="{{ p.ty }}" text-anchor="{{ p.anker }}" font-size="{{ p.schrift }}">{{ p.wort }}</text><circle cx="{{ p.x }}" cy="{{ p.y }}" r="6"/></g>
      {% endfor %}
      {% set ende = fahrt.pillen | last %}
      <circle class="ki-fahrt-punkt" cx="{{ ende.x }}" cy="{{ ende.y }}" r="9"/>
    </svg>
    <span class="ki-los">Kapitel 1 ansehen <span aria-hidden="true">→</span></span>
  </a>
  <ol class="ki-schiene" style="--kapitel:{{ kapitel | length }}" aria-label="Alle {{ kapitel | length }} Kapitel">
    {% for k in kapitel %}
    {% if k.ziel %}<li class="ki-kapitel ki-kapitel--fertig"><a href="{{ k.ziel }}"><b>{{ k.nr }}</b>{{ k.titel }}</a></li>
    {% else %}<li class="ki-kapitel"><b>{{ k.nr }}</b>{{ k.titel }}</li>{% endif %}
    {% endfor %}
  </ol>
</section>

<section class="ki-prompts" id="prompts" aria-label="Muster-Prompts">
  <div class="ki-p-kopfzeile"><h2>Muster-Prompts</h2>{% if prompts.anzahl %}<span>{{ prompts.anzahl }} zum Kopieren</span>{% endif %}</div>
  {% if prompts.error %}
  <p class="ki-p-ausfall">Muster-Prompts nicht geladen: {{ prompts.error }}</p>
  {% else %}
  <nav class="ki-p-themen" aria-label="Themen">{% for t in prompts.themen %}<a href="#prompts-{{ loop.index }}">{{ t.name }} ({{ t.prompts | length }})</a>{% endfor %}</nav>
  <div class="ki-p-raster">
    <div class="ki-p-liste">
      {% for t in prompts.themen %}
      <div class="ki-p-gruppe" id="prompts-{{ loop.index }}">
        <h3>{{ t.name }}</h3>
        {% for p in t.prompts %}<details class="ki-p-eintrag"><summary>{{ p.titel }}</summary><pre class="ki-p-text">{{ p.text }}</pre></details>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>
{% endblock %}
