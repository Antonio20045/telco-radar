{# KI - die KI-Meldungen aller Berichte (Pitch 9, Entwurf 10, Schnitt 1).

   Kopf wie die Meldungen-Seite: Vollbild, das beim Scrollen zum Fenster
   wird (Kinostrecke in app.js). Darunter drei Spalten mit dem Aufmacher in
   der Mitte, ohne fremde Fotos; jede Meldung traegt ihren Quellenlink.
   Die Auswahl rechnet `ki_seite.ausgabe()`, Ressort und Archiv
   `analyze.ki_blatt` (Zeitungsprinzip, Schnitt 2). Die Leiter der Modelle
   (Schnitt 7) baut app.js aus #ki-modelle-daten; ohne JS bleibt die Liste.
   Die Rubrikleiste (Schnitt 8) zeigt app.js, sobald der Kopf vorbei ist.
   Verstehen (Schnitt 9): Linie und Pillen stehen fertig im HTML, app.js
   zeichnet sie mit dem Scrollen; die Schiene kommt aus ki_seite.KAPITEL. #}
{% extends "base.html.j2" %}
{% import "_design.html.j2" as d %}
{% set active = 'ki' %}
{% set buehne = true %}
{% block title %}Vodafone Product and Services Insights · KI{% endblock %}

{% macro meldung(h, art, dek=false) %}
<article class="ki-meldung ki-meldung--{{ art }}">
  <p class="ki-kicker">{{ h.ki_ressort }}</p>
  <h3 class="ki-schlag"><a href="{{ h.url }}" target="_blank" rel="noopener">{{ h.schlagzeile }}</a></h3>
  {% if dek and h.summary %}<p class="ki-dek">{{ h.summary }}</p>{% endif %}
  <p class="ki-wer"><a class="ki-quelle" href="{{ h.url }}" target="_blank" rel="noopener">{{ h.source_label }}</a>{% if h.operator %} · {{ h.operator }}{% endif %} · {{ h.ki_datum | date_de }}</p>
</article>
{% endmacro %}

{% block buehne %}
<section class="wa-auftakt mg-auftakt ki-auftakt" data-buehne>
  <div class="wa-auftakt-buehne">
    <div class="wa-rahmen">
      <div class="wa-bild" aria-hidden="true">{{ d.motiv('band-ki', prefix, 'wa-motiv', eager=true) }}</div>
      <div class="wa-schleier" aria-hidden="true"></div>
      <header class="mg-kopf wa-text">
        {% if ausgabe.kw %}<p class="mg-woche">Kalenderwoche {{ ausgabe.kw }}</p>{% endif %}
        <h1 class="mg-titel ki-titel" aria-label="KI">{% for c in 'KI' %}<span style="--i:{{ loop.index0 }}" aria-hidden="true">{{ c }}</span>{% endfor %}</h1>
        {% if date_de %}<p class="mg-datum">Ausgabe vom {{ date_de }}</p>{% endif %}
      </header>
      <div class="wa-hinweis" aria-hidden="true"></div>
    </div>
  </div>
</section>
{% endblock %}

{% block content %}
{% if rubriken %}
<nav class="ki-rubriken" id="ki-rubriken" aria-label="Teile der KI-Seite">{% for r in rubriken %}<a href="#{{ r.ziel }}">{{ r.name }} <b>{{ r.zahl }}</b></a>{% endfor %}</nav>
{% endif %}
<section class="ki-blatt" id="meldungen" aria-label="KI-Meldungen">
  {% if ausgabe.aufmacher %}
  <div class="ki-oben">
    {{ meldung(ausgabe.aufmacher, 'aufmacher', dek=true) }}
    <div class="ki-links">{% for h in ausgabe.links %}{{ meldung(h, 'links', dek=true) }}{% endfor %}</div>
    <div class="ki-rechts">
      {% if ausgabe.rechts %}<h2 class="ki-spaltenkopf">Auch wichtig</h2>{% endif %}
      {% for h in ausgabe.rechts %}{{ meldung(h, 'rechts') }}{% endfor %}
    </div>
  </div>
  {% if ausgabe.liste %}
  <div class="ki-liste">{% for h in ausgabe.liste %}{{ meldung(h, 'liste') }}{% endfor %}</div>
  {% endif %}
  <p class="ki-mehr">Meldungen bleiben stehen wie in einer Zeitung: höchstens {{ ausgabe.je_ressort }} je Ressort, die älteste wandert ins Archiv.</p>
  {% if ausgabe.archiv %}
  <details id="ki-archiv" class="ki-archiv">
    <summary>Archiv · {{ ausgabe.archiv | length }} ältere {{ 'Meldung' if ausgabe.archiv | length == 1 else 'Meldungen' }}</summary>
    <ol class="ki-archiv-liste">
      {% for h in ausgabe.archiv %}
      <li><a href="{{ h.url }}" target="_blank" rel="noopener">{{ h.schlagzeile or h.title }}</a><span class="ki-archiv-wer">{{ h.source_label }} · {{ h.ki_datum | date_de }}</span></li>
      {% endfor %}
    </ol>
  </details>
  {% endif %}
  {% else %}
  <p class="empty-note">In den Berichten steht noch keine KI-Meldung.</p>
  {% endif %}
</section>

<section class="ki-modelle" id="modelle" aria-label="KI-Modelle">
  <div class="ki-modelle-innen">
    {% if modelle.top %}
    <h2 class="ki-ansage"><span><i>{{ modelle.top[0].kurz }}</i></span><span><i>ist gerade</i></span><span><i>die stärkste KI<em>.</em></i></span></h2>
    <script type="application/json" id="ki-modelle-daten">{{ modelle.leiter | tojson }}</script>
    <ol class="ki-rang">
      {% for m in modelle.top %}
      <li class="ki-rang-eintrag"><span class="ki-rang-platz">{{ m.platz }}</span><span class="ki-rang-punkt" style="--firma:var({{ m.farbe }})" aria-hidden="true"></span><span class="ki-rang-name">{{ m.name }}</span></li>
      {% endfor %}
    </ol>
    {% elif not modelle.ausfall %}
    <p class="ki-modelle-leer">Die Ranglisten der KI-Modelle sind noch nicht abgerufen.</p>
    {% endif %}
    {% if modelle.urls %}
    <p class="ki-modelle-quelle">Platz aus zwei Ranglisten gemittelt: <a href="{{ modelle.urls.aa }}" target="_blank" rel="noopener">Artificial Analysis</a> (Tests) und <a href="{{ modelle.urls.arena }}" target="_blank" rel="noopener">Arena</a> (Stimmen der Nutzer){% if modelle.stand %} · {% if modelle.ausfall %}Stand {% endif %}{{ modelle.stand }}{% endif %}{% for name, tag in modelle.ausfall %} · {{ name }} am {{ tag }} nicht abrufbar{% endfor %}{% if modelle.fehler %} · {{ modelle.fehler }}{% endif %}</p>
    {% endif %}
  </div>
</section>

<section class="ki-verstehen" id="verstehen" aria-label="KI verstehen">
  <h2 class="ki-ansage ki-lern-ansage"><span><i>Wie antwortet</i></span><span><i>eigentlich</i></span><span><i>eine KI<em>?</em></i></span></h2>
  <a class="ki-fahrt" href="{{ kapitel[0].ziel }}" aria-label="Kapitel 1 ansehen: {{ kapitel[0].titel }}">
    <svg viewBox="0 0 1000 260" aria-hidden="true">
      <path class="ki-fahrt-weg" d="{{ fahrt.weg }}"/>
      {% for p in fahrt.pillen %}
      <g class="ki-zug" data-an="{{ p.an }}" data-anker="{{ p.anker }}"><rect x="{{ p.rx }}" y="{{ p.ry }}" width="{{ p.breite }}" height="{{ p.hoehe }}" rx="{{ p.hoehe / 2 }}"/><text x="{{ p.x }}" y="{{ p.ty }}" text-anchor="{{ p.anker }}" font-size="{{ p.schrift }}">{{ p.wort }}</text><circle cx="{{ p.x }}" cy="{{ p.y }}" r="6"/></g>
      {% endfor %}
      {% set ende = fahrt.pillen | last %}
      <circle class="ki-fahrt-punkt" cx="{{ ende.x }}" cy="{{ ende.y }}" r="9"/>
    </svg>
    <span class="ki-los">Kapitel 1 ansehen <span aria-hidden="true">→</span></span>
  </a>
  <ol class="ki-schiene" style="--kapitel:{{ kapitel | length }}" aria-label="Alle {{ kapitel | length }} Kapitel">
    {% for k in kapitel %}
    {% if k.ziel %}<li class="ki-kapitel ki-kapitel--fertig"><a href="{{ k.ziel }}"><b>{{ k.nr }}</b>{{ k.titel }}</a></li>
    {% else %}<li class="ki-kapitel"><b>{{ k.nr }}</b>{{ k.titel }}</li>{% endif %}
    {% endfor %}
  </ol>
</section>
{% endblock %}
