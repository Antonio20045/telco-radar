{# Prüfstelle der Geräte-Bündel (Datenkonzept Geräteradar, Schritt 7): Kennzahlen je
   Anbieter für den letzten Gerätelauf. Gerechnet wird in
   analyze/geraete_pruefkennzahlen.py, hier wird nur gesetzt. Eine Quote ohne ein
   prüfbares Bündel heißt „nicht prüfbar“, nie 0 %. Je Anbieter eine Karte, damit die
   Seite auf dem Telefon nicht seitlich scrollt; eine nicht erfasste Laufzeit steht
   benannt in der Erfassungslücke der Karte. Ohne Karte entsteht kein Zeichen. -#}
{% macro quote(q) %}{% if q.prozent is none %}nicht prüfbar{% else %}{{ q.prozent }} %{% endif %}{% endmacro -%}
{% macro zeile(name, wert, aktiv=false) %}<li class="fwb-ind{% if aktiv %} fwb-aktiv{% endif %}"><span class="fwb-punkt" aria-hidden="true"></span><span class="fwb-name">{{ name }}</span><span class="fwb-zustand">{{ wert }}</span></li>{% endmacro -%}
{% if geraete_pruefung and (geraete_pruefung.vorhanden or geraete_pruefung.fehler) %}
<div class="card" id="geraete-pruefung">
  <div class="card-head"><h2>Geräte-Bündel: Prüfung</h2>
    {% if geraete_pruefung.lauf %}<span class="rubrik-zahl">Lauf {{ geraete_pruefung.lauf | date_de }}</span>{% endif %}</div>
  {% if not geraete_pruefung.vorhanden %}
  <div class="nl-prot-warn"><p>Prüfung nicht lesbar: {{ geraete_pruefung.fehler }}</p></div>
  {% else %}
  {% set s = geraete_pruefung.summe %}
  {% if s.gescheitert %}
  <div class="nl-prot-warn"><p>Prüfung gescheitert: {{ s.fehler }}</p></div>
  {% endif %}
  <div class="t-bilanz-reihe">
    <div class="t-kennzahl"><b>{{ s.gueltig }}</b><span>gültig</span></div>
    <div class="t-kennzahl"><b>{{ s.quarantaene }}</b><span>Quarantäne</span></div>
    <div class="t-kennzahl"><b>{{ s.veraltet }}</b><span>veraltet</span></div>
    {% if s.nie_geprueft %}<div class="t-kennzahl"><b>{{ s.nie_geprueft }}</b><span>nicht geprüft</span></div>{% endif %}
    {% if s.gescheitert %}<div class="t-kennzahl"><b>{{ s.gescheitert }}</b><span>Prüfung gescheitert</span></div>{% endif %}
  </div>
  <div class="fwb-gitter">
    {% for z in geraete_pruefung.anbieter %}
    <article class="fwb-frage" data-anbieter="{{ z.name }}">
      <h3 class="fwb-titel">{{ z.name }}</h3>
      {% if z.erfassungsluecken %}<p class="fwb-warum">{{ z.erfassungsluecken | join(" · ") }}</p>{% endif %}
      <ul class="fwb-liste">
        {{ zeile("Bündel", z.buendel) }}
        {% for a in z.abdeckung if a.erfasst %}{{ zeile("gültig " ~ a.monate ~ " Monate", a.gueltig) }}{% endfor %}
        {{ zeile("frisch", quote(z.frische)) }}
        {{ zeile("Quarantäne", quote(z.quarantaenequote), z.quarantaene > 0) }}
        {{ zeile("Konflikte", quote(z.konfliktquote)) }}
        {{ zeile("Belege", quote(z.belegquote)) }}
        {% if z.ohne_daten %}{{ zeile("nicht prüfbar", "Regel " ~ (z.ohne_daten | join(", "))) }}{% endif %}
      </ul>
    </article>
    {% endfor %}
  </div>
  <details class="evidence">
    <summary><span>Je Regel</span><small>verletzt, Lücke, nicht prüfbar</small></summary>
    <div class="evidence-body">
    <table class="src-table">
      <thead><tr><th>Regel</th><th class="num">verletzt</th>
        <th class="num">Lücke</th><th class="num">nicht prüfbar</th></tr></thead>
      <tbody>
        {% for r in geraete_pruefung.regeln %}
        <tr><td>{{ r.nr }} {{ r.name }}</td><td class="num">{{ r.verletzt }}</td>
          <td class="num">{{ r.luecke }}</td><td class="num">{{ r.nicht_pruefbar }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </details>
  {% endif %}
</div>
{% endif %}
