{% extends "base.html.j2" %}
{% set active = 'bericht' %}
{% set wrap_class = 'wrap-narrow' %}
{% block title %}Marktrecherche · Bericht {{ report.date if report else '' }}{% endblock %}

{% block content %}
{% if report %}

<section class="page-hero">
  <p class="page-kicker">Marktrecherche &middot; Bericht</p>
  <h1>Was Vodafone jetzt wissen muss.</h1>
  <p class="page-date" style="display:block;padding-bottom:0;margin-top:10px">Stand {{ date_de }}{% if report.stats %} &middot; {{ report.stats.get('new', '–') }} neue Meldungen, {{ highlights|length }} bewertet{% endif %}</p>
</section>

{% if top_priorities %}
<div class="hero-priority">
  <span class="hero-priority-badge">Priorität {{ top_priorities[0].relevance }}/5</span>
  <p><a href="{{ top_priorities[0].url }}" target="_blank" rel="noopener" style="color:inherit">{{ top_priorities[0].de_title }}</a></p>
  <div class="hero-priority-meta">
    <b>{{ top_priorities[0].operator or top_priorities[0].source_label }}</b> &middot; {{ top_priorities[0].region }}
    &middot; <a href="{{ top_priorities[0].url }}" target="_blank" rel="noopener">Quelle &nearr;</a>
  </div>
</div>
{% endif %}

{% if briefing_html %}
<div class="card">
  <div class="card-head"><h2>Der Wochenbericht</h2>
    <a href="{{ prefix }}protokoll.html">Methode &amp; Quellenbasis &nearr;</a></div>
  <article class="prose">{{ briefing_html | safe }}</article>
</div>
{% endif %}

{% if top_priorities %}
<div class="card">
  <div class="card-head"><h2>Alle Signale dieser Woche</h2></div>
  <div class="signal-list">
    {% for h in top_priorities %}
    <a class="signal-row" href="{{ h.url }}" target="_blank" rel="noopener">
      <span class="signal-badge">{{ h.relevance }}</span>
      <span class="signal-body">
        <span class="signal-company">{{ h.operator or h.source_label }} &middot; {{ h.region }}</span>
        <span class="signal-title">{{ h.de_title }}</span>
      </span>
    </a>
    {% endfor %}
  </div>
</div>
{% endif %}

{% if report.run and report.run.analysts %}
<div class="card tan">
  <div class="card-head"><h2>Regionale Auswertung</h2></div>
  {% for a in report.run.analysts %}
  <div class="rowtable-row" style="border-bottom:1px solid var(--tan-line)">
    <span class="col-region">{{ a.region }}</span>
    <span class="col-flex">{{ a.items_in }} geprüft</span>
    <span class="col-kept">{{ a.highlights }} relevant</span>
    <span class="col-model">{{ a.model }}</span>
  </div>
  {% endfor %}
</div>
{% endif %}

{% if highlights %}
<details class="evidence" style="margin-top:24px">
  <summary><span>Alle {{ highlights | length }} Meldungen durchsuchen</span><small>bei Bedarf öffnen</small></summary>
  <div class="evidence-body">
    <div class="filters">
      <input type="search" id="f-search" placeholder="Suchen: Operator, Thema, Stichwort …" aria-label="Suche">
      <select id="f-region" aria-label="Region"><option value="">Alle Regionen</option>{% for r in regions %}<option value="{{ r }}">{{ r }}</option>{% endfor %}</select>
      <select id="f-category" aria-label="Thema"><option value="">Alle Themen</option>{% for c in categories %}<option value="{{ c }}">{{ c }}</option>{% endfor %}</select>
      <select id="f-relevance" aria-label="Dringlichkeit"><option value="">Jede Dringlichkeit</option><option value="5">5/5 sofort</option><option value="4">ab 4/5</option><option value="3">ab 3/5</option></select>
      <select id="f-sort" aria-label="Sortierung"><option value="relevance">Dringlichste zuerst</option><option value="date">Neueste zuerst</option><option value="operator">Operator (A–Z)</option></select>
    </div>
    <div class="explorer" id="explorer-app">
      <div class="ex-list" id="ex-list" role="listbox" aria-label="Meldungsliste"></div>
      <div class="ex-detail" id="ex-detail"><p class="ex-detail-empty">Meldung links auswählen.</p></div>
    </div>
    <p class="ex-count" id="ex-count"></p>
    <script type="application/json" id="explorer-data">{{ explorer_json | safe }}</script>
  </div>
</details>
{% endif %}

{% else %}
<section class="page-hero"><h1>Noch kein Bericht</h1></section>
{% endif %}
{% endblock %}
