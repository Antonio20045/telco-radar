{% extends "base.html.j2" %}
{% import "_design.html.j2" as d %}
{% set buehne = true %}
{% block title %}Newsletter – Vodafone Product and Services Insights{% endblock %}
{# Die Anmeldeseite (Antonio, 11.10.2026): derselbe Bildkopf wie Meldungen,
   darunter ein ruhiges Formular ohne Karte. Sie ist die einzige Seite, die
   etwas entgegennimmt; deshalb stehen Impressum und Datenschutz hier (Art. 13
   DSGVO), und die Regel "nichts angekreuzt heisst alles" steht einmal ueber
   der Auswahl - sie ist keine Bedienhilfe, sondern die Regel selbst.
   Regionen und Themen schraenken nur Meldungen ein (`NUR_MELDUNGEN`);
   app.js blendet sie aus, sobald Bereiche ohne Meldungen gewaehlt sind. #}
{% block buehne %}
<section class="wa-auftakt mg-auftakt nl-auftakt" data-buehne>
  <div class="wa-auftakt-buehne">
    <div class="wa-rahmen">
      <div class="wa-bild" aria-hidden="true">{{ d.motiv('band-newsletter', prefix, 'wa-motiv', eager=true) }}</div>
      <div class="wa-schleier" aria-hidden="true"></div>
      <header class="mg-kopf wa-text">
        <p class="mg-woche">Per E-Mail</p>
        <h1 class="mg-titel" aria-label="Newsletter">{% for c in 'Newsletter' %}<span style="--i:{{ loop.index0 }}" aria-hidden="true">{{ c }}</span>{% endfor %}</h1>
        <p class="mg-datum">Nach jedem Radar-Lauf, nur mit Neuem</p>
      </header>
      <div class="wa-hinweis" aria-hidden="true"></div>
    </div>
  </div>
</section>
{% endblock %}
{% block content %}
<div class="nl">
  {% if not newsletter_verlinkt %}
  <div class="nl-gesperrt">
    <strong>Die Anmeldung ist noch nicht freigeschaltet.</strong>
    Impressum und Datenschutzerklärung sind noch nicht vollständig, und ohne
    sie darf hier keine E-Mail-Adresse entgegengenommen werden. Was fehlt,
    steht auf der <a href="{{ prefix }}impressum.html">Impressumsseite</a>.
  </div>
  {% elif not dienst_da %}
  <div class="nl-gesperrt">
    <strong>Die Anmeldung ist noch nicht möglich.</strong>
    Der Dienst, der die Anmeldungen entgegennimmt, ist noch nicht
    eingerichtet. Das Formular zeigt, was einstellbar sein wird, nimmt
    aber noch keine Adresse entgegen.
  </div>
  {% endif %}

  <form id="nl-form" class="nl-form" novalidate
        {% if not newsletter_verlinkt %}data-gesperrt="1"{% endif %}>
    <p class="nl-regel">Nichts angekreuzt heißt: alles.</p>

    {% for dim in dimensionen %}
    <fieldset class="nl-block" data-dim="{{ dim.key }}"{% if dim.nur_meldungen %} data-nur-meldungen{% endif %}>
      <legend class="nl-titel">{{ dim.label }}</legend>
      <div class="nl-optionen">
        {% for opt in dim.optionen %}
        <label class="nl-opt">
          <input type="checkbox" name="{{ dim.feld }}" value="{{ opt.key }}">
          {% if opt.marke %}<i class="nl-marke gr-anb--{{ opt.marke }}" aria-hidden="true"></i>{% endif %}
          <span>{{ opt.label }}</span>
        </label>
        {% endfor %}
      </div>
    </fieldset>
    {% endfor %}

    <fieldset class="nl-block">
      <legend class="nl-titel">Stichwörter</legend>
      <p class="nl-hinweis">
        Kommen immer mit, auch außerhalb der Auswahl. Höchstens
        {{ grenzen.max_stichwoerter }}, je ab {{ grenzen.min_stichwort_laenge }} Zeichen.
      </p>
      <div class="nl-stichwort-zeile">
        <input type="text" id="nl-stichwort" class="nl-feld"
               placeholder="z. B. Netzausbau" maxlength="60"
               aria-label="Stichwort hinzufügen">
        <button type="button" id="nl-stichwort-add" class="nl-btn-klein">Hinzufügen</button>
      </div>
      <p id="nl-stichwort-vorschau" class="nl-vorschau" role="status" aria-live="polite"></p>
      <ul id="nl-stichwort-liste" class="nl-chips"></ul>
    </fieldset>

    <fieldset class="nl-block nl-abschluss">
      <legend class="nl-titel">E-Mail-Adresse</legend>
      <input type="email" id="nl-email" name="email" class="nl-feld nl-feld--breit"
             autocomplete="email" required placeholder="name@firma.de"
             aria-label="E-Mail-Adresse">

      {# Honeypot: sichtbar, aber aus dem Bild geschoben - Skripte fuellen
         `type=hidden` gezielt nicht aus. #}
      <div class="nl-hp" aria-hidden="true">
        <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
      </div>

      <label class="nl-consent">
        <input type="checkbox" id="nl-consent" required>
        <span class="nl-consent-text">
          {% for absatz in einwilligung_absaetze %}<span class="nl-consent-p">{{ absatz }}</span>{% endfor %}
        </span>
      </label>
      <p class="nl-fein">
        Fassung {{ einwilligung_version }} ·
        <a href="{{ prefix }}datenschutz.html">Datenschutz</a> ·
        <a href="{{ prefix }}impressum.html">Impressum</a>
      </p>

      <button type="submit" id="nl-submit" class="nl-btn"
              {% if not newsletter_verlinkt %}disabled{% endif %}>
        Anmelden
      </button>
      <p id="nl-status" class="nl-status" role="status" aria-live="polite"></p>
    </fieldset>
  </form>

  <noscript>
    <p class="nl-gesperrt">
      Für die Anmeldung braucht diese Seite JavaScript. Ohne JavaScript
      schreiben Sie bitte an die Adresse im
      <a href="{{ prefix }}impressum.html">Impressum</a>.
    </p>
  </noscript>
</div>

<script id="nl-config" type="application/json">{{ nl_config | safe }}</script>
{% endblock %}
