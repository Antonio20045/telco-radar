{% extends "base.html.j2" %}
{% block title %}Vodafone Insights - Suche{% endblock %}
{% block content %}
<section class="page-hero wide">
  <p class="page-kicker">Marktrecherche</p>
  <h1>Suche</h1>
  <p class="page-lead">Alle Bericht-Highlights aus jeder archivierten Woche plus die persistente
  Differenzierungs-Bibliothek an einem Ort – jeder Treffer mit Titel, Betreiber, Region, Datum,
  Bereich und Link zur Originalquelle. Diese Seite ist bookmarkbar: <code>suche.html?q=Begriff</code>
  zeigt die Treffer direkt, auch ohne vorheriges Tippen.</p>
</section>

<div class="filters">
  <input type="search" id="suche-input" placeholder="Suchbegriff eingeben …"
         aria-label="Marktrecherche und Differenzierung durchsuchen" autocomplete="off">
</div>
<div class="suche-filters" role="group" aria-label="Nach Bereich filtern">
  <button type="button" class="suche-filter on" data-kind="all">Alle</button>
  <button type="button" class="suche-filter" data-kind="bericht">Bericht</button>
  <button type="button" class="suche-filter" data-kind="differenzierung">Differenzierung</button>
</div>

<p class="suche-count" id="suche-count"></p>
<div class="suche-list" id="suche-results"></div>
{% endblock %}
