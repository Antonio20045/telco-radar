{#- =========================================================================
     DIE MAIL ALS HTML - und warum sie aussieht wie aus dem Jahr 2005

     Fuer E-Mail gilt E-Mail-Recht, nicht Web-Recht. Outlook rendert auf
     Windows mit der WORD-Engine: kein Flexbox, kein Grid, keine externen
     Stylesheets, keine Web Fonts, kein `background-image`, `<div>`-Abstaende
     unzuverlaessig. Deshalb Tabellenlayout und Inline-CSS - beides waere auf
     der Website ein Fehler und ist hier die einzige Fassung, die ueberall
     ankommt.

     Die zweite Regel: hoechstens 600 px. Outlooks Leseansicht schneidet
     darueber ab, ohne zu scrollen.

     Die dritte: JEDER inhaltstragende Text kommt aus `items` und wurde
     nirgends umformuliert. Alles, was hier als Satz steht, kommt aus
     `chrome` (templates/mail/chrome.yaml) - der Allowlist des Treue-Tests.
     Wer hier einen Satz direkt hineinschreibt, bricht diesen Test, und das
     ist die Absicht.
     ==================================================================== -#}
<!DOCTYPE html>
<html lang="de" style="color-scheme:light dark;supported-color-schemes:light dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
{#- Dark-Mode: `color-scheme` sagt dem Client, dass die Mail beide Modi
    kennt. Ohne die Angabe invertieren Apple Mail und Outlook die Flaechen
    selbst - und invertiertes Rot auf invertiertem Papier ist unlesbar. -#}
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ betreff }}</title>
</head>
<body style="margin:0;padding:0;background:{{ mailfarbe.papier }};color:{{ mailfarbe.tinte }}">
{#- Die Vorschauzeile: was die Liste unter dem Betreff anreisst. -#}
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent">
{{ items[0].titel if items else einleitung }}
</div>
{%- set serif = "Georgia,'Times New Roman',Times,serif" %}
{%- set sans = "Arial,Helvetica,sans-serif" %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background:{{ mailfarbe.papier }};border-collapse:collapse">
<tr><td align="center" style="padding:24px 12px">
<table role="presentation" width="{{ breite }}" cellpadding="0" cellspacing="0" border="0"
       style="width:100%;max-width:{{ breite }}px;background:{{ mailfarbe.flaeche }};border-collapse:collapse">
<tr><td style="padding:36px 28px 0 28px">

  {#- Kopf wie die Zeitungskoepfe des Portals: roter Kicker, Serifentitel,
      doppelte Linie. -#}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
         style="border-collapse:collapse">
    <tr><td align="center" style="padding:0 0 22px 0;border-bottom:3px double {{ mailfarbe.tinte }}">
      <div style="font:700 11px/1.4 {{ sans }};letter-spacing:.22em;text-transform:uppercase;color:{{ mailfarbe.rot }}">{{ chrome.kopf.ausgabe | replace('{datum}', datum_de) }}</div>
      <div style="font:400 46px/1.05 {{ serif }};letter-spacing:-.02em;color:{{ mailfarbe.tinte }};padding-top:10px">{{ chrome.kopf.titel }}</div>
      <div style="font:italic 400 17px/1.4 {{ serif }};color:{{ mailfarbe.text }};padding-top:10px">{{ einleitung }}</div>
    </td></tr>
  </table>

  {#- Je Bereich ein Abschnitt, benannt wie der Reiter im Portal. -#}
  {% for ab in abschnitte %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
         style="border-collapse:collapse">
    <tr><td style="padding:30px 0 4px 0">
      <div style="font:400 30px/1.1 {{ serif }};letter-spacing:-.01em;color:{{ mailfarbe.tinte }}">{{ ab.titel }}</div>
    </td></tr>
    {% for it in ab['items'] %}
    <tr><td style="padding:18px 0 18px 0;border-top:1px solid {{ mailfarbe.linie }}">
      {#- Der additive Stichworttreffer sagt, warum er hier steht. -#}
      {% if it.stichwort %}
      <div style="font:700 11px/1.4 {{ sans }};letter-spacing:.06em;text-transform:uppercase;color:{{ mailfarbe.rot }};padding-bottom:6px">{{ chrome.stichwort_marker | replace('{stichwort}', it.stichwort) }}</div>
      {% endif %}
      {% if it.absender %}
      <div style="font:700 11px/1.4 {{ sans }};letter-spacing:.06em;text-transform:uppercase;color:{{ mailfarbe.grau }};padding-bottom:6px">{% if it.farbe %}<span style="color:{{ it.farbe }};font-size:13px">&#9679;</span>&nbsp;{% endif %}{{ it.absender }}</div>
      {% endif %}
      <div style="font:700 19px/1.3 {{ serif }};color:{{ mailfarbe.tinte }};padding-bottom:7px">{{ it.titel }}</div>
      {% if it.text %}
      <div style="font:400 15px/1.55 {{ serif }};color:{{ mailfarbe.text }};padding-bottom:10px">{{ it.text }}</div>
      {% endif %}
      <div style="font:700 12px/1.4 {{ sans }}">
        <a href="{{ it.url }}" style="color:{{ mailfarbe.rot }};text-decoration:none">{{ chrome.link_quelle }} &rsaquo;</a>
        {%- if it.anker %}&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{{ it.anker }}" style="color:{{ mailfarbe.grau }};text-decoration:none">{{ chrome.link_bericht }} &rsaquo;</a>{% endif %}
      </div>
    </td></tr>
    {% endfor %}
  </table>
  {% endfor %}

  {#- Geraete: hoechstens fuenf Zeilen, die groesste Zahl ist die Aenderung
      des Abstands. Jede Zeile verlinkt beide Angebote und die Geraeteseite. -#}
  {% if bewegung %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
         style="border-collapse:collapse">
    <tr><td style="padding:30px 0 12px 0">
      <div style="font:400 30px/1.1 {{ serif }};letter-spacing:-.01em;color:{{ mailfarbe.tinte }}">{{ geraete_titel }}</div>
      <div style="font:700 11px/1.4 {{ sans }};letter-spacing:.06em;text-transform:uppercase;color:{{ mailfarbe.grau }};padding-top:8px">{{ bewegung.titel }}{% if bewegung.zeitraum %} &middot; {{ bewegung.zeitraum }}{% endif %}</div>
    </td></tr>
    {% if bewegung.ausfall %}
    <tr><td style="padding:14px 0;border-top:1px solid {{ mailfarbe.linie }};font:400 15px/1.55 {{ serif }};color:{{ mailfarbe.text }}">{{ bewegung.ausfall }}</td></tr>
    {% elif bewegung.leer %}
    <tr><td style="padding:14px 0;border-top:1px solid {{ mailfarbe.linie }};font:400 15px/1.55 {{ serif }};color:{{ mailfarbe.text }}">{{ bewegung.leer }}</td></tr>
    {% endif %}
    {% for z in bewegung.zeilen %}
    <tr><td style="padding:16px 0 16px 0;border-top:1px solid {{ mailfarbe.linie }}">
      <div style="font:700 11px/1.4 {{ sans }};letter-spacing:.04em;padding-bottom:6px"><span style="color:{{ z.farbe }};font-size:13px">&#9679;</span>&nbsp;<span style="color:{{ z.farbe }}">{{ z.anbieter }}</span> <span style="color:{{ mailfarbe.grau }}">&middot;</span> <span style="color:{{ mailfarbe.tinte }}">{{ z.geraet }}</span> <span style="color:{{ mailfarbe.grau }}">&middot;</span> <span style="color:{{ mailfarbe.grau }}">{{ z.band }}</span></div>
      <div style="padding-bottom:4px"><span style="font:400 30px/1.15 {{ serif }};color:{{ mailfarbe.tinte }}">{{ z.betrag }}</span> <span style="font:italic 400 15px/1.4 {{ serif }};color:{{ mailfarbe.tinte }}">{{ z.richtung }}</span></div>
      <div style="font:400 13px/1.5 {{ serif }};color:{{ mailfarbe.text }}"><span>{{ z.vorher }}</span> &middot; <span>{{ z.jetzt }}</span> &middot; <span>{{ z.bewegt }}</span></div>
      <div style="font:700 12px/1.4 {{ sans }};padding-top:8px">
        <a href="{{ z.link }}" style="color:{{ mailfarbe.rot }};text-decoration:none">{{ chrome.bewegung.link_seite }} &rsaquo;</a>
        {%- if z.quelle %}&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{{ z.quelle }}" style="color:{{ mailfarbe.grau }};text-decoration:none">{{ z.quelle_text }} &rsaquo;</a>{% endif %}
        {%- if z.eigen_quelle %}&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{{ z.eigen_quelle }}" style="color:{{ mailfarbe.grau }};text-decoration:none">{{ z.eigen_quelle_text }} &rsaquo;</a>{% endif %}
      </div>
    </td></tr>
    {% endfor %}
    {% if bewegung.weitere %}
    <tr><td style="padding:0 0 14px 0;font:700 12px/1.4 {{ sans }}"><a href="{{ bewegung.seite }}" style="color:{{ mailfarbe.rot }};text-decoration:none">{{ bewegung.weitere }} &rsaquo;</a></td></tr>
    {% endif %}
  </table>
  {% endif %}

  {#- Der eine Knopf: zum Portal. Als Tabellenzelle, damit Outlook ihn
      als Flaeche zeichnet. -#}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
         style="border-collapse:collapse">
    <tr><td align="center" style="padding:30px 0 34px 0;border-top:1px solid {{ mailfarbe.linie }}">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate">
        <tr><td style="background:{{ mailfarbe.tinte }};border-radius:999px;padding:14px 30px">
          <a href="{{ bericht_url }}" style="font:400 16px/1 {{ sans }};color:{{ mailfarbe.flaeche }};text-decoration:none">{{ chrome.schluss_link }} &rsaquo;</a>
        </td></tr>
      </table>
    </td></tr>
  </table>

  {#- ---------------------------------------------------------- Fuss -#}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
         style="border-collapse:collapse">
    <tr><td style="padding:0 0 28px 0;font:400 11px/1.6 {{ sans }};color:{{ mailfarbe.grau }}">
      <div style="border-top:3px double {{ mailfarbe.tinte }};padding-top:14px">{{ chrome.fuss.warum | replace('{seit_datum}', seit_datum) }}</div>
      <div style="padding-top:8px">{{ chrome.fuss.abmelden_satz }} <a href="{{ abmelde_url }}" style="color:{{ mailfarbe.rot }}">{{ chrome.fuss.abmelden }}</a></div>
      <div style="padding-top:8px">
        <a href="{{ impressum_url }}" style="color:{{ mailfarbe.grau }}">{{ chrome.fuss.impressum }}</a>
        &nbsp;&middot;&nbsp;
        <a href="{{ datenschutz_url }}" style="color:{{ mailfarbe.grau }}">{{ chrome.fuss.datenschutz }}</a>
      </div>
      <div style="padding-top:8px">{{ chrome.fuss.automatisch }}</div>
    </td></tr>
  </table>

</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
