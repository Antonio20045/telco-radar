{
  "permissions": {
    "allow": [
      "Bash(PYTHONPATH=src pytest*)",
      "Bash(python scripts/validate_sources.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(pdftotext*)",
      "Read(src/**)",
      "Read(config/**)",
      "Read(tests/**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(config/**)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(make:*)",
      "Bash(gh workflow run:*)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(.python-version)",
      "Write(.python-version)"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(site/**)",
      "Write(site/**)",
      "Edit(data/state/**)",
      "Write(data/state/**)",
      "Bash(git add -A*)",
      "Bash(git add .*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/hook_gezielte_tests.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
